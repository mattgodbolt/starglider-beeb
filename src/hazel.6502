\ ***************************************************************************
\ STARGLIDER for the BBC Master - what runs with ACCCON's X set
\
\ X sends every access to &3000-&7FFF to shadow RAM, the CPU's own fetches
\ included, so whatever runs or is read while it's set lives here, in
\ HAZEL: the line drawer (line.6502) and these.
\ ***************************************************************************

\ Each character row's address, for the line drawer.
.screen_row_lo
FOR r = 0..<SCREEN_ROWS
    EQUB LO(SCREEN + r * SCREEN_ROW)
NEXT
.screen_row_hi
FOR r = 0..<SCREEN_ROWS
    EQUB HI(SCREEN + r * SCREEN_ROW)
NEXT

\ screen_clear: the screen draw_bank names (0 main, ACCCON_X shadow),
\ from SCREEN to the top of RAM: the rest of SCREEN's page, then two
\ pages a pass, their addresses patched in.
.screen_clear
{
    LDA draw_bank : TSB acccon
    LDY #LO(SCREEN) : LDA #0
.part
    STA SCREEN AND &FF00,Y : INY : BNE part
    ASSERT (&80 - HI(SCREEN) - 1) MOD 2 = 0
    LDX #HI(SCREEN) + 1
.pages
    STX page0+2 : INX : STX page1+2 : INX
.page0
    STA &FF00,Y                         ; patched
.page1
    STA &FF00,Y                         ; patched
    INY : BNE page0
    CPX #&80 : BNE pages                ; to &7FFF
    LDA draw_bank : TRB acccon
    RTS
}

\ erase_screen: the screen draw_buffer names (draw_bank set to match)
\ made empty for drawing: the lines on its erase list drawn again as
\ zeros, from their set-ups, and its boxes cleared (line_go takes them to
\ box.6502's erase_box, which code.6502's screen_erase pages in), or if
\ the list overflowed, the window cleared (screen.6502). X is set to read
\ the list, and for the main screen cleared for each entry's erasing.
.erase_screen
{
    ZA_AUTO1 i
    LDX draw_buffer
    LDA erase_stop,X : BNE replay
    JMP window_clear                    ; (the cockpit around the window stays)
.replay
    STA i
    \ the loads onto this screen's pages (memory.6502)
    TXA : CLC : ADC #HI(ERASE_LIST)
    ASSERT EF_LO = 0 AND EF_HI = 1 AND EF_ROW = 2 AND EF_DX = 3 AND EF_DY = 4 AND EF_CODE = 5
    STA f_lo+2 : ADC #2
    STA f_hi+2 : ADC #2
    STA f_row+2 : ADC #2
    STA f_dx+2 : ADC #2
    STA f_dy+2 : ADC #2
    STA f_code+2
    \ X changed around each line for the main screen, kept for the shadow's
    LDA draw_bank : EOR #ACCCON_X : STA off+1 : STA on+1
    JSR line_erase
    LDA #ACCCON_X : TSB acccon
    ASSERT ERASE_LINES = 255                ; the list ends where X wraps
    LDX i : INX : BEQ done
.each
    STX i
.f_lo
    LDA ERASE_LIST,X : STA line_scr
.f_hi
    LDA ERASE_LIST,X : STA line_scr+1
.f_dx
    LDA ERASE_LIST,X : STA line_dx
.f_dy
    LDA ERASE_LIST,X : STA line_dy
.f_row
    LDY ERASE_LIST,X
.f_code
    LDA ERASE_LIST,X : TAX
.off
    LDA #ACCCON_X : TRB acccon              ; patched
    JSR line_go
.on
    LDA #ACCCON_X : TSB acccon              ; patched
    LDX i : INX : BNE each
.done
    LDA #ACCCON_X : TRB acccon
    JMP line_draw
}
