\ ***************************************************************************
\ STARGLIDER for the BBC Master - the set-ups run once, before the first
\ frame: by the disc's start (start.6502), past main RAM's resident code,
\ and by the spike's spike_init
\ ***************************************************************************

\ mul_init: the products' pointers' high bytes (maths.6502), once.
.mul_init
    LDA #HI(sqr_lo) : STA m_sqlo+1
    LDA #HI(sqr_hi) : STA m_sqhi+1
    LDA #HI(neg_lo) : STA m_nglo+1
    LDA #HI(neg_hi) : STA m_nghi+1
    RTS

\ screen_mode: MODE 1's CRTC cut to 25 character rows from SCREEN, its
\ vertical sync moved to keep them central, not interlaced, so the sync,
\ and the palette split timed from it, falls on the same scan line every
\ field, and no cursor.
.screen_mode
{
    LDX #0
.reg
    LDA crtc_values,X : BMI done
    STA crtc_reg : LDA crtc_values+1,X : STA crtc_data
    INX : INX : BRA reg
.done
    RTS
.crtc_values
    EQUB 6, SCREEN_ROWS
    EQUB 7, 34 - (32 - SCREEN_ROWS) DIV 2
    EQUB 8, 0
    EQUB 10, &20                    ; no cursor
    EQUB 12, HI(SCREEN DIV 8), 13, LO(SCREEN DIV 8)
    EQUB &FF
}
