\ ***************************************************************************
\ STARGLIDER for the BBC Master - the speech player (decision 5)
\
\ Clare Edgeley's clips (tools/mkspeech.py), a sample a tick of User VIA
\ T2 at SPEECH_RATE, on tone 1: its period 1, a carrier the BBC's analogue
\ stage smooths away, its attenuation the sample (docs/research/beeb.md,
\ section 5). The player is in main RAM below &3000, its interrupt and its
\ tick (speech_tick.6502) with it, where the interrupt finds them whichever
\ bank is paged; the tick pages a clip's bank only for each byte it reads.
\ sfx.6502's sample_start starts a clip.
\ ***************************************************************************

SN_TONE1 = &A0
SPEECH_RATE = 4096
SPEECH_A = &8008                    ; bank 7's first 4K, past its ROM header's zeros
SPEECH_END = &FF                    ; a clip's end, which no packed byte of its samples is
\ T2 is one-shot: each tick starts the next count, for a period on from
\ this tick's due moment. SPEECH_LAG is what the reload takes itself (the
\ instructions from the count's read to its write, and the timer's own
\ start): tools/speechcheck.mjs holds the rate to SPEECH_RATE. SPEECH_LATE
\ is the same for a late tick's reload, which reads the count again
\ (speech_tick.6502's sp_late): speechcheck holds a clip with a key held,
\ whose scans make late ticks, to the same rate.
SPEECH_PERIOD = 1000000 DIV SPEECH_RATE
SPEECH_LAG  = 13
SPEECH_T2   = SPEECH_PERIOD - SPEECH_LAG
SPEECH_LATE = 15
\ A tick on time reads its count's low byte no nearer its wrap than 256
\ less SPEECH_T2, as near as sp_again lets a late one's come, so the high
\ byte's read can't race it.
ASSERT 256 - SPEECH_T2 >= 16

\ speech_begin: for sample_start, with interrupts off: the player at
\ sample_clip's first byte, in its area's bank, its first sample next
\ (speech_tick.6502's sp_next). A and X.
.speech_begin
    LDX sample_clip
    LDA speech_bank - SAMPLE_LAUNCH,X : STA sp_bank + 1
    LDA speech_lo - SAMPLE_LAUNCH,X : STA sp_at + 1
    LDA speech_hi - SAMPLE_LAUNCH,X : STA sp_at + 2
    LDA #LO(sp_first - sp_after) : STA sp_next + 1
    RTS

INCLUDE "speech_tick.6502"

\ the clips' starts (tools/mkspeech.py)
INCLUDE "../build/gen/speech_clips.6502"
