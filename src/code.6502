\ ***************************************************************************
\ STARGLIDER for the BBC Master - the code in main RAM, for every build
\ ***************************************************************************

INCLUDE "maths.6502"
INCLUDE "render.6502"
INCLUDE "screen.6502"
INCLUDE "../build/gen/rotate.6502"
INCLUDE "../build/gen/types.6502"

\ each object's record's address, by slot
.obj_lo
FOR i = 0..<SLOTS + 2
    EQUB LO(OBJECTS + i * OB_SIZE)
NEXT
.obj_hi
FOR i = 0..<SLOTS + 2
    EQUB HI(OBJECTS + i * OB_SIZE)
NEXT
