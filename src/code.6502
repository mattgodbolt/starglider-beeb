\ ***************************************************************************
\ STARGLIDER for the BBC Master - the code in main RAM, for every build
\ ***************************************************************************

INCLUDE "maths.6502"
INCLUDE "render.6502"
INCLUDE "../build/gen/types.6502"
INCLUDE "logic/random.6502"
INCLUDE "logic/arith.6502"
INCLUDE "step.6502"

\ view_under: the draw phase's drawing besides the objects (view_under.6502),
\ in the loading area's bank, with ANDY paged for what it reads.
.view_under
    BANK_ANDY BANK_PIC
    JMP under_draw

\ view_objects: the draw list's objects, as world_render draws them: in
\ the missile view (L_05248) none while its window moves, and once it's
\ open, from the missile's place and angles, clipped to its window
\ (mview.6502's objects_view and objects_unview).
.view_objects
{
    BANK_ANDY BANK_PIC
    JSR objects_view : BCS none
    JSR draw_objects
    BANK_ANDY BANK_PIC
    JMP objects_unview
.none
    RTS
}

\ dot_exact: rotate_exact for view_under.6502's dots_draw, from the world's
\ bank, below ANDY's top, and back.
.dot_exact
    BANK BANK_WORLD
    JSR rotate_exact
    BANK_ANDY BANK_PIC
    RTS

\ ground_rows, ground_make: the ground dots' rotation (build/gen/ground.6502,
\ in the loading area's bank) for ground_dots, from the world's bank and
\ back: a dot's three rows, and the rows made for the frame's camera,
\ which the drawing then uses too.
.ground_rows
    BANK_ANDY BANK_PIC
    JSR ground_all
    BANK_ANDY BANK_WORLD
    RTS
.ground_make
    BANK_ANDY BANK_PIC
    JSR ground_start
    JSR ground_setup
    BANK_ANDY BANK_WORLD
    RTS

\ screen_erase: the screen draw_buffer names made empty for drawing: the
\ lines on its erase list drawn again as zeros and its boxes cleared
\ (hazel.6502's erase_screen, box.6502's erase_box), then its ground dots
\ erased from their own list (view_under.6502's dots_wipe), if it has any,
\ each with the loading area's bank paged.
.screen_erase
{
    BANK BANK_PIC
    JSR erase_screen
.dots
    LDX draw_buffer
    LDA dot_wipes,X : BEQ none
    JMP dots_wipe
.none
    RTS
}


\ erase_init: both screens' windows to be cleared before they're first
\ drawn, as if their erase lists had overflowed, neither showing the
\ missile view's window (mview.6502); and the marks wiped (render.6502),
\ as until the first frame their pages hold other things (start.6502's
\ catalogue, screen_copy's pages, the front end's). Each game's start
\ (front_main.6502's game_start) takes it, so it's resident, not the
\ start's, which the lists lie over once a game has run.
.erase_init
    STZ erase_stop : STZ erase_stop+1
    STZ dot_wipes : STZ dot_wipes+1
    LDA #&FF : STA win_shown : STA win_shown+1
    JMP marks_wipe

\ objects_clear: every field of every slot to 0.
.objects_clear
{
    ZA_AUTO2 p
    STZ p : LDA #HI(OBJECTS) : STA p+1
    LDY #LO(OBJECTS)
.clear
    LDA #0 : STA (p),Y
    INY : BNE same
    INC p+1
.same
    CPY #LO(SCREEN) : BNE clear
    LDA p+1 : CMP #HI(SCREEN) : BNE clear
    RTS
}
