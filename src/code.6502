\ ***************************************************************************
\ STARGLIDER for the BBC Master - the code in main RAM, for every build
\ ***************************************************************************

INCLUDE "maths.6502"
INCLUDE "render.6502"
INCLUDE "screen.6502"
INCLUDE "../build/gen/types.6502"
INCLUDE "logic/random.6502"
IF DEFINED(SPIKE)                   ; (on the disc with the flight layer)
INCLUDE "logic/arith.6502"

\ view_under, view_overlays: the view's drawing besides the objects
\ (view.6502), in the logic's bank, with ANDY paged for what it reads.
.view_under
    LDA #BANK_LOGIC OR ROMSEL_ANDY : STA bank_now : STA romsel
    JMP under_draw
.view_overlays
    LDA #BANK_LOGIC OR ROMSEL_ANDY : STA bank_now : STA romsel
    JMP over_draw

\ dot_exact: rotate_exact for view.6502's dots_draw, from the world's
\ bank, below ANDY's top, and back.
.dot_exact
    LDA #BANK_WORLD : STA bank_now : STA romsel
    JSR rotate_exact
    LDA #BANK_LOGIC OR ROMSEL_ANDY : STA bank_now : STA romsel
    RTS
ENDIF
INCLUDE "sound.6502"


\ objects_clear: every field of every slot to 0.
.objects_clear
{
    ZA_AUTO2 p
    STZ p : LDA #HI(OBJECTS) : STA p+1
    LDY #LO(OBJECTS)
.clear
    LDA #0 : STA (p),Y
    INY : BNE same
    INC p+1
.same
    CPY #LO(SCREEN) : BNE clear
    LDA p+1 : CMP #HI(SCREEN) : BNE clear
    RTS
}
