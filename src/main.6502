\ ***************************************************************************
\ STARGLIDER for the BBC Master - the disc
\
\ The game as the ST's: its title, credits and K screen, and its end, the
\ front end (front.6502, decision 12); and the game, the ST's logic
\ (logic/, decision 1) stepped on the engine (engine.6502, decision 14)
\ in the ST's order, steered by the ST's keys and the analogue joystick
\ (input.6502, decision 6), drawn by the port's renderer into a
\ double-buffered MODE 1 screen at the ST's 320 x 200.
\
\ !BOOT (*EXEC'd) sets the mode and palette through BASIC and the OS and
\ runs SG, which makes no OS call: it loads the rest itself, with its own
\ disc reader (disc.6502, decision 12), a track a revolution: HAZEL's
\ files into HAZEL (the filing system's workspace until then), the shapes,
\ the world and the logic into their banks, the front end into bank 7,
\ and the cockpit into the screen. A game's start loads flight's view
\ code, its window and speech into bank 7 in the front end's place, and
\ copies the cockpit into the shadow screen; its end loads the front end
\ again (front_main.6502). (*SRLOAD, Q or no, loaded the banks at a
\ fraction of the speed: docs/journal.md, 2026-10-18.)
\ ***************************************************************************

INCLUDE "defs.6502"
INCLUDE "zp.6502"
INCLUDE "macros.6502"
INCLUDE "../build/gen/objects.6502"
INCLUDE "memory.6502"
INCLUDE "vars.6502"

\ The build stamp comes from the Makefile (-D BUILD="date time sha"), so a
\ disc says what it is: *TYPE !BOOT shows it. A + after the sha means the
\ tree had uncommitted changes.
IF DEFINED(BUILD)
    build_stamp = BUILD
ELSE
    build_stamp = "DEV"
ENDIF

SECTION Boot, filename = "!BOOT", exec = &FFFFFFFF
    EQUS "*| STARGLIDER for the BBC Master ", build_stamp, 13
    EQUS "MODE 1", 13
    EQUS "VDU 19,2,6;0;", 13                    ; logical 2 is cyan
    EQUS "*RUN SG", 13
ENDSECTION

\ SG: main RAM's resident code (Main, up to its budget, MAIN_TOP), then the
\ start (start.6502), which runs once and may lie over the lists and the
\ object table above it, but not the screen it loads the cockpit into.
SECTION SG, org = &0E00, filename = "SG", exec = start, guard = SCREEN, cmos = TRUE
SECTION Main, org = &0E00, guard = MAIN_TOP, cmos = TRUE

IF DEFINED(SPLIT_SWEEP)
\ split_test: scan lines 126-131 whole in logical 3, on both screens, so a
\ split's place in its line shows (-D SPLIT_SWEEP=n moves it: engine.6502).
.split_test
{
    ZA_AUTO2 p
    LDX #126
.line
    TXA : LSR A : LSR A : LSR A : TAY
    TXA : AND #7 : CLC : ADC screen_row_lo,Y : STA p
    LDA screen_row_hi,Y : ADC #0 : STA p+1
    LDY #0
.byte
    LDA #&FF : STA (p),Y
    LDA #ACCCON_X : TSB acccon
    LDA #&FF : STA (p),Y
    LDA #ACCCON_X : TRB acccon
    TYA : CLC : ADC #8 : TAY : BNE byte
    INC p+1
.byte2
    LDA #&FF : STA (p),Y
    LDA #ACCCON_X : TSB acccon
    LDA #&FF : STA (p),Y
    LDA #ACCCON_X : TRB acccon
    TYA : CLC : ADC #8 : TAY : CMP #(80 * 8) AND &FF : BNE byte2
    INX : CPX #132 : BNE line
    RTS
}
ASSERT P% <= &3000
ENDIF

INCLUDE "engine.6502"
INCLUDE "input.6502"
INCLUDE "sound.6502"
INCLUDE "speech.6502"
ASSERT P% <= &3000                  ; (the interrupt runs them)
INCLUDE "cockpit.6502"
INCLUDE "disc.6502"
INCLUDE "front_main.6502"
INCLUDE "docked.6502"
INCLUDE "code.6502"
INCLUDE "overlays.6502"
ENDSECTION

SECTION Start, org = P%, guard = SCREEN, cmos = TRUE
INCLUDE "start.6502"
ENDSECTION
ENDSECTION

\ The cockpit's screen (tools/mkcockpit.py), which the start loads.
SECTION Cockpit, org = SCREEN, filename = "COCKPIT"
INCBIN "../build/gen/cockpit.bin"
ENDSECTION

\ The speech's first area (speech_tick.6502), bank 7's first 4K, which no code
\ can use, past the zeros that keep the OS from taking it for a ROM's
\ header after a BREAK.
SECTION SpeechA, org = &8000, filename = "SPEECH", guard = ANDY_TOP
    EQUD 0, 0
    ASSERT P% = SPEECH_A
INCBIN "../build/gen/speech_a.bin"
    ASSERT P% = ANDY_TOP
ENDSECTION

\ The controls' state (input.6502) and the split's colours (engine.6502),
\ in the workspace, below &3000 for the interrupt.
SECTION GameWork, org = logic_work_end, guard = NMI_PAGE, virtual = TRUE
.adc_channel  SKIP 1        ; the joystick's axis converting: 0 x, 1 y
.adc_raw      SKIP 2        ; by axis, its last reading, the ADC's top 8 bits
.adc_kept     SKIP 2        ; and the reading the accumulators last moved to
.keys_held    SKIP 1        ; the keys held at the last read of them
.c3_ula       SKIP 8        ; logical 3's four entries for the ULA above the split, then below
    \ the engine's pauses and waits (engine.6502)
.paused_at    SKIP 1        ; the field count a pause began at
.key_wait_at  SKIP 1        ; a wait's field count last seen ...
.key_wait_left SKIP 2       ; ... and the fields it has left
    \ the window picture's place in bank 7 (docked.6502)
.ov_have      SKIP 1        ; what it holds (OV_*) ...
.ov_reading   SKIP 1        ; ... and what's being read into it (&FF: none)
.int_mask     SKIP 4        ; Interrogate's texts' colours, by line, as MODE 1 bytes' bits
    \ G's model viewer's (viewer.6502)
.cockpit_lost SKIP 1        ; non-zero once it has cleared main RAM's screen, the cockpit's
ENDSECTION

INCLUDE "banks.6502"

\ The front end (front.6502), bank 7's out of play, past the zeros that
\ keep the OS from taking it for a ROM's header: its data first, which may
\ lie in the bank's first 4K and below world_list_end, then its code,
\ which mustn't (baron#29, banks.6502).
SECTION Front, org = &8000, filename = "FRONT", guard = &C000, cmos = TRUE
    EQUD 0, 0
INCLUDE "../build/gen/front.6502"
IF P% < world_list_end
    SKIP world_list_end - P%
ENDIF
.front_code
INCLUDE "front.6502"
INCLUDE "viewer.6502"
ENDSECTION
ASSERT front_code >= world_list_end
