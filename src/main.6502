\ ***************************************************************************
\ STARGLIDER for the BBC Master - the disc
\
\ The game, from a new game at level 1, as the ST's title starts one (the
\ front end is to come): the ST's logic (logic/, decision 1) stepped on
\ the engine (engine.6502, decision 14) in the ST's order, steered by the
\ ST's keys and the analogue joystick (input.6502, decision 6), drawn by
\ the port's renderer into a double-buffered MODE 1 screen at the ST's
\ 320 x 200.
\
\ !BOOT (*EXEC'd) sets the mode and palette through BASIC and the OS and
\ runs SG, which makes no OS call: it loads the rest itself, with its own
\ disc reader (disc.6502, decision 12), a track a revolution: HAZEL's
\ files into HAZEL (the filing system's workspace until then), the shapes,
\ the world and the logic into their banks, and the cockpit into the
\ screen, which it copies into the shadow screen. (*SRLOAD, Q or no,
\ loaded the banks at a fraction of the speed: docs/journal.md,
\ 2026-10-18.)
\ ***************************************************************************

INCLUDE "defs.6502"
INCLUDE "zp.6502"
INCLUDE "macros.6502"
INCLUDE "../build/gen/objects.6502"
INCLUDE "memory.6502"
INCLUDE "vars.6502"

\ The build stamp comes from the Makefile (-D BUILD="date time sha"), so a
\ disc says what it is: *TYPE !BOOT shows it. A + after the sha means the
\ tree had uncommitted changes.
IF DEFINED(BUILD)
    build_stamp = BUILD
ELSE
    build_stamp = "DEV"
ENDIF

SECTION Boot, filename = "!BOOT", exec = &FFFFFFFF
    EQUS "*| STARGLIDER for the BBC Master ", build_stamp, 13
    EQUS "MODE 1", 13
    EQUS "VDU 19,2,6;0;", 13                    ; logical 2 is cyan
    EQUS "*RUN SG", 13
ENDSECTION

SECTION Main, org = &0E00, filename = "SG", guard = MAIN_TOP, cmos = TRUE
.start
    ZA_ENTRY
    SEI
    \ HAZEL in, and the game's files loaded (disc.6502)
    LDA acccon : AND #NOT(ACCCON_X OR ACCCON_D) AND &FF : ORA #ACCCON_Y : STA acccon
    BANK BANK_SHAPES
    JSR disc_init
    LDX #DISC_LOADS - 1
.load
    PHX
    LDA disc_load_lo,X : STA fe_dst
    LDA disc_load_hi,X : STA fe_dst+1
    LDY disc_load_bank,X
    LDA disc_load_file,X : TAX
    JSR disc_load
    JSR disc_wait
    PLX
    DEX : BPL load
.start_loaded                                   ; (tools/disccheck.mjs)
    JSR mul_init
    JSR line_draw
    JSR screen_mode
    \ the cockpit on both screens, their windows empty, their panels to draw
    JSR screen_copy
    STZ draw_bank : JSR window_clear
    LDA #ACCCON_X : STA draw_bank : JSR window_clear
    JSR panel_reset
IF DEFINED(SPLIT_SWEEP)
    JSR split_test
ENDIF
    JMP game

IF DEFINED(SPLIT_SWEEP)
\ split_test: scan lines 126-131 whole in logical 3, on both screens, so a
\ split's place in its line shows (-D SPLIT_SWEEP=n moves it: engine.6502).
.split_test
{
    ZA_AUTO2 p
    LDX #126
.line
    TXA : LSR A : LSR A : LSR A : TAY
    TXA : AND #7 : CLC : ADC screen_row_lo,Y : STA p
    LDA screen_row_hi,Y : ADC #0 : STA p+1
    LDY #0
.byte
    LDA #&FF : STA (p),Y
    LDA #ACCCON_X : TSB acccon
    LDA #&FF : STA (p),Y
    LDA #ACCCON_X : TRB acccon
    TYA : CLC : ADC #8 : TAY : BNE byte
    INC p+1
.byte2
    LDA #&FF : STA (p),Y
    LDA #ACCCON_X : TSB acccon
    LDA #&FF : STA (p),Y
    LDA #ACCCON_X : TRB acccon
    TYA : CLC : ADC #8 : TAY : CMP #(80 * 8) AND &FF : BNE byte2
    INX : CPX #132 : BNE line
    RTS
}
ASSERT P% <= &3000
ENDIF

INCLUDE "engine.6502"
INCLUDE "input.6502"
INCLUDE "sound.6502"
ASSERT P% <= &3000                  ; (the interrupt runs it)
INCLUDE "cockpit.6502"
INCLUDE "disc.6502"


\ The files start loads (disc_load: the file, where, its bank), the last
\ first.
.disc_load_file
    EQUB DF_WINDOW, DF_COCKPIT, DF_LOGIC, DF_WORLD, DF_SHAPES, DF_CODE2, DF_TABLES
.disc_load_lo
    EQUB LO(WIN_PIC), LO(SCREEN), LO(&8000), LO(&8000), LO(&8000), LO(CODE2), LO(TABLES)
.disc_load_hi
    EQUB HI(WIN_PIC), HI(SCREEN), HI(&8000), HI(&8000), HI(&8000), HI(CODE2), HI(TABLES)
.disc_load_bank
    EQUB BANK_PIC, BANK_SHAPES, BANK_LOGIC, BANK_WORLD, BANK_SHAPES, BANK_SHAPES, BANK_SHAPES
DISC_LOADS = P% - disc_load_bank

\ ---------------------------------------------------------------------------
\ game: the game's state as the ST's start-up and title leave it, a new
\ game as the title starts one, and the engine (engine.6502), for ever.
SIGHT_CX = 160                      ; the sight's centre (init_resolution's, in colour)
SIGHT_CY = 68
.game
{
    \ the logic's variables 0, in the workspace and in ANDY (with the
    \ objects' fields there), and the objects', the silo's two records
    \ included, which no level's set-up clears: as the ST's are as it loads
    LDX #0
.work
    STZ work_end,X
    INX : CPX #LO(logic_work_end - work_end) : BNE work
    ASSERT logic_work_end - work_end <= 256
    BANK_ANDY BANK_LOGIC
    JSR andy_clear
    JSR objects_clear
    LDX #pl_roll + 1 - pl_x
.player
    STZ pl_x,X
    DEX : BPL player
    STZ n_slots : STZ docked : STZ silo_missile : STZ all_faces
    \ what the ST's start-up sets (init_resolution's sight centre, the
    \ sound on), the beam's colour as the program loads, and what the
    \ title leaves: the four frame_ends before it waits for a key, and its
    \ scene's player at y &64 (sub_03B38)
    LDA #SIGHT_CX : STA sight_cx
    LDA #SIGHT_CY : STA sight_cy
    LDA #&FF : STA sound_on
    LDA #15 : STA beam_colour
    LDA #4 : STA frame_count
    LDA #&64 : STA pl_y
    LDX #15
.colours
    LDA st_colours,X : STA colour_map,X
    DEX : BPL colours
    \ main RAM's screen shown, and both cleared before they're drawn
    JSR erase_init
    STZ draw_buffer : STZ frame_drawn : STZ frame_ready
    \ The disc reader at work (decision 12): until the game has a file of
    \ its own to load as it plays, TABLES read again into the loading area,
    \ below WINDOW's code and picture there, as the game starts
    \ (tools/disccheck.mjs checks it).
    LDX #DF_TABLES : LDY #BANK_PIC
    STZ fe_dst : LDA #&80 : STA fe_dst+1
    ASSERT CODE2 - TABLES <= WIN_PIC - &8000    ; (TABLES' guard is CODE2)
    JSR disc_load
    JSR input_init
    BANK BANK_LOGIC
    JSR sound_init
    JSR install_irq
    \ the new game, as the ST's start_game makes it (L_01EFE), and its
    \ first level's start (L_01F06)
    BANK_ANDY BANK_LOGIC
    JSR new_game
    JSR level_start
    LDA fields : STA stepped
    JMP engine_run
}

\ andy_clear: ANDY, paged, all 0.
.andy_clear
{
    ZA_AUTO2 p
    STZ p : LDA #HI(ANDY) : STA p+1
    LDY #0 : TYA
.page
    STA (p),Y
    INY : BNE page
    INC p+1 : LDX p+1 : CPX #HI(ANDY_TOP) : BNE page
    RTS
}

\ The ST's colours, for now: reds colour 1 (red), blues and cyans colour 2
\ (cyan), white colour 3 (decision 3 leaves the choice to make).
.st_colours
    EQUB &00, &0F, &0F, &0F, &0F, &0F, &F0, &F0, &F0, &F0, &F0, &F0, &F0, &F0, &F0, &FF

INCLUDE "code.6502"
INCLUDE "overlays.6502"
ENDSECTION

\ The cockpit's screen (tools/mkcockpit.py), which !BOOT loads.
SECTION Cockpit, org = SCREEN, filename = "COCKPIT"
INCBIN "../build/gen/cockpit.bin"
ENDSECTION

\ The controls' state (input.6502), in the workspace, below &3000 for the
\ interrupt.
SECTION GameWork, org = logic_work_end, guard = NMI_PAGE, virtual = TRUE
.adc_channel  SKIP 1        ; the joystick's axis converting: 0 x, 1 y
.adc_raw      SKIP 2        ; by axis, its last reading, the ADC's top 8 bits
.adc_kept     SKIP 2        ; and the reading the accumulators last moved to
.keys_held    SKIP 1        ; the keys held at the last read of them
ENDSECTION

INCLUDE "banks.6502"
