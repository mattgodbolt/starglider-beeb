\ ***************************************************************************
\ STARGLIDER for the BBC Master - one axis of faces' n.c (render.6502)
\
\ Included twice an axis, each copy in a scope of its own with AXIS and
\ HIGH set, so faces can patch each copy's products by name: |n| times
\ |c|'s high byte on this axis, taken from dot's top two bytes (or added
\ to them if n c is negative), in the high pass; |n| times its low byte,
\ from all three, in the low. The table reads are MUL8's, with |n| in Y
\ and |c|'s byte patched into their offsets once an object, as MUL_SET
\ would set the pointers.
\ ***************************************************************************

IF HIGH
    LDA nrm+AXIS : BPL n_pos
    EOR #&FF : INC A
.n_pos
    STA nmag+AXIS : BEQ done            ; (0: nothing on this axis, either pass)
    LDY objc_mag+2*AXIS+1 : BEQ done    ; nothing from |c|'s high byte
    TAY
    SEC
.hi_a
    LDA sqr_lo,Y
.hi_b
    SBC neg_lo,Y
    STA pp
.hi_c
    LDA sqr_hi,Y
.hi_d
    SBC neg_hi,Y
    STA pp+1
    LDA nrm+AXIS : EOR objc_sign+AXIS : BMI add
    SEC
    LDA dot+1 : SBC pp : STA dot+1
    LDA dot+2 : SBC pp+1 : STA dot+2
    BRA done
.add
    CLC
    LDA dot+1 : ADC pp : STA dot+1
    LDA dot+2 : ADC pp+1 : STA dot+2
.done
ELSE
    LDY nmag+AXIS : BEQ done
    SEC
.lo_a
    LDA sqr_lo,Y
.lo_b
    SBC neg_lo,Y
    STA pp
.lo_c
    LDA sqr_hi,Y
.lo_d
    SBC neg_hi,Y
    STA pp+1
    LDA nrm+AXIS : EOR objc_sign+AXIS : BMI add
    SEC
    LDA dot : SBC pp : STA dot
    LDA dot+1 : SBC pp+1 : STA dot+1
    BCS done
    DEC dot+2
    BRA done
.add
    CLC
    LDA dot : ADC pp : STA dot
    LDA dot+1 : ADC pp+1 : STA dot+1
    BCC done
    INC dot+2
.done
ENDIF
