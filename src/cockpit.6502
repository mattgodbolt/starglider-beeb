\ ***************************************************************************
\ STARGLIDER for the BBC Master - the cockpit's screens
\
\ The cockpit (tools/mkcockpit.py, decision 3) is on both screens, around
\ the view's window, which is all that's ever cleared (screen.6502's
\ window_clear). screen_copy sets ACCCON's X to reach the shadow screen,
\ so it must lie below &3000, where X changes nothing.
\ ***************************************************************************

\ screen_copy: main RAM's screen into shadow RAM's, a page at a time
\ through edge_mark (free outside the draw phase).
.screen_copy
{
    ZA_AUTO2 p
    STZ p : LDA #HI(SCREEN) : STA p+1
.page
    LDY #0
.read
    LDA (p),Y : STA edge_mark,Y
    INY : BNE read
    LDA #ACCCON_X : TSB acccon
.write
    LDA edge_mark,Y : STA (p),Y
    INY : BNE write
    LDA #ACCCON_X : TRB acccon
    INC p+1 : BPL page                          ; up to &7FFF
    RTS
}

ASSERT P% <= &3000
