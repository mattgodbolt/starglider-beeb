\ ***************************************************************************
\ STARGLIDER for the BBC Master - the cockpit's panel
\
\ The cockpit is on both screens (screen.6502 copies and clears them). The
\ panel drawn on it is panel.6502's, in the logic's bank: panel_draw,
\ panel_texts and panel_reset call it.
\ ***************************************************************************

\ panel_draw: the panel drawn into the screen being drawn (draw_buffer,
\ draw_bank), after its 3D. panel_texts: the texts the ST prints on that
\ frame, after the step's logic. panel_reset: both screens' panels to be
\ drawn whole, as the cockpit's copy leaves them. Each pages the logic's
\ bank with ANDY, as the logic runs, and puts back the bank it found.
ZA_AUTO2 panel_vec
.panel_draw
    LDA #LO(panel_frame) : LDX #HI(panel_frame)
    BRA panel_call
.panel_texts
    LDA #LO(panel_messages) : LDX #HI(panel_messages)
    BRA panel_call
.panel_reset
    LDA #LO(panel_init) : LDX #HI(panel_init)
.panel_call
    STA panel_vec : STX panel_vec+1
    LDA bank_now : PHA
    LDA #BANK_LOGIC OR ROMSEL_ANDY : STA bank_now : STA romsel
    JSR panel_jump
    PLA : STA bank_now : STA romsel
    RTS
.panel_jump
    JMP (panel_vec)
    ZA_CANJUMP panel_frame, panel_messages, panel_init
