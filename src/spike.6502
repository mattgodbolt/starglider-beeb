\ ***************************************************************************
\ STARGLIDER for the BBC Master - the speed spike (layer 0)
\
\ The renderer alone, driven by tools/scenerun.mjs: it writes a scene
\ captured from the ST (tools/st_scenes.py) into the objects' bank and the
\ frame's inputs, calls spike_frame and reads the lists, the camera-space
\ positions and line_log back. The harness loads the banks and HAZEL.
\ ***************************************************************************

INCLUDE "defs.6502"
INCLUDE "zp.6502"
INCLUDE "macros.6502"

SECTION Spike, org = &0E00, filename = "SPIKE", guard = SCREEN, cmos = TRUE
.spike_init
    ZA_ENTRY
    LDA acccon : ORA #ACCCON_Y : STA acccon      ; HAZEL
    STZ draw_bank                               ; main RAM's screen
    LDA #LO(LOG) : STA log_base : LDA #HI(LOG) : STA log_base+1
    JSR mul_init
    JSR line_draw
    JSR screen_mode
    JMP screen_clear

.spike_frame
    ZA_ENTRY
    JSR render
.spike_done
    RTS

\ spike_sines: sincos at every angle, the sine and cosine (4 bytes) for
\ each into the log's bank in turn, for tools/sinecheck.py.
.spike_sines
{
    ZA_ENTRY
    ZA_AUTO2 out
    STZ m_idx : STZ m_idx+1
    LDA #LO(LOG) : STA out : LDA #HI(LOG) : STA out+1
.each
    BANK BANK_SINE
    JSR sincos
    LDA #BANK_LOG : STA romsel
    LDY #3
.copy
    LDA m_sc,Y : ZA_INDEXEDBY 0..3
    STA (out),Y
    DEY : BPL copy
    LDA out : CLC : ADC #4 : STA out
    BCC same
    INC out+1
.same
    INC m_idx : BNE each
    INC m_idx+1
    LDA m_idx+1 : CMP #HI(4096) : BNE each
    RTS
}

INCLUDE "code.6502"
ENDSECTION

INCLUDE "banks.6502"
