\ ***************************************************************************
\ STARGLIDER for the BBC Master - the speed spike (layer 0)
\
\ The renderer alone, driven by tools/scenerun.mjs: it writes a scene
\ captured from the ST (tools/st_scenes.py) into the objects' bank and the
\ frame's inputs, calls spike_frame and reads the lists, the camera-space
\ positions and line_log back. The harness loads the banks and HAZEL.
\ ***************************************************************************

SPIKE = TRUE                        ; render and its log, for the harness

INCLUDE "defs.6502"
INCLUDE "zp.6502"
INCLUDE "macros.6502"
INCLUDE "../build/gen/objects.6502"
INCLUDE "memory.6502"
INCLUDE "vars.6502"

SECTION Spike, org = &0E00, filename = "SPIKE", guard = MAIN_TOP, cmos = TRUE
.spike_init
    ZA_ENTRY
    LDA acccon : ORA #ACCCON_Y : STA acccon      ; HAZEL
    STZ draw_bank : STZ draw_buffer             ; main RAM's screen
    LDA #LO(LOG) : STA log_base : LDA #HI(LOG) : STA log_base+1
    JSR mul_init
    JSR objects_clear
    JSR erase_init
    JSR line_draw
    JSR screen_mode
    JMP screen_clear

.spike_frame
    ZA_ENTRY
    JSR render
.spike_done
    RTS

\ spike_missile: render's camera, in the missile view, the missile's and
\ back (mview.6502's camera_swap), round its lists, as world_lists'
\ missile_lists makes them.
.spike_missile
{
    BANK_ANDY BANK_PIC
    LDA mv_render : BEQ done
    JMP camera_swap
.done
    RTS
}

\ spike_logic: logic_call's routine, with logic_bank paged, for
\ tools/logicrun.mjs.
.spike_logic
    ZA_ENTRY
    LDA logic_bank : STA bank_now : STA romsel
    JSR logic_jump
    RTS
.logic_jump
    JMP (logic_call)
    ZA_CANJUMP animate_shapes, player_flight, random8, random32, world_lists, world_after, world_whole, read_keys, object_handlers, collisions, level_message, frame_end_logic, post_frame, level_start, mine_proximity
    ZA_CANJUMP new_game, spike_step, panel_frame, panel_messages, panel_init

\ spike_step: a whole step as the disc takes it (step.6502), but for its
\ frame, which the logic doesn't read, and the disc's controls and frame,
\ which the harness hasn't: they do nothing here.
.spike_step
    JSR step_lists
    JMP step_logic
.input_step
.frame_show
    RTS

\ spike_erase: the last frame's lines erased (from its erase list) and its
\ ground dots (from theirs), as the disc erases a screen before drawing it
\ again.
.spike_erase
    ZA_ENTRY
    JSR erase_screen
    JMP dots_erase

\ spike_under, spike_over: the view's drawing besides the objects
\ (view_under.6502, view.6502), for tools/viewrun.mjs: logic_call's routine (world_lists,
\ which makes the camera the drawing reads), then what the draw phase
\ draws before the objects, from a fresh erase list; and what's drawn
\ after the step's logic, onto it, each line clip_line passes logged as
\ render logs them.
.spike_under
    ZA_ENTRY
    LDA logic_bank : STA bank_now : STA romsel
    JSR logic_jump
.spike_under_draw                               ; (the harness times from here)
    JSR draw_begin
    JSR view_under
    JMP draw_end
.spike_over
    ZA_ENTRY
    STZ log_n : STZ log_n+1
    LDA log_base : STA log_ptr : LDA log_base+1 : STA log_ptr+1
    BANK_ANDY BANK_LOGIC                        ; (as frame_show calls view_overlays)
    JMP over_draw

\ spike_objects: logic_call's routine (world_lists, which makes the lists
\ and the camera), then the draw list's objects as the disc's frame draws
\ them (code.6502's view_objects), each line logged as render logs them,
\ for tools/viewrun.mjs.
.spike_objects
    ZA_ENTRY
    LDA logic_bank : STA bank_now : STA romsel
    JSR logic_jump
    STZ log_n : STZ log_n+1
    LDA log_base : STA log_ptr : LDA log_base+1 : STA log_ptr+1
    JSR draw_begin
    JSR view_objects
    JMP draw_end

\ spike_sines: sincos at every angle, the sine and cosine (4 bytes) for
\ each into the log's bank in turn, for tools/sinecheck.py.
.spike_sines
{
    ZA_ENTRY
    ZA_AUTO2 out
    STZ m_idx : STZ m_idx+1
    LDA #LO(LOG) : STA out : LDA #HI(LOG) : STA out+1
.each
    BANK BANK_WORLD
    JSR sincos
    LDA #BANK_LOG : STA romsel
    LDY #3
.copy
    LDA m_sc,Y : ZA_INDEXEDBY 0..3
    STA (out),Y
    DEY : BPL copy
    LDA out : CLC : ADC #4 : STA out
    BCC same
    INC out+1
.same
    INC m_idx : BNE each
    INC m_idx+1
    LDA m_idx+1 : CMP #HI(4096) : BNE each
    RTS
}

INCLUDE "code.6502"
ENDSECTION

INCLUDE "banks.6502"

\ The harness's (tools/logicrun.mjs).
SECTION SpikeWork, org = logic_work_end, guard = NMI_PAGE, virtual = TRUE
.logic_bank SKIP 1
.logic_call SKIP 2
ENDSECTION
