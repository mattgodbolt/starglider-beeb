\ ***************************************************************************
\ STARGLIDER for the BBC Master - the missile view's window (L_05248,
\ &06B7E; docs/research/st-panel.md, section 8), and its objects' camera
\ and clip
\
\ In the missile view the ST copies the cockpit picture's window rows over
\ the view every frame, slid up by m_iris as the window opens and closes,
\ the rows it leaves below cleared to row 130, and draws its objects only
\ once the window is open. m_iris steps by 8, so the slide moves whole
\ character rows. Each screen remembers which picture row each of its
\ window's character rows shows, so only the rows that differ are drawn,
\ from the picture as the port keeps it (build/gen/window.6502, in
\ BANK_PIC at WIN_PIC, tools/mkcockpit.py): a row's sides, and its inner
\ window (where the missile's view is drawn) only where it isn't empty,
\ cleared only where it wasn't. A screen that holds the open window
\ already needs only what an erase can take from it put back: the inner
\ window's picture (the objects and dots are drawn there) and the bar's
\ rows (which are ORed over it). The code is in the picture's bank, the
\ loading area's, with it (view_under.6502's under_draw calls it): it sets
\ ACCCON's X, which leaves sideways RAM where it is.
\ ***************************************************************************

\ The texts in the view that the missile view prints: MISSILE VIEW and the
\ countdown, each in a character row of the window (panel.6502).
MV_TEXT_ROW    = TXT_Y[TXT_MISSILE_VIEW] DIV 8
COUNT_TEXT_ROW = TXT_Y[TXT_COUNTDOWN] DIV 8
ASSERT TXT_Y[TXT_MISSILE_VIEW] MOD 8 = 0 AND TXT_Y[TXT_COUNTDOWN] MOD 8 = 0

\ win_draw: the window as the ST has it this frame, on the screen draw_bank
\ names, and when it's open the bar's win_blocks blocks over it (win_bar).
\ win_shown keeps, by screen, the m_iris it was drawn for (&FF: none, the
\ view's own). What the screen shows (win_old, by character row: its
\ picture row, 0 cleared, &FF not known) is the window at win_shown; or,
\ after the view's own or an erase that cleared the window (erase_screen,
\ its list overflowed), cleared rows but the last's lines 129 and 130,
\ which the view never draws. The rows of the texts it shows aren't known:
\ they're drawn again, and the texts taken off (panel_messages draws this
\ frame's again).
.win_draw
{
    ZA_AUTO1 c, k
    LDA draw_bank : TSB acccon
    LDX draw_buffer
    LDA m_iris : LSR A : LSR A : LSR A : STA k
    LDA erase_stop,X : BEQ view
    LDA win_shown,X : CMP #&FF : BEQ view
    CMP m_iris : BNE moved
    LDA k : BNE moved                       ; (the same: but for its texts' rows)
    \ the open window again: what the erase took put back, and the bar
    JSR win_open
    JMP bar
.moved
    \ the window at the m_iris drawn there
    LDA win_shown,X : LSR A : LSR A : LSR A : STA c
    LDY #1
.slid
    TYA : CLC : ADC c : CMP #WIN_ROWS + 1 : BCC row_on
    LDA #0
.row_on
    STA win_old,Y
    INY : CPY #WIN_ROWS + 1 : BNE slid
    BRA texts
.view
    LDY #WIN_ROWS - 1 : LDA #0
.cleared
    STA win_old,Y
    DEY : BNE cleared
    LDA #&FF : STA win_old + WIN_ROWS
.texts
    LDA ps_texts,X : BEQ rows
    AND #(TX_MVIEW OR TX_COUNT) EOR &FF : BNE all
    LDA #&FF
    LDY ps_texts,X : CPY #TX_COUNT : BEQ count
    STA win_old + MV_TEXT_ROW
    CPY #TX_MVIEW : BEQ known
.count
    STA win_old + COUNT_TEXT_ROW
    BRA known
.all
    LDA #&FF : LDY #WIN_ROWS
.unknown
    STA win_old,Y
    DEY : BNE unknown
.known
    STZ ps_texts,X
.rows
    LDA m_iris : STA win_shown,X
    \ each row the picture's from c + m_iris / 8, or cleared past the last
    LDA #1 : STA c
.row
    LDA c : CLC : ADC k : CMP #WIN_ROWS + 1 : BCC shown
    LDA #0
.shown
    LDY c : CMP win_old,Y : BEQ next
    JSR win_row
.next
    INC c : LDA c : CMP #WIN_ROWS + 1 : BNE row
.bar
    LDA k : BNE done
    JSR win_bar
.done
    LDA draw_bank : TRB acccon
    RTS
}
ASSERT WIN_FIRST_ROW = 1 AND MV_TEXT_ROW <= WIN_ROWS AND COUNT_TEXT_ROW >= WIN_FIRST_ROW
ASSERT TX_MVIEW <> TX_COUNT
.win_old SKIP WIN_ROWS + 1                  ; (in the bank's own RAM)

\ win_row: character row Y of the window drawn as picture row A (0:
\ cleared), over the row win_old says it shows: the sides always; the
\ inner window as the two rows have it. The first row's top two lines are
\ above the window, and the last's lines from 131 on below it.
.win_row
{
    ZA_AUTO1 r, p, kind, o
    \ (only a span reads win_src, set for it, which baron can't follow
    \ through kind: without this it keeps win_src from frame to frame)
    ZA_DISCARD win_src
    STA p : STY r
    LDA win_old,Y : STA o
    JSR win_aim
    CPY #WIN_ROWS : BNE not_last
    JMP last
.not_last
    LDA p : BEQ blank
    TAX
    LDA win_kind - WIN_FIRST_ROW,X : STA kind
    LDA win_row_lo - WIN_FIRST_ROW,X : STA win_src
    LDA win_row_hi - WIN_FIRST_ROW,X : STA win_src+1
    LDA kind : CMP #WK_FULL : BNE sides
    LDX #WIN_CELLS : JSR cells_copy
    BRA top
.sides
    LDX #WIN_SIDE : JSR cells_copy
    JSR past_inner
    LDX #WIN_SIDE : JSR cells_copy          ; (win_src is now the span's, if any)
    BRA inner
.blank
    LDX #WIN_SIDE : JSR cells_zero
    JSR past_inner
    LDX #WIN_SIDE : JSR cells_zero
    STZ kind
    ASSERT WK_EMPTY = 0
.inner
    \ the old row's inner window: nothing to clear (cleared, or an empty
    \ row's), its span, or all of it (a full row's, or not known)
    LDX o : BEQ clean
    CPX #&FF : BEQ dirty
    LDA win_kind - WIN_FIRST_ROW,X : BEQ clean
    ASSERT WK_EMPTY = 0
    CMP #WK_SPAN : BEQ old_span
.dirty
    LDA #WIN_INNER : JSR aim
    LDX #WIN_INNER_CELLS : JSR cells_zero
.clean
    LDA kind : CMP #WK_SPAN : BNE top
.span
    LDA #WIN_SPAN : JSR aim
    LDX #WIN_SPAN_CELLS : JSR cells_copy
    BRA top
.old_span
    LDA kind : CMP #WK_SPAN : BEQ span     ; (the new span's cells cover the old's)
    LDA #WIN_SPAN : JSR aim
    LDX #WIN_SPAN_CELLS : JSR cells_zero
.top
    \ the first row's lines above the window, from another picture row's:
    \ the cockpit's again, which picture row 1's are
    LDA r : CMP #WIN_FIRST_ROW : BNE done
    LDA p : CMP #WIN_FIRST_ROW + 1 : BCC done
    LDA #0 : JSR aim
    LDA win_row_lo : STA win_src : LDA win_row_hi : STA win_src+1
    LDX #WIN_CELLS : JMP lines_01
.last
    \ its lines to 130 alone: picture row 16's (whose lines past them are
    \ zeros), or cleared, unless they are
    LDA p : BEQ last_blank
    LDA win_row_lo + WIN_ROWS - WIN_FIRST_ROW : STA win_src
    LDA win_row_hi + WIN_ROWS - WIN_FIRST_ROW : STA win_src+1
    LDX #WIN_CELLS : JMP lines_02
.last_blank
    LDA o : BEQ done
    LDX #WIN_CELLS : JMP lines_02_zero
.done
    RTS
\ past_inner: win_dst past the inner window, from its first cell
.past_inner
    LDA win_dst : CLC : ADC #LO(8 * WIN_INNER_CELLS) : STA win_dst
    LDA win_dst+1 : ADC #HI(8 * WIN_INNER_CELLS) : STA win_dst+1
    RTS
\ aim: win_dst = the row's cell A
.aim
    PHA
    LDY r : JSR win_aim
    PLY : JMP win_cell
}
\ (the first and last rows are full, for their lines above and below; the
\ last row's lines to the window's last, 130 (&06B7E), are its first three)
ASSERT WIN_KINDS[0] = WK_FULL AND WIN_KINDS[WIN_ROWS - WIN_FIRST_ROW] = WK_FULL
ASSERT 8 * WIN_ROWS + 2 = 130

\ win_open: on the open window's screen, what an erase can have taken put
\ back: the inner window's picture in rows 2 to 14 (from y 16 to 112,
\ where the objects' lines and the dots lie), and the bar's rows (118 to
\ 121, which win_bar ORs over row 14's last two lines and row 15's first
\ two).
.win_open
{
    ZA_AUTO1 c
    LDA #MV_YMIN DIV 8 : STA c
.row
    LDX c
    LDA win_row_lo - WIN_FIRST_ROW,X : STA win_src
    LDA win_row_hi - WIN_FIRST_ROW,X : STA win_src+1
    LDA win_kind - WIN_FIRST_ROW,X : BEQ next
    ASSERT WK_EMPTY = 0
    CMP #WK_SPAN : BEQ span
    \ a full row's inner window
    LDA win_src : CLC : ADC #LO(8 * WIN_INNER) : STA win_src
    LDA win_src+1 : ADC #HI(8 * WIN_INNER) : STA win_src+1
    LDY c : JSR win_aim
    LDY #WIN_INNER : JSR win_cell
    LDX #WIN_INNER_CELLS : JSR cells_copy
    BRA next
.span
    LDA win_src : CLC : ADC #LO(2 * 8 * WIN_SIDE) : STA win_src     ; (past the sides)
    LDA win_src+1 : ADC #HI(2 * 8 * WIN_SIDE) : STA win_src+1
    LDY c : JSR win_aim
    LDY #WIN_SPAN : JSR win_cell
    LDX #WIN_SPAN_CELLS : JSR cells_copy
.next
    INC c : LDA c : CMP #MV_YMAX DIV 8 + 1 : BNE row
    \ the bar's lines in row 15: its first two
    LDX #(BAR_Y + 4) DIV 8
    LDA win_row_lo - WIN_FIRST_ROW,X : CLC : ADC #LO(8 * WIN_INNER) : STA win_src
    LDA win_row_hi - WIN_FIRST_ROW,X : ADC #HI(8 * WIN_INNER) : STA win_src+1
    LDY #(BAR_Y + 4) DIV 8 : JSR win_aim
    LDY #WIN_INNER : JSR win_cell
    LDX #WIN_INNER_CELLS : JMP lines_01
}
\ (the rows it puts back whole hold the bar's first lines, and the row of
\ its last is full; and it leaves the countdown's row, the one text the
\ open view prints, for panel_messages)
ASSERT BAR_Y DIV 8 = MV_YMAX DIV 8 AND (BAR_Y + 4) DIV 8 = MV_YMAX DIV 8 + 1 AND ((BAR_Y + 4) AND 7) <= 2
ASSERT WIN_KINDS[(BAR_Y + 4) DIV 8 - WIN_FIRST_ROW] = WK_FULL
ASSERT WIN_KINDS[COUNT_TEXT_ROW - WIN_FIRST_ROW] = WK_EMPTY

\ win_bar (L_052EC): the missile's life as win_blocks blocks over the
\ bar's pips, 4 by 4 in the ST's colour 7 (four of its 2 by 2 dots), each
\ BAR_STEP pixels left of the one before, and 2 more before the 9th and
\ the 10th ($2B2-$2B8).
BAR_X    = &D3                          ; the first block's right column but one
BAR_Y    = &76                          ; its top row
BAR_STEP = 6
.win_bar
{
    ZA_AUTO1 b, x, m0, m1
    LDA win_blocks : BNE some
    RTS
.some
    STZ b
    LDA #BAR_X - 2 : STA x
.block
    \ its four pixels from x: those of x's byte from x on, and those of the
    \ next byte before x + 4
    LDA x : AND #3 : TAY
    LDA bar_from,Y : AND colour_map+7 : STA m0
    LDA bar_before,Y : AND colour_map+7 : STA m1
    LDY #BAR_Y DIV 8 : JSR win_aim
    LDA x : SEC : SBC #VIEW_XMIN : LSR A : LSR A : TAY
    JSR win_cell
    \ its rows in the first character row, then in the next
    LDY #BAR_Y AND 7
.upper
    LDA m0 : ORA (win_dst),Y : STA (win_dst),Y
    TYA : ORA #8 : TAY
    LDA m1 : ORA (win_dst),Y : STA (win_dst),Y
    TYA : AND #7 : TAY
    INY : CPY #8 : BNE upper
    LDA win_dst : CLC : ADC #LO(SCREEN_ROW) : STA win_dst
    LDA win_dst+1 : ADC #HI(SCREEN_ROW) : STA win_dst+1
    LDY #0
.lower
    LDA m0 : ORA (win_dst),Y : STA (win_dst),Y
    TYA : ORA #8 : TAY
    LDA m1 : ORA (win_dst),Y : STA (win_dst),Y
    TYA : AND #7 : TAY
    INY : CPY #(BAR_Y + 4) AND 7 : BNE lower
    \ the next block left
    INC b
    LDA x : SEC : SBC #BAR_STEP : STA x
    LDA b : CMP #8 : BEQ extra
    CMP #9 : BNE counted
.extra
    DEC x : DEC x
.counted
    LDA b : CMP win_blocks : BEQ done
    JMP block
.done
    RTS
\ a byte's pixels from the one at A AND 3 on, and before it
.bar_from
    EQUB &FF, &77, &33, &11
.bar_before
    EQUB &00, &88, &CC, &EE
}
ZA_AUTO1 win_blocks                     ; the bar's blocks this frame (under_draw's)
ASSERT (BAR_Y AND 7) + 4 > 8               ; (its rows span two character rows)
\ (and it lies in the inner window, which win_open puts back)
ASSERT BAR_X - 2 - 16 * BAR_STEP - 4 >= 4 * (WINDOW_COL0 + WIN_INNER)
ASSERT BAR_X + 1 < 4 * (WINDOW_COL0 + WIN_INNER + WIN_INNER_CELLS)

\ win_aim: win_dst = character row Y's first window byte. win_cell: win_dst
\ moved on Y cells.
ZA_AUTO2 win_dst, win_src
.win_aim
    LDA screen_row_lo,Y : CLC : ADC #LO(WINDOW_COL0 * 8) : STA win_dst
    LDA screen_row_hi,Y : ADC #HI(WINDOW_COL0 * 8) : STA win_dst+1
    RTS
.win_cell
    TYA : ASL A : ASL A : ASL A
    BCC low
    INC win_dst+1
    CLC
.low
    ADC win_dst : STA win_dst
    BCC same
    INC win_dst+1
.same
    RTS
ASSERT WIN_INNER < 64 AND WIN_SPAN < 64  ; (win_cell's cells: their offsets' high bytes from the shift)

\ CELL_RUN first, last, copy: a routine for X cells (1-255) from win_dst on,
\ each line from first to last copied from win_src's cells (copy TRUE) or
\ cleared, win_dst and win_src moved on past them.
MACRO CELL_RUN first, last, copy
    IF NOT(copy)
        LDA #0
    ENDIF
    LDY #0
.cell
    FOR l = 0..7
        IF l >= first AND l <= last
            IF copy
                LDA (win_src),Y
            ENDIF
            STA (win_dst),Y
        ENDIF
        INY
    NEXT
    BNE same_page
    INC win_dst+1
    IF copy
        INC win_src+1
    ENDIF
.same_page
    DEX : BNE cell
    TYA : CLC : ADC win_dst : STA win_dst
    BCC dst_on
    INC win_dst+1
.dst_on
    IF copy
        TYA : CLC : ADC win_src : STA win_src
        BCC src_on
        INC win_src+1
.src_on
    ENDIF
    RTS
ENDMACRO
.cells_copy
    CELL_RUN 0, 7, TRUE
.cells_zero
    CELL_RUN 0, 7, FALSE
.lines_01
    CELL_RUN 0, 1, TRUE
.lines_02
    CELL_RUN 0, 2, TRUE
.lines_02_zero
    CELL_RUN 0, 2, FALSE

\ ---------------------------------------------------------------------------
\ objects_view (L_05248's draw loop, &05454): C set if no object is drawn,
\ as none is while the missile view's window moves; otherwise, in the
\ missile view, the camera made the missile (its place and angles stand
\ in for the player's, as they did for its lists: worldlogic.6502's
\ missile_lists) and the clip its window; and the objects' boxes onto this
\ screen's erase list (box.6502's box_aim). objects_unview puts back what
\ objects_view changed. (code.6502's view_objects.)
.objects_view
{
    JSR box_aim
    CLC
    LDA mv_render : BEQ done
    LDA m_iris : BEQ open
    SEC
.done
    RTS
.open
    JSR camera_swap
    LDY #CLIP_N
    JMP clip_window
}
.objects_unview
{
    LDA mv_render : BEQ done
    JSR camera_swap
    LDY #0
    JMP clip_window
.done
    RTS
}

\ camera_swap: the player's place and angles (pl_x to pl_roll) and the
\ missile's (m_x to m_roll) swapped.
.camera_swap
{
    LDX #11
.each
    LDY pl_x,X : LDA m_x,X : STA pl_x,X
    TYA : STA m_x,X
    DEX : BPL each
    RTS
}
ASSERT pl_roll = pl_x + 10 AND m_roll = m_x + 10

\ clip_window: render.6502's clip made the view's window's (Y = 0) or the
\ missile view's (Y = CLIP_N), each of CLIP_SITES' operands patched. C is
\ left clear.
.clip_window
{
    ZA_AUTO2 at
    TYA : CLC : ADC #CLIP_N - 1 : TAY
    LDX #CLIP_N - 1
.each
    LDA clip_lo,X : STA at : LDA clip_hi,X : STA at+1
    LDA clip_val,Y : STA (at)
    DEY : DEX : BPL each
    CLC
    RTS
}
.clip_lo
    EQUB LO(CLIP_SITES)
.clip_hi
    EQUB HI(CLIP_SITES)
.clip_val
    EQUB clip_values(VIEW_XMIN, VIEW_XMAX, VIEW_YMIN, VIEW_YMAX)
    EQUB clip_values(MV_XMIN, MV_XMAX, MV_YMIN, MV_YMAX)
ASSERT 2 * CLIP_N <= 256
ASSERT win_draw >= &8000                    ; (it sets X, which moves &3000-&7FFF)
