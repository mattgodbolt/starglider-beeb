\ ***************************************************************************
\ STARGLIDER for the BBC Master - the game logic's variables
\
\ Each is the ST's (docs/research/st-logic.md, "Every variable"), named
\ here, with where it is on the ST in braces: {ST address kind}. The
\ address is $nnn(a6) (the variable block), &nnn (low RAM) or P&nnnnn (the
\ program's own data); the kind is byte, word (the ST's big-endian word,
\ kept little-endian), word8 (a word whose high byte is always 0, kept as
\ its low byte), long, raw N (N bytes as they are), slot (the ST's pointer
\ to an object record, kept as the slot: &FF for none), or for an array
\ wlo N S / whi N S / barr N S (N words' low or high bytes, or N bytes, S
\ bytes apart on the ST) or slots N (N record pointers, kept as slots), or
\ for a list, list COUNT N (the address is the ST's pointer to the list's
\ first entry, record pointers pushed downward; COUNT its count's ST address,
\ N the port's count; the port keeps the slots in the order pushed). A
\ last word "in" marks an input the ST's interrupts write when they will (a
\ key's state): the harness puts it but doesn't compare it. tools/stmap.py reads them, and the harness
\ translates the ST's state into the port's and back by them
\ (tools/logicrun.mjs). Variables declared elsewhere carry the same braces
\ (the player, in zp.6502).
\
\ What any code may read, the drawing's included, is in the workspace;
\ what only the logic reads is in ANDY, after the logic's object fields
\ (objects.6502), paged with the logic's banks.
\ ***************************************************************************

SECTION LogicWork, org = work_end, guard = NMI_PAGE, virtual = TRUE
    \ the random numbers (logic/random.6502)
.rng_lag      SKIP 6        ; {ST $05C(a6) raw 6} random8's state; random32 adds its first four
.rng32        SKIP 4        ; {ST $064(a6) long} random32's state
.rng_out      SKIP 2        ; {ST $21A(a6) raw 2} random8's last two bytes
.rng_d0       SKIP 2        ; the caller's d0, which random8 adds: a hidden input on the ST
    \ the inputs: the accumulators the keys (and the ST's mouse) drive
.mouse_x      SKIP 2        ; {ST P&01842 word} the turn: roll is -(it asr 4)
.mouse_y      SKIP 2        ; {ST P&01844 word} the climb
.speed_acc    SKIP 2        ; {ST P&01848 word} the speed, negated
.world_vec    SKIP 2        ; world_call's routine (logic/arith.6502)
    \ world_render's logic (logic/worldlogic.6502): what the panel and the
    \ drawing show
.score        SKIP 4        ; {ST P&0150C long} BCD, eight digits
.last_kill    SKIP 2        ; {ST $286(a6) word} BCD, the last kill's score
.level        SKIP 1        ; {ST $296(a6) word8} 1-34
.laser_energy SKIP 2        ; {ST $28A(a6) word} &100 a shot; &FFFF full
.missiles     SKIP 1        ; {ST $278(a6) word8} carried, 0-2
.colour0_flash SKIP 2       ; {ST $242(a6) word} colour 0 at the frame's end, which clears it
.frame_count  SKIP 2        ; {ST $1E2(a6) word} frame_end's (logic/frame.6502): every frame_end call, wrapping
.m_iris       SKIP 1        ; {ST $27C(a6) word8} the missile view's window, closed by this much (steps of 8)
.bolt_timer   SKIP 1        ; {ST $284(a6) word8} the laser bolt's steps to go, 4-0
.bolt_target_x SKIP 2       ; {ST $24C(a6) word} the sight as it was when the bolt was fired
.bolt_target_y SKIP 2       ; {ST $24E(a6) word}
    \ the laser's keys, as the ST's key states hold them (the left button,
    \ Return, Insert, keypad Enter): non-zero while held
.key_fire_mouse  SKIP 1     ; {ST P&01836 byte in}
.key_fire_return SKIP 1     ; {ST P&017DE byte in}
.key_fire_insert SKIP 1     ; {ST P&01814 byte in}
.key_fire_enter  SKIP 1     ; {ST P&01834 byte in}
.logic_work_end
ENDSECTION

\ The lists (world.6502's, in memory.6502), as the ST's pointers and counts
\ hold them.
st_coarse_list = coarse_slots       ; {ST $090(a6) list $23C(a6) coarse_n}
st_near_list   = near_slots         ; {ST $098(a6) list $240(a6) near_n}
st_draw_list   = draw_slots         ; {ST $094(a6) list $23E(a6) draw_n}

\ Animation frames (zp.6502's anim_frame, by shape), as the ST's frame
\ lists number them: list &0D6CE drives shapes 1 and 10.
anim_s7  = anim_frame + 7           ; {ST P&0C17E word8}
anim_s1  = anim_frame + 1           ; {ST P&0D6CE word8}
anim_s10 = anim_frame + 10          ; {ST P&0D6CE word8}
anim_s15 = anim_frame + 15          ; {ST P&0FD4C word8}
anim_s11 = anim_frame + 11          ; {ST P&0D99C word8}
anim_s18 = anim_frame + 18          ; {ST P&10768 word8}
anim_s26 = anim_frame + 26          ; {ST P&11C18 word8}
anim_s27 = anim_frame + 27          ; {ST P&1204C word8}

SECTION LogicAndy, org = ANDY_OBJECTS_END, guard = ANDY_TOP, virtual = TRUE
    \ the player (logic/flight.6502)
.speed        SKIP 2        ; {ST $21E(a6) word}
.climb        SKIP 2        ; {ST $23A(a6) word} this frame's climb rate
.pl_vx        SKIP 2        ; {ST $140(a6) word} the move: written, never read
.pl_vz        SKIP 2        ; {ST $144(a6) word}
.trig_sin     SKIP 2        ; {ST $1CE(a6) word} the heading's sine and cosine
.trig_cos     SKIP 2        ; {ST $1D0(a6) word}
.jolt         SKIP 2        ; {ST $280(a6) word} the roll's jolt, settling to 0
.launch_state SKIP 2        ; {ST $292(a6) word} &1E at the tunnel's end; &1D on counts the launch
    \ the sight
.sight_cx     SKIP 2        ; {ST $204(a6) word} its centre
.sight_cy     SKIP 2        ; {ST $206(a6) word}
.sight_x      SKIP 2        ; {ST $244(a6) word} where it is
.sight_y      SKIP 2        ; {ST $246(a6) word}
.sight_dx     SKIP 2        ; {ST $248(a6) word} written, never read
.sight_dy     SKIP 2        ; {ST $24A(a6) word}
.sight_fixed  SKIP 1        ; {ST $2C1(a6) byte} F's
    \ the missile view (the missile the player launched, flown from its nose)
.missile_view SKIP 1        ; {ST $2C8(a6) byte}
.mv_render    SKIP 1        ; {ST $2C9(a6) byte}
.m_x          SKIP 2        ; {ST $26A(a6) word}
.m_y          SKIP 2        ; {ST $26C(a6) word}
.m_z          SKIP 2        ; {ST $26E(a6) word}
.m_pitch      SKIP 2        ; {ST $270(a6) word}
.m_heading    SKIP 2        ; {ST $272(a6) word}
.m_roll       SKIP 2        ; {ST $274(a6) word}
.m_life       SKIP 2        ; {ST $276(a6) word}
.m_roll_aim   SKIP 2        ; {ST $27A(a6) word}
    \ the ground dots, and the copy the missile view keeps
.dot_x_lo     SKIP 40       ; {ST $80C(a6) wlo 40 4}
.dot_x_hi     SKIP 40       ; {ST $80C(a6) whi 40 4}
.dot_z_lo     SKIP 40       ; {ST $80E(a6) wlo 40 4}
.dot_z_hi     SKIP 40       ; {ST $80E(a6) whi 40 4}
.dots_x_lo    SKIP 40       ; {ST $8AC(a6) wlo 40 4}
.dots_x_hi    SKIP 40       ; {ST $8AC(a6) whi 40 4}
.dots_z_lo    SKIP 40       ; {ST $8AE(a6) wlo 40 4}
.dots_z_hi    SKIP 40       ; {ST $8AE(a6) whi 40 4}

    \ world_render's logic (logic/worldlogic.6502)
.kill_score   SKIP 2        ; {ST $0D4(a6) word} BCD: a kill's score, which the next normal view adds (a mailbox, not a sum)
.score_addend SKIP 4        ; {ST P&01A4C long} the score add's operand, kill_score as it was
.last_score_byte SKIP 1     ; {ST $2D5(a6) byte} the score's second byte at the last level change
.level_changed SKIP 1       ; {ST $2D7(a6) byte} &FF when the score has just changed its ten-thousands
.level_msg    SKIP 1        ; {ST $298(a6) word8} frames of LEVEL n left
.cheat        SKIP 1        ; {ST $2CD(a6) byte}
.docked_silo  SKIP 1        ; {ST $0A8(a6) slot} the silo docked in
.shots_fired  SKIP 4        ; {ST $0B0(a6) long}
.hits_scored  SKIP 4        ; {ST $0B8(a6) long} laser hits that took a hit point
.laser_px     SKIP 2        ; {ST $254(a6) word} the laser's last box tested, projected: written, never read
.laser_py     SKIP 2        ; {ST $256(a6) word}
.laser_half_w SKIP 2        ; {ST $258(a6) word}
.laser_half_h SKIP 2        ; {ST $25A(a6) word}
    \ the drawing's matrix cache (&04114): the angles of the last object
    \ matrix built, which decide whether the draw loop leaves the camera's
    \ sines in trig_sin and trig_cos or an object's
.obm_pitch    SKIP 2        ; {ST $180(a6) word}
.obm_heading  SKIP 2        ; {ST $182(a6) word}
.obm_roll     SKIP 2        ; {ST $184(a6) word}

    \ the keys and commands (logic/keys.6502)

    \ the object handlers (logic/handlers.6502)

    \ collisions, docking, refuelling and the laser (logic/collide.6502)

    \ the frame's end and the post-frame tests (logic/frame.6502)

    \ the level change (logic/level.6502)

ENDSECTION
