\ ***************************************************************************
\ STARGLIDER for the BBC Master - the game logic's variables
\
\ Each is the ST's (docs/research/st-logic.md, "Every variable"), named
\ here, with where it is on the ST in braces: {ST address kind}. The
\ address is $nnn(a6) (the variable block), &nnn (low RAM) or P&nnnnn (the
\ program's own data); the kind is byte, word (the ST's big-endian word,
\ kept little-endian), word8 (a word whose high byte is always 0, kept as
\ its low byte), long, raw N (N bytes as they are), slot (the ST's pointer
\ to an object record, kept as the slot: &FF for none), or for an array
\ wlo N S / whi N S / barr N S (N words' low or high bytes, or N bytes, S
\ bytes apart on the ST), slots N (N record pointers, kept as slots),
\ slotsdown N (N record pointers pushed downward from the address, the
\ first just below it, kept as slots in the order pushed), index A S (the
\ ST's pointer into its array at A of S-byte entries, kept as the entry's
\ number) or list COUNT N (the address is the ST's pointer to the list's
\ first entry, record pointers pushed downward; COUNT its count's ST
\ address, N the port's count; the port keeps the slots in the order
\ pushed). A last word "in" marks an input, given to the routine, never
\ compared (what an interrupt changes in real time between the points, as
\ a key's state). tools/stmap.py reads them, and the harness translates
\ the ST's state into the port's and back by them (tools/logicrun.mjs).
\ Variables declared elsewhere carry the same braces (the player, in
\ zp.6502; the near list, in zp.6502 and memory.6502).
\
\ What any code may read, the drawing's included, is in the workspace;
\ what only the logic reads is in ANDY, after the logic's object fields
\ (objects.6502), paged with the logic's banks.
\ ***************************************************************************

SECTION LogicWork, org = work_end, guard = NMI_PAGE, virtual = TRUE
    \ the random numbers (logic/random.6502)
.rng_lag      SKIP 6        ; {ST $05C(a6) raw 6} random8's state; random32 adds its first four
.rng32        SKIP 4        ; {ST $064(a6) long} random32's state
.rng_out      SKIP 2        ; {ST $21A(a6) raw 2} random8's last two bytes
.rng_d0       SKIP 2        ; the caller's d0, which random8 adds: a hidden input on the ST
    \ the inputs: the accumulators the keys (and the ST's mouse) drive
.mouse_x      SKIP 2        ; {ST P&01842 word} the turn: roll is -(it asr 4)
.mouse_y      SKIP 2        ; {ST P&01844 word} the climb
.speed_acc    SKIP 2        ; {ST P&01848 word} the speed, negated
    \ ... and the keys, as the ST's keyboard interrupt leaves them, which
    \ the keyboard layer fills (decision 6): each key's state by the ST's
    \ scancode, 1 held, and the last key made, which read_keys consumes
.key_state    SKIP 128      ; {ST P&017C2 raw 128 in}
.key_latch    SKIP 1        ; {ST P&01852 byte in} 0 for none
    \ what the keys and commands (logic/keys.6502) keep that the panel,
    \ the drawing or the sound read
.m_iris       SKIP 2        ; {ST $27C(a6) word} the missile view's opening and closing
.sound_on     SKIP 1        ; {ST $2CB(a6) byte} Q's and S's
.cheat_mode   SKIP 1        ; {ST $2CD(a6) byte}
.energy       SKIP 2        ; {ST $25E(a6) word} full at &FFFF
.shields      SKIP 2        ; {ST $260(a6) word}
.laser_energy SKIP 2        ; {ST $28A(a6) word}
.world_vec    SKIP 2        ; world_call's routine (logic/arith.6502)
.logic_vec    SKIP 2        ; logic_bank_call's
    \ the game's state the handlers (logic/handlers.6502) read and write,
    \ which the panel and the drawing show
.level        SKIP 2        ; {ST $296(a6) word} from 1
.level_msg    SKIP 2        ; {ST $298(a6) word} the steps "LEVEL n" has left
.missiles     SKIP 2        ; {ST $278(a6) word} the player's
.flash0       SKIP 2        ; {ST $242(a6) word} this step's flash of colour 0 (0 none)
    \ world_render's logic (logic/worldlogic.6502): what the panel and the
    \ drawing show
.score        SKIP 4        ; {ST P&0150C long} BCD, eight digits
.last_kill    SKIP 2        ; {ST $286(a6) word} BCD, the last kill's score
.kill_shown   SKIP 2        ; the port's own: last_kill before this step's kill, which the ST prints
.world_text   SKIP 1        ; the port's own: what world_render printed this step (TX_*)
.frame_count  SKIP 2        ; {ST $1E2(a6) word} frame_end's (logic/frame.6502): every frame_end call, wrapping
.bolt_timer   SKIP 1        ; {ST $284(a6) word8} the laser bolt's steps to go, 4-0
.bolt_target_x SKIP 2       ; {ST $24C(a6) word} the sight as it was when the bolt was fired
.bolt_target_y SKIP 2       ; {ST $24E(a6) word}
    \ collisions and the frame's end (logic/collide.6502, logic/frame.6502):
    \ what the panel, the screen and the sound read
.flash_shown  SKIP 2        ; the port's own: colour 0 from this frame's end (the ST's &FF8240)
.refuelling   SKIP 1        ; {ST $2C3(a6) byte} in a beam whose test passed
.level_text   SKIP 1        ; the port's own: non-zero when this frame shows 'LEVEL n' (level_message)
.dock_text    SKIP 1        ; the port's own: non-zero when the docked texts show (post_frame)
.mine_text    SKIP 1        ; the port's own: a mine's text this frame (mine_proximity), 0 from post_frame
.game_over    SKIP 2        ; {ST $12C(a6) word} 1: the energy ran out; 2: the shields
.sample_clip  SKIP 1        ; the port's own: the speech sample_start plays (the ST's &A0, a pointer)
.sample_len   SKIP 4        ; {ST &0A4 long} the ST's length of it, in bytes
.sample_tacr  SKIP 1        ; {ST &2CF byte} the ST's Timer A control and data: its rate
.sample_tadr  SKIP 1        ; {ST &2D0 byte}
.sample_left  SKIP 4        ; {ST P&01E56 long in} bytes still to play, which the player counts down
.logic_work_end
ENDSECTION

\ world_text's bits: DOCKING, PRESS I FOR INTERROGATE (&05002), LAUNCHING
\ FROM SILO (&0562E) and the missile view's countdown (&052A6), each when
\ world_render prints it (src/panel.6502 draws them).
TX_DOCKING = 1
TX_LAUNCH  = 2
TX_COUNT   = 8
\ mine_text's
MINE_DETECTED = 1                   ; 'WARNING:  MINE DETECTED'
MINE_EXPLODED = 2                   ; 'MINE HAS JUST EXPLODED!'

\ The lists (world.6502's, in memory.6502), as the ST's pointers and counts
\ hold them.
st_coarse_list = coarse_slots       ; {ST $090(a6) list $23C(a6) coarse_n}
st_near_list   = near_slots         ; {ST $098(a6) list $240(a6) near_n}
st_draw_list   = draw_slots         ; {ST $094(a6) list $23E(a6) draw_n}

\ Animation frames (zp.6502's anim_frame, by shape), as the ST's frame
\ lists number them: list &0D6CE drives shapes 1 and 10.
anim_s7  = anim_frame + 7           ; {ST P&0C17E word8}
anim_s1  = anim_frame + 1           ; {ST P&0D6CE word8}
anim_s10 = anim_frame + 10          ; {ST P&0D6CE word8 also}
anim_s15 = anim_frame + 15          ; {ST P&0FD4C word8}
anim_s11 = anim_frame + 11          ; {ST P&0D99C word8}
anim_s18 = anim_frame + 18          ; {ST P&10768 word8}
anim_s26 = anim_frame + 26          ; {ST P&11C18 word8}
anim_s27 = anim_frame + 27          ; {ST P&1204C word8}

SECTION LogicAndy, org = ANDY_OBJECTS_END, guard = ANDY_TOP, virtual = TRUE
    \ the player (logic/flight.6502)
.speed        SKIP 2        ; {ST $21E(a6) word}
.climb        SKIP 2        ; {ST $23A(a6) word} this frame's climb rate
.pl_vx        SKIP 2        ; {ST $140(a6) word} the move: written, never read
.pl_vz        SKIP 2        ; {ST $144(a6) word}
.trig_sin     SKIP 2        ; {ST $1CE(a6) word} the heading's sine and cosine
.trig_cos     SKIP 2        ; {ST $1D0(a6) word}
.jolt         SKIP 2        ; {ST $280(a6) word} the roll's jolt, settling to 0
.launch_state SKIP 2        ; {ST $292(a6) word} &1E at the tunnel's end; &1D on counts the launch
    \ the sight
.sight_cx     SKIP 2        ; {ST $204(a6) word} its centre
.sight_cy     SKIP 2        ; {ST $206(a6) word}
.sight_x      SKIP 2        ; {ST $244(a6) word} where it is
.sight_y      SKIP 2        ; {ST $246(a6) word}
.sight_dx     SKIP 2        ; {ST $248(a6) word} written, never read
.sight_dy     SKIP 2        ; {ST $24A(a6) word}
.sight_fixed  SKIP 1        ; {ST $2C1(a6) byte} F's
    \ the missile view (the missile the player launched, flown from its nose)
.missile_view SKIP 1        ; {ST $2C8(a6) byte}
.mv_render    SKIP 1        ; {ST $2C9(a6) byte}
.m_x          SKIP 2        ; {ST $26A(a6) word}
.m_y          SKIP 2        ; {ST $26C(a6) word}
.m_z          SKIP 2        ; {ST $26E(a6) word}
.m_pitch      SKIP 2        ; {ST $270(a6) word}
.m_heading    SKIP 2        ; {ST $272(a6) word}
.m_roll       SKIP 2        ; {ST $274(a6) word}
.m_life       SKIP 2        ; {ST $276(a6) word}
.m_roll_aim   SKIP 2        ; {ST $27A(a6) word}
    \ the ground dots, and the copy the missile view keeps
.dot_x_lo     SKIP 40       ; {ST $80C(a6) wlo 40 4}
.dot_x_hi     SKIP 40       ; {ST $80C(a6) whi 40 4}
.dot_z_lo     SKIP 40       ; {ST $80E(a6) wlo 40 4}
.dot_z_hi     SKIP 40       ; {ST $80E(a6) whi 40 4}
.dots_x_lo    SKIP 40       ; {ST $8AC(a6) wlo 40 4}
.dots_x_hi    SKIP 40       ; {ST $8AC(a6) whi 40 4}
.dots_z_lo    SKIP 40       ; {ST $8AE(a6) wlo 40 4}
.dots_z_hi    SKIP 40       ; {ST $8AE(a6) whi 40 4}

    \ world_render's logic (logic/worldlogic.6502)
.score_addend SKIP 4        ; {ST P&01A4C long} the score add's operand, kill_score as it was
.last_score_byte SKIP 1     ; {ST $2D5(a6) byte} the score's second byte at the last level change
.level_changed SKIP 1       ; {ST $2D7(a6) byte} &FF when the score has just changed its ten-thousands
.docked_silo  SKIP 1        ; {ST $0A8(a6) slot} the silo docked in
    \ the pilot rating's counts, in the ST's order: new_game clears them together
.shots_fired  SKIP 4        ; {ST $0B0(a6) long}
.hits_scored  SKIP 4        ; {ST $0B8(a6) long} laser hits that took a hit point
.dockings     SKIP 4        ; {ST $0C0(a6) long} for the pilot rating
.hits_taken   SKIP 4        ; {ST $0C4(a6) long} the enemies' laser hits, for the rating
    ASSERT hits_scored = shots_fired + 4 AND dockings = shots_fired + 8 AND hits_taken = shots_fired + 12
.laser_px     SKIP 2        ; {ST $254(a6) word} the laser's last box tested, projected: written, never read
.laser_py     SKIP 2        ; {ST $256(a6) word}
.laser_half_w SKIP 2        ; {ST $258(a6) word}
.laser_half_h SKIP 2        ; {ST $25A(a6) word}
    \ the drawing's matrix cache (&04114): the angles of the last object
    \ matrix built, which decide whether the draw loop leaves the camera's
    \ sines in trig_sin and trig_cos or an object's
.obm_pitch    SKIP 2        ; {ST $180(a6) word}
.obm_heading  SKIP 2        ; {ST $182(a6) word}
.obm_roll     SKIP 2        ; {ST $184(a6) word}

    \ the keys and commands (logic/keys.6502)
.def_left     SKIP 1        ; {ST $2D8(a6) byte} the K screen's keys, as scancodes: 0 for none
.def_right    SKIP 1        ; {ST $2D9(a6) byte}
.def_dive     SKIP 1        ; {ST $2DA(a6) byte} (its "Decrease Altitude")
.def_climb    SKIP 1        ; {ST $2DB(a6) byte}
.def_accel    SKIP 1        ; {ST $2DC(a6) byte}
.def_brake    SKIP 1        ; {ST $2DD(a6) byte}
.cheat_count  SKIP 1        ; {ST $294(a6) word8} the cheat's entries, modulo 2
.enemies_active SKIP 1      ; {ST $2C7(a6) byte} 0: M has frozen the enemies' handlers
.pending_score SKIP 2       ; {ST $0D4(a6) word} BCD, for the next world_render to add

    \ the object handlers (logic/handlers.6502)
.free_stack   SKIP SLOTS    ; {ST &94C slots 140} the free slots, the last freed on top
.free_n       SKIP 1        ; {ST $25C(a6) word8} how many
free_top = free_n           ; {ST $09C(a6) index &94C 4} (the ST's pointer past the top)
.homing       SKIP 1        ; {ST $2D6(a6) byte} non-zero: this handler's launch is homing

    \ collisions, docking, refuelling and the laser (logic/collide.6502)
.ram_hit      SKIP 1        ; {ST $2BF(a6) byte} this frame's collisions found a ram
.ram_obj      SKIP 1        ; {ST $0AC(a6) slot} what was rammed
.refuel_latch SKIP 1        ; {ST $2C4(a6) byte} the refuelling test is made for this contact

    \ what the ST draws in the middle of the logic, kept by the logic for
    \ the drawing to draw (view.6502): the port's own, all of it, each the
    \ last step's
.dots_ran     SKIP 1        ; non-zero when ground_dots ran (world_lists)
.dot_seen     SKIP 40       ; by dot: non-zero if ground_dots found it in view, so plotted it (DOT_KEPT ...)
.dot_cx_lo    SKIP 40       ; ... and where it is in camera space, if ground_dots rotated it
.dot_cx_hi    SKIP 40
.dot_cy_lo    SKIP 40
.dot_cy_hi    SKIP 40
.dot_cz_lo    SKIP 40
.dot_cz_hi    SKIP 40
DOT_KEPT   = &80            ; dot_seen: in view, by what was known of it (not rotated)
DOT_GROUND = &C0            ; ... rotated by the ground's rotation, within 4 (bit 6: rotated)
DOT_EXACT  = &E0            ; ... rotated exactly (bit 5)
.bolt_shown   SKIP 1        ; non-zero when player_laser drew the bolt (world_after)
SHOTS = 4                   ; the enemies' laser shots a step kept: no more are drawn
.shot_n       SKIP 1        ; the shots (enemy_laser) ...
.shot_x_lo    SKIP SHOTS    ; ... each from the attacker's gun, in camera space ...
.shot_x_hi    SKIP SHOTS
.shot_y_lo    SKIP SHOTS
.shot_y_hi    SKIP SHOTS
.shot_z_lo    SKIP SHOTS
.shot_z_hi    SKIP SHOTS
.shot_end     SKIP SHOTS    ; ... to this x on the window's bottom edge
.logic_andy_end             ; (the panel's follow: src/panel.6502)
ENDSECTION
