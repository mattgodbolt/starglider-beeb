\ ***************************************************************************
\ STARGLIDER for the BBC Master - HAZEL and the sideways banks, for every
\ build
\ ***************************************************************************

\ HAZEL: the tables and what runs with ACCCON's X set (hazel.6502) ...
SECTION Tables, org = TABLES, filename = "TABLES", guard = CODE2, cmos = TRUE
INCLUDE "squares.6502"
INCLUDE "recip.6502"
INCLUDE "hazel.6502"
INCLUDE "../build/gen/linemode.6502"
ENDSECTION

\ ... and more code.
SECTION Code2, org = CODE2, filename = "CODE2", guard = &E000, cmos = TRUE
INCLUDE "../build/gen/line.6502"
INCLUDE "../build/gen/xform.6502"
ENDSECTION

\ A bank's first bytes are where the OS looks for a ROM's header: a zero
\ there (no copyright string at &8000) keeps it from taking the data for
\ one after a BREAK.
SECTION Shapes, org = &8000, filename = "SHAPES", guard = &C000
    EQUD 0, 0
INCLUDE "../build/gen/shapes.6502"
ENDSECTION

\ The world's bank: the list phase, which runs with the bank alone; then,
\ from where ANDY ends (the logic runs with ANDY paged over the bank's
\ first 4K: docs/plan.md), the sine table the camera, the objects' matrices
\ and the logic read, and the logic.
SECTION WorldBank, org = &8000, filename = "WORLD", guard = &C000, cmos = TRUE
    EQUD 0, 0
INCLUDE "world.6502"
INCLUDE "../build/gen/rotate.6502"
.world_list_end
IF P% < ANDY_TOP
    SKIP ANDY_TOP - P%
ENDIF
INCLUDE "sine.6502"
ASSERT sine_qlo >= ANDY_TOP AND sincos >= ANDY_TOP  ; the logic reads them with ANDY paged
INCLUDE "logic/animate.6502"
IF DEFINED(SPIKE)                   ; (on the disc with the flight layer)
INCLUDE "logic/flight.6502"
INCLUDE "logic/worldlogic.6502"
INCLUDE "logic/handlers.6502"
ENDIF
ENDSECTION

\ The logic's bank: the rest of the game's logic, which needn't read the
\ sine table, from where ANDY ends (the logic runs with ANDY paged).
IF DEFINED(SPIKE)                   ; (on the disc with the flight layer)
SECTION LogicBank, org = &8000, filename = "LOGIC", guard = &C000, cmos = TRUE
    EQUD 0, 0
    \ From where ANDY ends, and past the world bank's list phase too: Baron
    \ matches its control-flow annotations to their jumps by address alone
    \ (waitingforvsync/baron#29), so a jump here at the address of one of the
    \ rotations' annotated jumps would take on that jump's targets.
    SKIP MAX({ANDY_TOP, world_list_end}) - P%
INCLUDE "logic/keys.6502"
INCLUDE "logic/laser.6502"
INCLUDE "logic/collide.6502"
INCLUDE "logic/frame.6502"
INCLUDE "logic/level.6502"
    \ (baron#29 again) and short of the world bank's other annotated jump,
    \ the handlers' dispatch
    ASSERT P% <= object_handlers.dispatch
ENDSECTION
ENDIF
