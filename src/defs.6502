\ ***************************************************************************
\ STARGLIDER for the BBC Master - shared constants
\ ***************************************************************************

\ --- Hardware ------------------------------------------------------------

crtc_reg   = &FE00
crtc_data  = &FE01
romsel     = &FE30          ; the sideways bank at &8000
acccon     = &FE34          ; the Master's access control
ACCCON_D   = 1              ; ... D: the CRTC shows shadow RAM
ACCCON_X   = 4              ; ... X: the CPU's &3000-&7FFF is shadow RAM
ACCCON_Y   = 8              ; ... Y: HAZEL's RAM at &C000-&DFFF
sysvia_orb = &FE40          ; the addressable latch (bit 3: the keyboard's enable);
                            ; read, bits 4 and 5 the joysticks' fire buttons, low pressed
sysvia_ddra = &FE43
sysvia_ifr = &FE4D          ; bit 1: the vertical sync (CA1) has come
sysvia_ier = &FE4E          ; write bit 7 clear to disable the bits set
sysvia_ora_nh = &FE4F       ; port A without handshake: the keyboard
usrvia_t1cl = &FE64         ; T1's counter, low (reading it acknowledges T1)
usrvia_t1ch = &FE65         ; ... high (writing it starts the count)
usrvia_acr = &FE6B
usrvia_ifr = &FE6D
usrvia_ier = &FE6E
ula_pal    = &FE21          ; the video ULA's palette
adc_control = &FE18         ; the Master's ADC: write a channel to convert it (bit 3
                            ; clear: 8 bits); read, bit 7 set while converting
adc_high   = &FE19          ; the conversion's top 8 bits
irq1v      = &0204          ; the OS's IRQ vector, which the game takes

\ --- The screen -----------------------------------------------------------
\ MODE 1 at the ST's 320 x 200 (decision 3): MODE 1's 80 columns and 25 of
\ its character rows, at the top of RAM. A character row is 640 bytes.
SCREEN_ROWS = 25
SCREEN_ROW  = 640
SCREEN      = &8000 - SCREEN_ROWS * SCREEN_ROW

\ --- Sideways RAM ---------------------------------------------------------
BANK_SHAPES  = 4
BANK_WORLD   = 5                    ; the list phase, the sine table and the logic that reads it
BANK_LOGIC   = 6                    ; the rest of the logic
BANK_LOG     = 7                    ; the spike's line log

\ --- Objects --------------------------------------------------------------
\ The ST's 140 slots, then the silo's tunnel (the ST's &1218) and its
\ missile (&1258): the table is build/gen/objects.6502 (tools/mkobjects.py).
SLOTS        = 140
SLOT_TUNNEL  = SLOTS
SLOT_MISSILE = SLOTS + 1

\ --- ANDY -------------------------------------------------------------------
\ The Master's 4K of RAM over the first 4K of the sideways banks while
\ ROMSEL's bit 7 is set: the logic's data (docs/plan.md, section 3).
ANDY     = &8000
ANDY_TOP = &9000
ROMSEL_ANDY = &80
