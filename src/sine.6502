; The ST's sine table (&13D6C): 16384 sin(2 pi i / 4096), 4096 steps a
; turn, with entries to 5119 because the cosine is read 1024 on. Made as
; the ST's was: pi as 3.14159, and rounded by truncating x + 0.5, which
; gives every entry but twelve. Those twelve lie within 0.005 of a tie,
; which the ST's own arithmetic rounded the other way; SINE_UP and
; SINE_DOWN put them back.
;
; The table isn't quite periodic or symmetric (pi is short), but nearly:
; its first quarter gives every other entry by symmetry (mirrored in the
; odd quarters, and in the third and fourth negated as the rounding
; negates, 1 - v, since truncating x + 0.5 takes a negative value's half
; towards zero), but for the entries sine_bits marks, which are one more
; than that in the second and third quarters and one less in the fourth
; and fifth. sincos (below) puts them together, and
; tools/sinecheck.py checks it against the ST's table for every angle.
SINE_ENTRIES = 5120
SINE_QUARTER = 1024
SINE_UP = {342, 445, 1003, 1736, 2535}
SINE_DOWN = {2140, 3722, 3798, 4059, 4195, 4341, 4497}
FUNCTION st_sine(i) = TRUNC(16384 * SIN(i * 2 * 3.14159 / 4096) + 0.5) + SUM(SINE_UP = i) - SUM(SINE_DOWN = i)

\ What the first quarter gives entry i by symmetry.
FUNCTION sine_symmetric(i)
    q = (i DIV SINE_QUARTER) AND 3
    r = i AND (SINE_QUARTER - 1)
    IF (q AND 1) = 1
        v = st_sine(SINE_QUARTER - r)
    ELSE
        v = st_sine(r)
    ENDIF
    IF q >= 2
        w = (v <> 0) * (1 - v)
    ELSE
        w = v
    ENDIF
= w

\ Whether entry i is one that symmetry misses, and where it misses, the
\ quarter it's in says by how much (+1 or -1).
FUNCTION sine_missed(i) = st_sine(i) <> sine_symmetric(i)
FUNCTION sine_off(i)
    ASSERT NOT(sine_missed(i)) OR st_sine(i) - sine_symmetric(i) = 1 - 2 * (i >= 3 * SINE_QUARTER), "sine entry ", i, " is off by ", st_sine(i) - sine_symmetric(i)
= sine_missed(i)

\ The first quarter, 0 to 1023 (entry 1024 is 16384): low bytes, then
\ high, each 1K, from a 1K boundary so a page's number holds i's top bits.
ALIGN &400
.sine_qlo
FOR i = 0..<SINE_QUARTER
    EQUB LO(st_sine(i))
NEXT
.sine_qhi
FOR i = 0..<SINE_QUARTER
    EQUB HI(st_sine(i))
NEXT
ASSERT st_sine(SINE_QUARTER) = 16384

\ Entries 1024-5119 symmetry misses: entry 1024 + k is bit k DIV 512 of
\ byte k AND 511, so an angle's sine and cosine (1024 apart) share a byte.
SINE_BITS = (SINE_ENTRIES - SINE_QUARTER) DIV 8
.sine_bits
FOR k = 0..<SINE_BITS
    e = SINE_QUARTER + k
    EQUB sine_off(e) + 2 * sine_off(e + SINE_BITS) + 4 * sine_off(e + 2 * SINE_BITS) + 8 * sine_off(e + 3 * SINE_BITS) + 16 * sine_off(e + 4 * SINE_BITS) + 32 * sine_off(e + 5 * SINE_BITS) + 64 * sine_off(e + 6 * SINE_BITS) + 128 * sine_off(e + 7 * SINE_BITS)
NEXT
ASSERT LO(sine_bits) = 0 AND SINE_BITS = 512
.sine_mask
    EQUB 1, 2, 4, 8, 16, 32, 64, 128

\ sincos: m_sin, m_cos = the ST's sine table at m_idx (0-4095) and 1024
\ on, from its first quarter and the entries symmetry misses (above).
\ The sine bank must be paged.
.sincos
{
    ZA_AUTO2 p
    ZA_AUTO1 q, rhi, bits
    STZ p
    \ m_idx's quarter, and r, its place in it: the sine is the quarter's
    \ entry r in the even quarters (r into m_sin, 1024 - r into m_cos) and
    \ the other way round in the odd
    LDA m_idx+1 : AND #3 : STA rhi
    ASSERT (HI(sine_qlo) AND 3) = 0 AND sine_qhi = sine_qlo + SINE_QUARTER
    ORA #HI(sine_qlo) : STA p+1
    LDA m_idx+1 : LSR A : LSR A : STA q
    LDX #0
    LSR A : BCC even
    LDX #m_cos - m_sin
.even
    ZA_DISCARD m_sc                     ; (all four bytes are made below)
    LDY m_idx
    LDA (p),Y : STA m_sc,X : ZA_INDEXEDBY {0, 2}
    LDA p+1 : CLC : ADC #HI(SINE_QUARTER) : STA p+1
    LDA (p),Y : STA m_sc+1,X : ZA_INDEXEDBY {0, 2}
    \ 1024 - r: the quarter's last entry, 16384, isn't kept
    TXA : EOR #m_cos - m_sin : TAX
    LDA #0 : SEC : SBC m_idx : TAY
    LDA #HI(SINE_QUARTER) : SBC rhi
    CMP #HI(SINE_QUARTER) : BNE in_quarter
    STZ m_sc,X : ZA_INDEXEDBY {0, 2}
    LDA #HI(16384) : STA m_sc+1,X : ZA_INDEXEDBY {0, 2}
    BRA got
.in_quarter
    ORA #HI(sine_qlo) : STA p+1
    LDA (p),Y : STA m_sc,X : ZA_INDEXEDBY {0, 2}
    LDA p+1 : CLC : ADC #HI(SINE_QUARTER) : STA p+1
    LDA (p),Y : STA m_sc+1,X : ZA_INDEXEDBY {0, 2}
.got
    \ The sine negated in the third and fourth quarters, the cosine in the
    \ second and third: to 1 - v if v isn't 0, the ST's rounding.
    LDX q
    LDA sin_neg,X : BPL sin_done
    LDA m_sin : ORA m_sin+1 : BEQ sin_done
    LDA #1 : SEC : SBC m_sin : STA m_sin
    LDA #0 : SBC m_sin+1 : STA m_sin+1
.sin_done
    LDA cos_neg,X : BPL cos_done
    LDA m_cos : ORA m_cos+1 : BEQ cos_done
    LDA #1 : SEC : SBC m_cos : STA m_cos
    LDA #0 : SBC m_cos+1 : STA m_cos+1
.cos_done
    \ The entries symmetry misses: the cosine's is entry m_idx + 1024, k
    \ m_idx; the sine's, from the second quarter, k m_idx - 1024, in the
    \ same byte two bits lower.
    LDA m_idx+1 : AND #1 : ORA #HI(sine_bits) : STA p+1
    LDY m_idx : LDA (p),Y : BEQ kept
    STA bits
    LDA m_idx+1 : LSR A : TAY
    LDA bits : AND sine_mask,Y : BEQ cos_kept
    LDA m_idx+1 : CMP #HI(2 * SINE_QUARTER)    ; +1 below entry 3072, -1 from it
    LDX #m_cos - m_sin
    JSR nudge
.cos_kept
    LDA q : BEQ kept                            ; nothing missed in the first quarter
    LDA bits : AND sine_mask - 2,Y : BEQ kept
    LDA m_idx+1 : CMP #HI(3 * SINE_QUARTER)
    LDX #0
    JSR nudge
.kept
    RTS
\ nudge: the word at m_sin + X one more if carry is clear, one less if
\ it's set.
.nudge
    BCS down
    INC m_sin,X : ZA_INDEXEDBY {0, 2}
    BNE nudged
    INC m_sin+1,X : ZA_INDEXEDBY {0, 2}
.nudged
    RTS
.down
    LDA m_sin,X : ZA_INDEXEDBY {0, 2}
    BNE low
    DEC m_sin+1,X : ZA_INDEXEDBY {0, 2}
.low
    DEC m_sin,X : ZA_INDEXEDBY {0, 2}
    RTS
\ by the sine's quarter: whether the sine and the cosine are negated
.sin_neg
    EQUB 0, 0, &80, &80
.cos_neg
    EQUB 0, &80, &80, 0
}

