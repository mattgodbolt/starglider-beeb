\ ***************************************************************************
\ STARGLIDER for the BBC Master - world_render's logic (the ST's &04FE8)
\
\ world_render draws, but it also decides: the level-up test, the score
\ add, the camera, the ground dots' respawning (which takes random
\ numbers), the docked tunnel's stop, refill and pick-up and the launch's
\ count inside the coarse pass, the lists, and after the draw loop the
\ player's laser (docs/research/st-logic.md, "The frame's end, the score,
\ the interrupts and world_render's logic"). world_lists is its logic up to
\ the lists (the capture's top to lists); world_after, the rest (lists to
\ render), is in the logic bank (laser.6502); the frame draws between
\ (decision 14). The drawing (the
\ view's clear, the messages and the score printed, the gunsight's blit,
\ the dots plotted, the bolts) is the renderer's; what it leaves in the
\ variables the logic reads, and in the d0 the dots' random8 adds, is
\ here.
\
\ The list phase (world.6502, rotate.6502) lies below ANDY_TOP, so ANDY
\ comes out round each call of it.
\ ***************************************************************************

\ The projection's shift ($212, colour), which the laser's boxes use and
\ which a projected dot leaves in d0.
PROJ_SHIFT = 7

\ The gunsight's blit (&0983C, D_0732A): the d0 its last word leaves, by
\ the sight's x less the hotspot's (14), mod 16. At 0 the blit only copies,
\ and d0 is what it was.
.sight_d0_lo
    EQUB &00, &00, &80, &C0, &E0, &F0, &F8, &7C, &3E, &1F, &0F, &07, &83, &C1, &E0, &F0
.sight_d0_hi
    EQUB &00, &1F, &0F, &07, &83, &C1, &E0, &F0, &F8, &7C, &3E, &1F, &0F, &07, &03, &01

\ ---------------------------------------------------------------------------
\ world_lists (&04FE8 to &05108): up to the lists, in the normal view or
\ the missile view's (L_05248).
.world_lists
{
    STZ dots_ran                        ; (for the drawing: until ground_dots runs)
    STZ world_text
    LDA mv_render : BEQ normal
    JMP missile_lists
.normal
    \ docked, colour 0 flashes &036, and DOCKING, PRESS I FOR INTERROGATE
    \ shows but at the tunnel's end
    LDA docked : BEQ level_test
    LDA #&36 : STA flash0 : STZ flash0+1
    LDA launch_state+1 : BNE docking
    LDA launch_state : CMP #&1E : BEQ level_test
.docking
    LDA #TX_DOCKING : TSB world_text
.level_test
    \ the level up (&0502C): any change in the score's second byte (its
    \ ten-thousands), tested before this frame's add, so a frame late
    STZ level_changed
    LDA score+2 : CMP last_score_byte : BEQ add
    INC level
    LDA #&32 : STA level_msg : STZ level_msg+1
    LDA score+2 : STA last_score_byte
    LDA #&FF : STA level_changed
    LDA level : CMP #&23 : BNE add
    LDA #&22 : STA level
.add
    \ the kill's score (&05086): shown as the last kill when non-zero (the
    \ ST prints the last kill before, so a step late: kill_shown), then
    \ added, with the X flag clear and the last carry lost; d0 holds it,
    \ which the gunsight's blit may change
    MOVW kill_shown, last_kill
    LDA pending_score : STA rng_d0 : STA score_addend
    LDA pending_score+1 : STA rng_d0+1 : STA score_addend+1
    STZ score_addend+2 : STZ score_addend+3
    ORA pending_score : BEQ adding
    MOVW last_kill, pending_score
.adding
    SED
    CLC
    LDA score : ADC pending_score : STA score
    LDA score+1 : ADC pending_score+1 : STA score+1
    LDA score+2 : ADC #0 : STA score+2
    LDA score+3 : ADC #0 : STA score+3
    CLD
    STZ pending_score : STZ pending_score+1
    \ the camera's sines (&050A2): the heading's are the logic's trig_sin
    \ and trig_cos
    LDA pl_heading : STA m_idx : LDA pl_heading+1 : AND #&0F : STA m_idx+1
    JSR sincos
    MOVW trig_sin, m_sin : MOVW trig_cos, m_cos
    JSR sight_blit
    LDA #BANK_WORLD : STA bank_now : STA romsel
    JSR camera
    LDA #BANK_WORLD OR ROMSEL_ANDY : STA bank_now : STA romsel
    LDA docked : BNE no_dots
    JSR ground_dots
.no_dots
    JMP lists
}

\ sight_blit (&05598): the d0 the gunsight's blit leaves, when the sight
\ is inside the window (each edge by the N flag of a word difference).
.sight_blit
{
    LDA sight_x : SEC : SBC #LO(VIEW_XMIN) : LDA sight_x+1 : SBC #HI(VIEW_XMIN) : BMI outside
    LDA sight_x : SEC : SBC #LO(VIEW_XMAX) : LDA sight_x+1 : SBC #HI(VIEW_XMAX) : BPL outside
    LDA sight_y : SEC : SBC #LO(VIEW_YMIN) : LDA sight_y+1 : SBC #HI(VIEW_YMIN) : BMI outside
    LDA sight_y : SEC : SBC #LO(VIEW_YMAX) : LDA sight_y+1 : SBC #HI(VIEW_YMAX) : BPL outside
    LDA sight_x : SEC : SBC #14 : AND #15 : BEQ outside
    TAX
    LDA sight_d0_lo,X : STA rng_d0
    LDA sight_d0_hi,X : STA rng_d0+1
.outside
    RTS
}

\ missile_lists (L_05248): the window opens 8 lines a step after the
\ launch and closes over the view's last 15 steps; while it moves the
\ lists stay as they were. Otherwise they are made from the missile: its
\ place and angles stand in for the player's while they are made.
.missile_lists
{
    ZA_AUTO 12, keep                    ; the player's place and angles
    \ closing while the life is under 15 (the N flag of life - 15)
    LDA m_life : SEC : SBC #&0F : LDA m_life+1 : SBC #0 : BPL steady
    LDA m_iris : CLC : ADC #8 : STA m_iris
    RTS
.steady
    LDA m_iris : BEQ counting
    SEC : SBC #8 : STA m_iris
    BEQ open
    RTS
.counting
    \ open since before this step: the countdown shows (&05296)
    LDA #TX_COUNT : TSB world_text
.open
    LDA m_heading : STA m_idx : LDA m_heading+1 : AND #&0F : STA m_idx+1
    JSR sincos
    MOVW trig_sin, m_sin : MOVW trig_cos, m_cos
    LDX #11
    ZA_DISCARD keep
.copy
    LDA pl_x,X : STA keep,X : ZA_INDEXEDBY 0..11
    LDA m_x,X : STA pl_x,X
    DEX : BPL copy
    LDA #BANK_WORLD : STA bank_now : STA romsel
    JSR camera
    LDA #BANK_WORLD OR ROMSEL_ANDY : STA bank_now : STA romsel
    \ d0 is the window's step, 0 here (&053BC)
    STZ rng_d0 : STZ rng_d0+1
    JSR ground_dots
    JSR lists
    LDX #11
.back
    LDA keep,X : ZA_INDEXEDBY 0..11
    STA pl_x,X
    DEX : BPL back
    RTS
}

\ ---------------------------------------------------------------------------
\ ground_dots (&047AA): each of the 40 dots rotated into camera space by
\ the camera's matrix; one outside the view's cone (z <= 2, or x or y
\ beyond +-2z) is put back at random ahead of the camera. The cone decides
\ the random numbers, so it is the ST's decision exactly, made as decision
\ 11 makes the objects' rotation: approximately first, and exactly only for
\ a dot within the approximation's bound of the cone's edges. The
\ approximation is the drawing's (build/gen/ground.6502, within 4 of the
\ ST's on each axis), made for the frame's camera here, so that what's
\ rotated here the drawing needn't rotate again. A dot found surely in view
\ keeps that decision, unrotated, until the camera has moved enough since
\ to bring it to an edge (dot_drift, dot_keep's margin). The ST plots
\ each dot in view as it goes: the drawing (view_under.6502's dots_draw)
\ is told which, in dot_seen, with the camera-space place of each rotated
\ here (dot_cx and on).
.ground_dots
{
    ZA_AUTO1 dot, sines, shift
    LDA #&FF : STA dots_ran
    JSR dot_setup
    STZ sines
    STZ shift
    LDX #0
.each
    \ (each dot's tests make these before they read them, on the paths
    \ the carry and A choose, which baron can't follow: without this it
    \ keeps them from one dot to the next, and so from step to step)
    ZA_DISCARD rot_acc, dot_mu
    \ still surely in view: kept, where it was kept, and its margin not yet
    \ spent by the drift since
    LDA dot_rem_hi,X : BMI unkept
    LDY dot_cls,X
    LDA dot_rem_lo,X : SEC : SBC dot_drift_lo,Y : STA dot_rem_lo,X
    LDA dot_rem_hi,X : SBC dot_drift_hi,Y : STA dot_rem_hi,X : BMI spent
    LDA dot_x_lo,X : CMP dot_at_xlo,X : BNE spent
    LDA dot_x_hi,X : CMP dot_at_xhi,X : BNE spent
    LDA dot_z_lo,X : CMP dot_at_zlo,X : BNE spent
    LDA dot_z_hi,X : CMP dot_at_zhi,X : BNE spent
    LDA #DOT_KEPT : STA dot_seen,X
    STA shift                           ; (d0 the projection's shift, before it's read)
    INX : CPX #40 : BNE each
    JMP shifted
.spent
    LDA #&FF : STA dot_rem_hi,X         ; (no longer kept)
.unkept
    STX dot
    LDA dot_x_lo,X : SEC : SBC pl_x : STA rot_d
    LDA dot_x_hi,X : SBC pl_x+1 : STA rot_d+1
    LDA dot_z_lo,X : SEC : SBC pl_z : STA rot_d+4
    LDA dot_z_hi,X : SBC pl_z+1 : STA rot_d+5
    JSR dot_rotate : BCS exactly
    JSR dot_classify : BEQ keep
    CMP #1 : BEQ outside
.exactly
    LDA #BANK_WORLD : STA bank_now : STA romsel
    JSR rotate_exact
    LDA #BANK_WORLD OR ROMSEL_ANDY : STA bank_now : STA romsel
    JSR cone_exact : BCS outside
    LDA #DOT_EXACT
    BRA rotated
.keep
    LDX dot
    JSR dot_keep
    LDA #DOT_GROUND
.rotated
    \ where it is in camera space, for the drawing
    LDX dot
    STA dot_seen,X
    LDA rot_acc : STA dot_cx_lo,X : LDA rot_acc+1 : STA dot_cx_hi,X
    LDA rot_acc+2 : STA dot_cy_lo,X : LDA rot_acc+3 : STA dot_cy_hi,X
    LDA rot_acc+4 : STA dot_cz_lo,X : LDA rot_acc+5 : STA dot_cz_hi,X
    \ projected: d0 takes the projection's shift (&0480A), made so before
    \ it's next read
    LDA #&FF : STA shift
    BRA next
.outside
    LDX dot : STZ dot_seen,X
    LDA sines : BNE placed
    INC sines
    JSR respawn_sines
.placed
    JSR shifted
    LDX dot
    JSR respawn
.next
    LDX dot : INX : CPX #40 : BEQ ended
    JMP each
.ended
\ shifted: d0 the projection's shift if a dot was projected since it was
\ last made.
.shifted
    LDA shift : BEQ unshifted
    LDA #PROJ_SHIFT : STA rng_d0 : STZ rng_d0+1
    STZ shift
.unshifted
    RTS
}

\ dot_keep: dot X, surely in view with margin dot_mu (the least that z' -
\ 3, 2z' - |x'|, 2z' - |y'| and 16383 - z' can be), is kept if |dx| + |dy|
\ + |dz| is at most 16384: in the class c that bounds the sum by 1024 c for
\ as long as the margin lasts, which is what the class's drift is for. A
\ step's move takes at least a third of its drift (dot_drift), so while
\ the margin lasts the camera moves less than mu / 3 and the sum grows by
\ less; mu / 2 stands in for that.
.dot_keep
{
    ZA_AUTO2 v
    \ v = |dx| + |dy| + |dz| (dx and dz each under 16128)
    LDA rot_d+1 : BPL dx_pos
    LDA #0 : SEC : SBC rot_d : STA v
    LDA #0 : SBC rot_d+1 : STA v+1
    BRA dz
.dx_pos
    STA v+1 : LDA rot_d : STA v
.dz
    LDA rot_d+5 : BPL dz_pos
    LDA v : SEC : SBC rot_d+4 : STA v
    LDA v+1 : SBC rot_d+5 : STA v+1
    BRA dy
.dz_pos
    LDA v : CLC : ADC rot_d+4 : STA v
    LDA v+1 : ADC rot_d+5 : STA v+1
.dy
    LDA v : CLC : ADC dot_dy : STA v
    LDA v+1 : ADC dot_dy+1 : BCS far
    STA v+1
    \ at most 16384, or not kept
    LDA v : CMP #LO(16385) : LDA v+1 : SBC #HI(16385) : BCS far
    \ the class: (v + 1 + mu / 2, rounded up) / 1024, rounded up
    LDA dot_mu+1 : LSR A : TAY
    LDA dot_mu : ROR A                  ; (C: mu's bit 0, which rounds up)
    ADC v : STA v
    TYA : ADC v+1 : STA v+1
    LDA v : CLC : ADC #LO(1 + 1023) : LDA v+1 : ADC #HI(1 + 1023)
    LSR A : LSR A
    STA dot_cls,X
    LDA dot_mu : STA dot_rem_lo,X : LDA dot_mu+1 : STA dot_rem_hi,X
    LDA dot_x_lo,X : STA dot_at_xlo,X : LDA dot_x_hi,X : STA dot_at_xhi,X
    LDA dot_z_lo,X : STA dot_at_zlo,X : LDA dot_z_hi,X : STA dot_at_zhi,X
.far
    RTS
}

\ dot_setup: what the dots take from the frame. The ground's offset from
\ the camera, dy, is the same for every dot (and goes in rot_d for both
\ rotations); the drift since the last frame's dots, by class; and the
\ ground's rotation, made again for the frame's camera and dy unless
\ they're the last frame's, whose bound holds only while the entries of
\ its x and z columns are within 16384.
ZA_AUTO2 dot_mu                         ; a dot's margin, from dot_classify
ZA_AUTO2 dot_dy                         ; |dy|, the frame's
.dot_setup
{
    LDA #0 : SEC : SBC pl_y : STA rot_d+2 : STA dot_dy
    LDA #0 : SBC pl_y+1 : STA rot_d+3 : STA dot_dy+1
    BPL dy_pos
    LDA #0 : SEC : SBC dot_dy : STA dot_dy : LDA #0 : SBC dot_dy+1 : STA dot_dy+1
.dy_pos
    \ beyond 16384: below &C000, or above &4000 (any entry for the drift,
    \ the x and z columns' for the rotation)
    STZ dot_wide : STZ dot_wide_any
    LDX #16
.entries
    LDA cam+1,X : ZA_INDEXEDBY {0, 2, 4, 6, 8, 10, 12, 14, 16}
    BPL m_pos
    CMP #&C0 : BCS m_in
    BCC m_wide
.m_pos
    CMP #&40 : BCC m_in
    BNE m_wide
    LDA cam,X : ZA_INDEXEDBY {0, 2, 4, 6, 8, 10, 12, 14, 16}
    BEQ m_in
.m_wide
    LDA #&FF : STA dot_wide_any
    CPX #2 : BEQ m_in
    CPX #8 : BEQ m_in
    CPX #14 : BEQ m_in
    STA dot_wide
.m_in
    DEX : DEX : BPL entries
    JSR dot_drift
    BIT dot_same : BMI made
    JMP ground_make
.made
    RTS
}

\ dot_rotate: rot_acc = the dot's camera-space position by the ground's
\ rotation, from rot_d, within DOT_B of the ST's on each axis (each term of
\ the x and z columns within 2, as tools/groundcheck.py checks for every m
\ and d, and the ground column's the ST's); C set if it can't be bounded
\ (an offset of 16128 or more, or an entry beyond 16384).
DOT_B = 4
.dot_rotate
{
    BIT dot_wide : BMI far
    LDA rot_d+1 : CLC : ADC #&3F : CMP #&7E : BCS far
    LDA rot_d+5 : CLC : ADC #&3F : CMP #&7E : BCS far
    JSR ground_rows
    CLC : RTS
.far
    SEC : RTS
}

\ dot_drift: by class, the most a frame since the last frame's dots can
\ have moved 2z' - x', 2z' + x', 2z' - y', 2z' + y', z' or -z' of a dot
\ whose |dx| + |dy| + |dz| stays within L = 1024 c: the camera's move, dp
\ (|dx| + |dy| + |dz|), by at most 3 dp (and dp more when an entry is
\ beyond 16384); the matrix's change by at most r L / 16384, r the most
\ that any column's 2 |dz'| and the larger of |dx'| and |dy'| make (no
\ test's row combination changes by more in that column); and each term's
\ floor by under 1: 3 dp + r L / 16384 + 9. Without a last frame in the
\ same view, or with too much moved, nothing is kept. The frame's camera
\ is kept for the next.
DOT_CLASSES = 25                        ; (dot_keep's: 1 to 24, from v and mu under 16384)
.dot_drift
{
    ZA_AUTO2 dp, t
    ZA_AUTO 4, br                       ; base, then r
    base = br
    r = br + 2
    ZA_AUTO1 still
    STZ dot_same
    STZ still
    LDA dot_valid : BNE known
.forget
    LDX #39
    LDA #&FF
.forgot
    STA dot_rem_hi,X
    DEX : BPL forgot
    STA dot_made+1                      ; (no base is that: the drift's made again)
    JMP keep_camera
.known
    LDA mv_render : CMP dot_mv_was : BNE forget
    \ the matrix the last frame's: no entry moved
    LDX #17
.holding
    LDA cam,X : ZA_INDEXEDBY 0..17
    CMP dot_cam_was,X : BNE turned
    DEX : BPL holding
    DEC still
    STZ r : STZ r+1
    LDA pl_y : CMP dot_p_was+2 : BNE climbed
    LDA pl_y+1 : CMP dot_p_was+3 : BNE climbed
    LDA #&FF : STA dot_same
.climbed
    JMP moves
.turned
    \ each entry's change
    STZ dot_moved
    LDX #16
.entries
    LDA cam,X : ZA_INDEXEDBY {0, 2, 4, 6, 8, 10, 12, 14, 16}
    SEC : SBC dot_cam_was,X : STA t
    LDA cam+1,X : ZA_INDEXEDBY {0, 2, 4, 6, 8, 10, 12, 14, 16}
    SBC dot_cam_was+1,X
    BPL moved_pos
    STA t+1 : LDA #0 : SEC : SBC t : STA t : LDA #0 : SBC t+1
.moved_pos
    CMP #&20 : BCS forget               ; 8192 up
    STA dot_dm+1,X
    LDA t : STA dot_dm,X
    ORA dot_dm+1,X : TSB dot_moved
    DEX : DEX : BPL entries
    \ the ground's rotation stands if no entry moved and dy is the same
    LDA dot_moved : BNE rot_moved
    LDA pl_y : CMP dot_p_was+2 : BNE rot_moved
    LDA pl_y+1 : CMP dot_p_was+3 : BNE rot_moved
    LDA #&FF : STA dot_same
.rot_moved
    \ r, under 24576, by column (X its entry in row x')
    STZ r : STZ r+1
    LDX #4
.columns
    LDA dot_dm+12,X : ASL A : STA t
    LDA dot_dm+13,X : ROL A : STA t+1
    LDA dot_dm,X : CMP dot_dm+6,X : LDA dot_dm+1,X : SBC dot_dm+7,X
    TXA : BCS x_more
    ADC #6                              ; (C clear) the entry in row y'
.x_more
    TAY
    LDA t : CLC : ADC dot_dm,Y : STA t
    LDA t+1 : ADC dot_dm+1,Y : STA t+1
    LDA t : CMP r : LDA t+1 : SBC r+1 : BCC not_most
    MOVW r, t
.not_most
    DEX : DEX : BPL columns
.moves
    \ dp, each of its terms under 4096
    STZ dp : STZ dp+1
    LDX #4
.axes
    LDA pl_x,X : SEC : SBC dot_p_was,X : STA t
    LDA pl_x+1,X : SBC dot_p_was+1,X
    BPL step_pos
    STA t+1 : LDA #0 : SEC : SBC t : STA t : LDA #0 : SBC t+1
.step_pos
    CMP #&10 : BCC step_in
    JMP forget
.step_in
    STA t+1
    ADDW dp, t
    DEX : DEX : BPL axes
    \ base = 3 dp + 9 (+ dp if wide)
    LDA dp : ASL A : STA base : LDA dp+1 : ROL A : STA base+1
    ADDW base, dp
    LDA dot_wide_any : BEQ narrow
    ADDW base, dp
.narrow
    LDA base : CLC : ADC #9 : STA base
    BCC based
    INC base+1
.based
    \ class c's, base + c r16, r16 = r / 16 rounded up (which is r 1024 /
    \ 16384), each held at &7FFF
    LDA r : CLC : ADC #15 : STA r
    BCC r_up
    INC r+1
.r_up
    LSR r+1 : ROR r : LSR r+1 : ROR r
    LSR r+1 : ROR r : LSR r+1 : ROR r
    \ the last frame's classes stand if base and r16 are the same (the
    \ camera flying straight and steady)
    LDX #3
.same
    LDA br,X : ZA_INDEXEDBY 0..3
    CMP dot_made,X : BNE make
    DEX : BPL same
    BRA keep_camera
.make
    LDX #3
.making
    LDA br,X : ZA_INDEXEDBY 0..3
    STA dot_made,X
    DEX : BPL making
    MOVW t, base
    LDX #1
.classes
    LDA t+1 : BMI held                  ; (and so for every class past it)
    LDA t : CLC : ADC r : STA t
    LDA t+1 : ADC r+1 : STA t+1         ; (under &8600: no carry)
    BMI held
    STA dot_drift_hi,X
    LDA t : STA dot_drift_lo,X
    BRA classed
.held
    LDA #&FF : STA dot_drift_lo,X
    LDA #&7F : STA dot_drift_hi,X
.classed
    INX : CPX #DOT_CLASSES : BNE classes
.keep_camera
    LDA still : BNE kept_camera         ; (the same already)
    LDX #17
.cam_copy
    LDA cam,X : ZA_INDEXEDBY 0..17
    STA dot_cam_was,X
    DEX : BPL cam_copy
.kept_camera
    LDX #5
.place
    LDA pl_x,X : STA dot_p_was,X
    DEX : BPL place
    LDA mv_render : STA dot_mv_was
    LDA #1 : STA dot_valid
    RTS
}

\ dot_classify: from dot_rotate's rot_acc, A = 0 (and Z) if the dot is
\ surely in view, with dot_mu its margin; 1 if surely outside; 2 if too
\ near an edge to say. z' is within DOT_B of z~, and 2z' - |x'| and 2z' -
\ |y'| within DOT_K of 2z~ - |x~| and 2z~ - |y~|. hi = z~ + DOT_B bounds
\ z' above, and with z' under 16384 neither 2z' nor x' and y' (within the
\ bounds of the offsets dot_rotate takes, and the height's) can wrap.
DOT_K = 3 * DOT_B
.dot_classify
{
    ZA_AUTO2 hi, t2, lo
    ZA_AUTO 4, u                        ; ux, uy
    ux = u
    uy = u + 2
    LDA rot_acc+4 : CLC : ADC #DOT_B : STA hi
    LDA rot_acc+5 : ADC #0 : STA hi+1
    BMI outside                         ; z' below 0
    BNE z_pos
    LDA hi : CMP #3 : BCS z_pos         ; (z' 2 or less: outside)
.outside
    LDA #1 : RTS
.unsure
    LDA #2 : RTS
.z_pos
    LDA hi+1 : CMP #&40 : BCS unsure
    LDA rot_acc+4 : ASL A : STA t2 : LDA rot_acc+5 : ROL A : STA t2+1
    \ ux = 2z~ - DOT_K - |x~|, uy the same for y: both 0 or more, in view
    \ if z' is surely above 2
    ZA_DISCARD u
    LDX #0 : JSR margin
    LDX #2 : JSR margin
    LDA ux+1 : ORA uy+1 : BMI not_in
    LDA rot_acc+4 : SEC : SBC #DOT_B + 3 : STA lo
    LDA rot_acc+5 : SBC #0 : STA lo+1
    BMI unsure
    \ the margin: the least of lo, ux, uy and 16383 - hi
    LDA #LO(16383) : SEC : SBC hi : STA dot_mu
    LDA #HI(16383) : SBC hi+1 : STA dot_mu+1
    LDA lo : CMP dot_mu : LDA lo+1 : SBC dot_mu+1 : BCS mu1
    MOVW dot_mu, lo
.mu1
    LDA ux : CMP dot_mu : LDA ux+1 : SBC dot_mu+1 : BCS mu2
    MOVW dot_mu, ux
.mu2
    LDA uy : CMP dot_mu : LDA uy+1 : SBC dot_mu+1 : BCS mu3
    MOVW dot_mu, uy
.mu3
    LDA #0 : RTS
.not_in
    \ outside if |v~| > 2z~ + DOT_K, that is u + 2 DOT_K < 0, for x or y
    \ (asked only of a u below 0)
    LDA ux+1 : BPL x_near
    LDA ux : CLC : ADC #2 * DOT_K : LDA ux+1 : ADC #0 : BMI out
.x_near
    LDA uy+1 : BPL y_near
    LDA uy : CLC : ADC #2 * DOT_K : LDA uy+1 : ADC #0 : BMI out
.y_near
    LDA #2 : RTS
.out
    LDA #1 : RTS
\ margin: u = t2 - DOT_K - |v~| for x~ (X = 0) or y~ (X = 2).
.margin
    LDA rot_acc+1,X : ZA_INDEXEDBY {0, 2}
    BMI v_neg
    LDA t2 : SEC : SBC rot_acc,X : ZA_INDEXEDBY {0, 2}
    TAY
    LDA t2+1 : SBC rot_acc+1,X : ZA_INDEXEDBY {0, 2}
    BRA less_k
.v_neg
    LDA t2 : CLC : ADC rot_acc,X : ZA_INDEXEDBY {0, 2}
    TAY
    LDA t2+1 : ADC rot_acc+1,X : ZA_INDEXEDBY {0, 2}
.less_k
    STA u+1,X : ZA_INDEXEDBY {0, 2}
    TYA : SEC : SBC #DOT_K
    STA u,X : ZA_INDEXEDBY {0, 2}
    BCS done
    DEC u+1,X : ZA_INDEXEDBY {0, 2}
.done
    RTS
}


\ cone_exact (&047DC): the ST's test on the exact rot_acc, its words
\ wrapping: C set if the dot is outside.
.cone_exact
{
    ZA_AUTO2 t2, n2
    CMPS16 rot_acc+4, #3 : BMI outside            ; z <= 2
    LDA rot_acc+4 : ASL A : STA t2 : LDA rot_acc+5 : ROL A : STA t2+1
    LDA #0 : SEC : SBC t2 : STA n2 : LDA #0 : SBC t2+1 : STA n2+1
    CMPS16 rot_acc, n2 : BMI outside
    CMPS16 t2, rot_acc : BMI outside
    CMPS16 rot_acc+2, n2 : BMI outside
    CMPS16 t2, rot_acc+2 : BMI outside
    CLC : RTS
.outside
    SEC : RTS
}

\ respawn_sines: the sines a respawn turns by, the heading's (the
\ missile's while it flies, as &048C4 has it), into trig_sin and trig_cos.
\ The view's camera took the same unless the missile flies without its
\ view, which the ST never does.
.respawn_sines
{
    LDA missile_view : CMP mv_render : BEQ same
    LDA missile_view : BEQ player
    LDA m_heading : STA m_idx : LDA m_heading+1
    BRA got
.player
    LDA pl_heading : STA m_idx : LDA pl_heading+1
.got
    AND #&0F : STA m_idx+1
    JSR sincos
    MOVW trig_sin, m_sin : MOVW trig_cos, m_cos
.same
    RTS
}

\ respawn (&0484E): dot X at random ahead: along = random8 & &1FFF,
\ across = (random8 & &1FFF) - &1000, each random8 adding d0 as it stands
\ (and leaving its result there), turned by the heading's sines onto the
\ player's place (the missile's while it flies).
.respawn
{
    ZA_AUTO2 along, across, nx, nz
    ZA_AUTO1 dot
    STX dot
    JSR random8
    LDA rng_d0+1 : AND #&1F : STA rng_d0+1
    MOVW along, rng_d0
    JSR random8
    LDA rng_d0+1 : AND #&1F : SEC : SBC #&10 : STA rng_d0+1
    MOVW across, rng_d0
    MOVW mul_x, across : MOVW mul_y, trig_cos : JSR fmul16 : MOVW nx, mul_r
    MOVW mul_x, along : MOVW mul_y, trig_sin : JSR fmul16 : ADDW nx, mul_r
    MOVW mul_x, along : MOVW mul_y, trig_cos : JSR fmul16 : MOVW nz, mul_r
    MOVW mul_x, across : MOVW mul_y, trig_sin : JSR fmul16 : SUBW nz, mul_r
    LDA missile_view : BEQ player
    ADDW nx, m_x
    ADDW nz, m_z
    BRA store
.player
    ADDW nx, pl_x
    ADDW nz, pl_z
.store
    LDX dot
    LDA nx : STA dot_x_lo,X : LDA nx+1 : STA dot_x_hi,X
    LDA nz : STA dot_z_lo,X : LDA nz+1 : STA dot_z_hi,X
    RTS
}

\ ---------------------------------------------------------------------------
\ lists (&0561C, &057B8): the launch's count or the docked tunnel's
\ stop, refill and pick-up, then the coarse list and the draw lists.
.lists
{
    \ launching: launch_state neither 0 nor &1E
    LDA launch_state+1 : BNE launching
    LDA launch_state : BEQ not_launching
    CMP #&1E : BEQ not_launching
.launching
    \ LAUNCHING FROM SILO (&0562E): a step of the count, colour 0 a
    \ random word, five off the speed accumulator and effect 3; then the
    \ normal coarse list, even docked
    LDA #TX_LAUNCH : TSB world_text
    LDA launch_state : BNE count_lo
    DEC launch_state+1
.count_lo
    DEC launch_state
    JSR random32
    MOVW flash0, rng_d0
    LDA speed_acc : CLC : ADC #5 : STA speed_acc
    BCC sped
    INC speed_acc+1
.sped
    LDA #3 : LDX #1
    JSR sfx_start
    LDA docked : PHA
    STZ docked
    JSR make_lists
    PLA : STA docked
    RTS
.not_launching
    LDA docked : BEQ open
    JSR tunnel
    LDX docked_silo : LDA ob_timer_a_hi,X : STA silo_missile
.open
    \ (fall into make_lists)
}
.make_lists
    LDA #BANK_WORLD : STA bank_now : STA romsel
    JSR coarse_list
    JSR rotate_lists
    LDA #BANK_WORLD OR ROMSEL_ANDY : STA bank_now : STA romsel
    RTS

\ tunnel (&05672): docked, the tunnel's end (the silo's z less the
\ player's, by the N flag of that less &C8) stops the speed and refills the
\ laser by &190 a step, until it would carry (at once with the cheat_mode): then
\ it's full, the launch may start and the docking speech is said on a
\ step whose frame count's low byte is 0. Then the silo's missile is taken
\ when within -&28 to &28 of the player, if the silo has one and the
\ player has room.
.tunnel
{
    ZA_AUTO2 dz
    LDX docked_silo
    LDA ob_z_lo,X : SEC : SBC pl_z : STA dz
    LDA ob_z_hi,X : SBC pl_z+1 : STA dz+1
    LDA dz : SEC : SBC #&C8 : LDA dz+1 : SBC #0 : BPL pick_up
    STZ speed_acc : STZ speed_acc+1
    LDA cheat_mode : BNE full
    LDA laser_energy : CLC : ADC #&90 : TAY
    LDA laser_energy+1 : ADC #&01 : BCC energy
.full
    LDA #&1E : STA launch_state : STZ launch_state+1
    \ the docking speech, if none is playing, on a frame count's low byte 0
    LDA sample_left : ORA sample_left+1 : ORA sample_left+2 : ORA sample_left+3 : BNE quiet
    LDA frame_count : BNE quiet
    LDA #SAMPLE_DOCKED : STA sample_clip
    LDA #LO(&1D00) : STA sample_len : LDA #HI(&1D00) : STA sample_len+1
    JSR speech
.quiet
    LDA #&FF : TAY
.energy
    STY laser_energy : STA laser_energy+1
.pick_up
    LDA missiles : CMP #2 : BEQ done
    LDA ob_z_lo + SLOT_MISSILE : SEC : SBC pl_z : STA dz
    LDA ob_z_hi + SLOT_MISSILE : SBC pl_z+1 : STA dz+1
    LDA dz : SEC : SBC #&28 : LDA dz+1 : SBC #0 : BPL done
    LDA dz : CLC : ADC #&28 : LDA dz+1 : ADC #0 : BMI done
    LDX docked_silo
    LDA ob_timer_a_hi,X : BEQ done
    INC missiles
    STZ ob_timer_a_hi,X
    LDA #&D0 : STA ob_timer_b_lo,X : LDA #&07 : STA ob_timer_b_hi,X
    LDA #&40 : STA flash0 : STZ flash0+1
.done
    RTS
}

\ world_whole: the two halves together, as the harness checks the missile
\ view (it has no lists point).
IF DEFINED(SPIKE)
.world_whole
    JSR world_lists
    LDA #LO(world_after) : STA logic_vec : LDA #HI(world_after) : STA logic_vec+1
    JMP logic_bank_call
ENDIF

\ ---------------------------------------------------------------------------
\ The dots' cache (ground_dots), in the world bank's own RAM: the last
\ dots' frame's camera, place and view; by dot its margin (negative: not
\ kept), class and place when kept; and this frame's drift by class, from
\ each entry's change in the matrix.
.dot_valid    EQUB 0                    ; non-zero once dot_cam_was holds a frame's
.dot_mv_was   EQUB 0
.dot_same     SKIP 1                    ; bit 7: the camera and dy the last frame's
.dot_moved    SKIP 1                    ; non-zero if an entry moved since the last frame
.dot_wide     SKIP 1                    ; bit 7: an entry in the x or z column beyond 16384
.dot_wide_any SKIP 1                    ; non-zero: any entry beyond 16384
.dot_cam_was  SKIP 18
.dot_p_was    SKIP 6
.dot_dm       SKIP 18
.dot_made     EQUW 0, &FFFF             ; the base and r16 the drift was made from (none yet)
.dot_drift_lo SKIP DOT_CLASSES
.dot_drift_hi SKIP DOT_CLASSES
.dot_rem_lo   SKIP 40
.dot_rem_hi   SKIP 40
.dot_cls      SKIP 40
.dot_at_xlo   SKIP 40
.dot_at_xhi   SKIP 40
.dot_at_zlo   SKIP 40
.dot_at_zhi   SKIP 40
