\ ***************************************************************************
\ STARGLIDER for the BBC Master - the object handlers (the ST's &07A54)
\
\ Each slot the level uses, in order: an exploding object's countdown, its
\ slot pushed on the free stack at the end; any other object's handler by
\ its type, through the ST's table (&08252, which tools/mkhandlers.py
\ reads). Exactly the ST's (docs/research/st-logic.md, "The object
\ handlers"): each compare the N flag of a wrapped difference where the
\ ST's is, each heading's add unmasked where the ST's is, each random
\ number the ST's draws. rng_d0 follows the ST's d0 through every
\ handler, as a mine's random8 adds whatever the slots before it left.
\
\ In the world's bank, for the sine table; ANDY paged. A handler takes its
\ slot from h_slot into X, may take Y, and after any call reloads X from
\ h_slot. What the ST draws or prints here (the enemies' laser lines, the
\ mines' warnings) is the drawing's, and isn't here: the laser lines are
\ recorded for it (enemy_laser).
\ ***************************************************************************

ZA_AUTO1 h_slot             ; the slot being handled
ZA_AUTO2 h_bear             ; angle_to_player's bearing (the ST's d1)
ZA_AUTO2 h_t                ; a word's working

\ HADDX lo, hi, n: the word at lo,X and hi,X plus the constant n.
MACRO HADDX lo, hi, n
    LDA lo,X : CLC : ADC #LO(n) : STA lo,X
    LDA hi,X : ADC #HI(n) : STA hi,X
ENDMACRO

\ HDECX lo, hi: the word at lo,X and hi,X less 1.
MACRO HDECX lo, hi
    LDA lo,X : BNE low
    DEC hi,X
.low
    DEC lo,X
ENDMACRO

\ The ST's tables (tools/mkhandlers.py), with the macros angle_to_player's
\ lookup takes
INCLUDE "../../build/gen/handlers.6502"

\ h_random32: random32 (random.6502) on h_rng, a copy of its state in zero
\ page, for object_handlers' many calls a step (it copies rng32 in and
\ out). Only the handlers call it, so it's here in their bank, not with
\ random32 in main RAM.
ZA_AUTO 4, h_rng
.h_random32
{
    ASL h_rng : ROL h_rng+1 : ROL h_rng+2 : ROL h_rng+3
    BCS flip
    BNE kept                    ; (the top byte isn't 0, so nor is the long)
    LDA h_rng : ORA h_rng+1 : ORA h_rng+2 : BNE kept
.flip
    \ (half the calls: each byte's EOR on its way to the adds)
    LDA h_rng : EOR #&41 : CLC : ADC mouse_x : STA h_rng
    LDA h_rng+1 : EOR #&2B : ADC mouse_x+1 : STA h_rng+1
    LDA h_rng : CLC : ADC rng_lag+3 : STA h_rng
    LDA h_rng+1 : ADC rng_lag+2 : STA h_rng+1
    LDA h_rng+2 : EOR #&87 : ADC rng_lag+1 : STA h_rng+2 : STA rng_d0
    LDA h_rng+3 : EOR #&1D : ADC rng_lag : STA h_rng+3 : STA rng_d0+1
    RTS
.kept
    LDA h_rng : CLC : ADC mouse_x : STA h_rng
    LDA h_rng+1 : ADC mouse_x+1 : STA h_rng+1
    LDA h_rng : CLC : ADC rng_lag+3 : STA h_rng
    LDA h_rng+1 : ADC rng_lag+2 : STA h_rng+1
    LDA h_rng+2 : ADC rng_lag+1 : STA h_rng+2 : STA rng_d0
    LDA h_rng+3 : ADC rng_lag : STA h_rng+3 : STA rng_d0+1
    RTS
}

\ The handler by type is handler_gate's (tools/mkhandlers.py): none for
\ the types whose handler does nothing (type 0's among them), and where
\ the handler's first test is the draw list's flag or the near list's,
\ that's tested here, as it costs most of the slots nothing. The ST
\ clears the homing request ($2D6) after every slot; here the handlers
\ that make one clear it, so only one there at the start is cleared here,
\ after the first slot (whose handler sees it, as the ST's does). random32's
\ state is in zero page meanwhile (h_random32).
\
\ The walk stops at the slot past its last (the table has one past the
\ ST's last, as the silo's records follow), made to look exploding until
\ then, so that only an exploding slot tests for the end; no handler reads
\ another slot's exploding.
.object_handlers
{
    ZA_AUTO1 limit                      ; the slot the walk stops at
    ZA_AUTO1 kept                       ; that slot's own exploding
    LDX #0
    LDA n_slots : BEQ done
    LDY homing : BEQ all
    LDA #1
.all
    STA limit
    LDA rng32 : STA h_rng : LDA rng32+1 : STA h_rng+1
    LDA rng32+2 : STA h_rng+2 : LDA rng32+3 : STA h_rng+3
.walk
    LDY limit
    LDA ob_exploding,Y : STA kept
    LDA #1 : STA ob_exploding,Y
    BRA each
.next
    INX
.each
    LDA ob_exploding,X : BNE exploding
    LDY ob_type,X
    LDA handler_gate,Y : BEQ next
    BIT #GATE_DRAWN OR GATE_NEAR : BNE gated
.call
    STX h_slot
    TAX
    JSR handler_dispatch
    LDX h_slot
    INX
    BRA each
.exploding
    CPX limit : BEQ walked
    \ frames 0-31, then the slot is freed (beq on &1F: equality)
    LDA ob_explosion,X : CMP #&1F : BEQ free
    INC ob_explosion,X
    BRA next
.walked
    LDA kept : STA ob_exploding,X
    STZ homing
    CPX n_slots : BNE rest
    LDA h_rng : STA rng32 : LDA h_rng+1 : STA rng32+1
    LDA h_rng+2 : STA rng32+2 : LDA h_rng+3 : STA rng32+3
.done
    RTS
.rest
    LDA n_slots : STA limit
    BRA walk
.gated
    \ (N is still the gate's bit 7: BIT # sets Z alone)
    BMI drawn
    LDY ob_near,X
    BRA listed
.drawn
    LDY ob_drawn,X
.listed
    BEQ next
    AND #&FF EOR (GATE_DRAWN OR GATE_NEAR)
    BRA call
.free
    STZ ob_exploding,X : STZ ob_explosion,X : STZ ob_type,X
    TXA : LDY free_n : STA free_stack,Y
    INC free_n
    BRA next
}

\ handler_dispatch: object_handlers' call of the handler X names
\ (handler_gate's number, in handler_tab)
.handler_dispatch
    JMP (handler_tab - 2,X)
    ZA_CANJUMP HANDLERS

\ HMOVE, h_move: on by the velocity, in x and z (in line for the
\ commonest movers).
MACRO HMOVE
    LDA ob_x_lo,X : CLC : ADC ob_vx_lo,X : STA ob_x_lo,X
    LDA ob_x_hi,X : ADC ob_vx_hi,X : STA ob_x_hi,X
    LDA ob_z_lo,X : CLC : ADC ob_vz_lo,X : STA ob_z_lo,X
    LDA ob_z_hi,X : ADC ob_vz_hi,X : STA ob_z_hi,X
ENDMACRO
.h_move
    HMOVE
    RTS

\ ---------------------------------------------------------------------------
\ h_silo (&07AAE): it turns, and counts &7D0 down to -1 (bpl: 0 still
\ counts) to a missile: +14's byte, the word's high byte here.
.h_silo
{
    LDX h_slot
    HADDX ob_heading_lo, ob_heading_hi, &10
    HDECX ob_timer_b_lo, ob_timer_b_hi
    LDA ob_timer_b_hi,X : BPL done
    LDA #LO(&7D0) : STA ob_timer_b_lo,X
    LDA #HI(&7D0) : STA ob_timer_b_hi,X
    LDA #&FF : STA ob_timer_a_hi,X
.done
    RTS
}

\ ---------------------------------------------------------------------------
\ h_mine (&07AC6): drawn and within &800 ahead (the N flags of z - &F800
\ and z - &800, each constant's low byte 0) it warns or goes off
\ (collide.6502's mine_proximity, in the logic's bank); then it spins and
\ bobs, the pyramid (type 2 alone) turning back at each end of its bob,
\ the others pitching on to a half turn first.
.h_mine
{
    LDX h_slot
    LDA ob_drawn,X : BEQ motion
    LDA ob_cz_hi,X : CMP #&F8 : BMI motion
    CMP #&08 : BPL motion
    LDA #LO(mine_proximity) : STA logic_vec : LDA #HI(mine_proximity) : STA logic_vec+1
    JSR logic_bank_call
    LDX h_slot
.motion
    LDA ob_heading_lo,X : SEC : SBC #&40 : STA ob_heading_lo,X
    BCS spun
    DEC ob_heading_hi,X
.spun
    LDA ob_timer_b_lo,X : STA rng_d0 : CLC : ADC ob_y_lo,X : STA ob_y_lo,X
    LDA ob_timer_b_hi,X : STA rng_d0+1 : ADC ob_y_hi,X : STA ob_y_hi,X
    LDA ob_timer_a_lo,X : ORA ob_timer_a_hi,X : BEQ still
    HDECX ob_timer_a_lo, ob_timer_a_hi
    LDA ob_timer_a_lo,X : ORA ob_timer_a_hi,X : BNE done
    LDA ob_type,X : CMP #2 : BEQ reverse
.pitch
    HADDX ob_pitch_lo, ob_pitch_hi, &40
.done
    RTS
.still
    \ at the bob's end: pitching on while the pitch isn't a half turn
    LDA ob_pitch_lo,X : STA rng_d0
    LDA ob_pitch_hi,X : AND #&07 : STA rng_d0+1
    ORA rng_d0 : BNE pitch
.reverse
    LDA ob_timer_c_lo,X : STA ob_timer_a_lo,X
    LDA ob_timer_c_hi,X : STA ob_timer_a_hi,X
    LDA #0 : SEC : SBC ob_timer_b_lo,X : STA ob_timer_b_lo,X
    LDA #0 : SBC ob_timer_b_hi,X : STA ob_timer_b_hi,X
    RTS
}

\ ---------------------------------------------------------------------------
\ near_test (&07C0A, &080E0): C set if near: dx - &3E8's N flag set and
\ dx - &FC18's clear; or both set and dz between the same two. The z test
\ runs only when dx < -1000, as the ST's does.
.near_test
{
    ZA_AUTO1 d                          ; (each difference's high byte; its low in Y)
    LDA ob_x_lo,X : SEC : SBC pl_x : TAY
    LDA ob_x_hi,X : SBC pl_x+1 : STA d
    CPY #LO(&3E8) : SBC #HI(&3E8) : BPL far
    CPY #LO(&FC18) : LDA d : SBC #HI(&FC18) : BPL near
    LDA ob_z_lo,X : SEC : SBC pl_z : TAY
    LDA ob_z_hi,X : SBC pl_z+1 : STA d
    CPY #LO(&3E8) : SBC #HI(&3E8) : BPL far
    CPY #LO(&FC18) : LDA d : SBC #HI(&FC18) : BMI far
.near
    SEC
    RTS
.far
    CLC
    RTS
}

\ ---------------------------------------------------------------------------
\ h_fighter (&07BF4): on unless frozen; then, near, StarGlider One (27
\ alone) fires 1 in 64, else turns 3 in 4 or asks for a homing missile;
\ the others fire 1 in 128, else aim 1 in 8 or turn; far, any fires 1 in
\ 128, else turns 1 in 32 or aims 1 in 16, else nothing. Each test is on
\ the one number (frozen fighters still turn and fire).
.h_fighter
{
    LDX h_slot
    LDA enemies_active : BEQ moved
    HMOVE
.moved
    JSR near_test : BCC far
    LDA ob_type,X : CMP #27 : BNE near
    JSR h_random32
    LDA rng_d0 : AND #&3F : BEQ laser
    AND #3 : BNE turn
    LDA #&FF : STA homing
    JSR aim
    STZ homing
    RTS
.to_aim
    JMP aim
.near
    JSR h_random32
    LDA rng_d0 : AND #&7F : BEQ laser
    AND #7 : BEQ to_aim
.turn
    JMP turn_to_player
.far
    JSR h_random32
    LDA rng_d0 : AND #&7F : BEQ laser
    LDA rng_d0 : AND #&1F : BEQ turn
    AND #&0F : BEQ to_aim
    RTS
.laser
    JMP enemy_laser
}

\ aim (&07C98): the bearing, and a missile if the heading is near it.
.aim
    JSR angle_to_player
    LDX h_slot
    LDA h_bear+1 : AND #&0F : STA h_bear+1
    \ (on into try_missile)

\ try_missile (&07EDC): a missile if |h_bear - heading & &FFF| < &50,
\ with no wrap at 0.
.try_missile
{
    LDA ob_heading_lo,X : STA rng_d0
    LDA ob_heading_hi,X : AND #&0F : STA rng_d0+1
    LDA h_bear : SEC : SBC rng_d0 : STA h_t
    LDA h_bear+1 : SBC rng_d0+1 : STA h_t+1
    BPL apart
    NEGW h_t
.apart
    LDA h_t : CMP #&50 : LDA h_t+1 : SBC #0 : BMI launch
    RTS
}

\ launch (&07EF2): a missile from the free stack, if there is one, the
\ launcher is near, the player isn't docked and the enemies aren't frozen.
\ Type 25 if a homing one was asked for, but never on level 1, else 24. It
\ takes the launcher's place and angles, its gun's height, its heading
\ turned half round for the types &08354 marks, the level's speed and
\ life. What it doesn't set, the slot keeps from the object it last held.
.launch
{
    ZA_AUTO1 kind, new
    LDA free_n : BEQ done
    LDA ob_near,X : BEQ done
    LDA docked : BNE done
    LDA enemies_active : BNE go
.done
    RTS
.go
    DEC free_n
    LDY free_n : LDA free_stack,Y : STA new : TAY
    LDA ob_type,X : STA kind
    ASL A : STA rng_d0 : STZ rng_d0+1           ; (the ST's d0: the type * 2)
    LDA homing : BEQ plain
    LDA level+1 : BNE homes
    LDA level : CMP #1 : BEQ plain
.homes
    LDA #25 : BRA typed
.plain
    LDA #24
.typed
    STA ob_type,Y
    LDA #1 : STA ob_flags,Y
    LDA ob_x_lo,X : STA ob_x_lo,Y : LDA ob_x_hi,X : STA ob_x_hi,Y
    LDA ob_z_lo,X : STA ob_z_lo,Y : LDA ob_z_hi,X : STA ob_z_hi,Y
    LDA ob_pitch_lo,X : STA ob_pitch_lo,Y : LDA ob_pitch_hi,X : STA ob_pitch_hi,Y
    LDA ob_roll_lo,X : STA ob_roll_lo,Y : LDA ob_roll_hi,X : STA ob_roll_hi,Y
    LDA ob_y_lo,X : STA h_t : LDA ob_y_hi,X : STA h_t+1
    LDA ob_heading_lo,X : STA ob_heading_lo,Y
    LDA ob_heading_hi,X
    LDX kind
    SEC : SBC missile_flip,X : AND #&0F : STA ob_heading_hi,Y
    LDA h_t : CLC : ADC gun_y_lo,X : STA ob_y_lo,Y
    LDA h_t+1 : ADC gun_y_hi,X : STA ob_y_hi,Y
    LDX level
    LDA missile_speed_lo,X : STA ob_speed_lo,Y
    LDA missile_speed_hi,X : STA ob_speed_hi,Y
    LDA missile_life,X : STA ob_timer_a_lo,Y
    LDA #0 : STA ob_timer_a_hi,Y
    STA ob_hits_lo,Y : STA ob_hits_hi,Y
    LDX new
    JSR set_velocity
    LDX h_slot
    RTS
}

\ turn_to_player (&07D2A): a sixteenth of the way round to the bearing.
.turn_to_player
    JSR angle_to_player
    LDX h_slot
    LDA h_bear+1 : AND #&0F : STA h_bear+1
    \ (on into turn_step)

\ turn_step (&07D32): the heading masked (and kept so), then turned by
\ (h_bear - it) asr 4, which floors and never takes the short way across
\ 0; then the velocity. rng_d0 is the masked heading, as the ST's d0.
.turn_step
    JSR turn_by
    \ (on into set_velocity)

\ set_velocity (&07D46): the velocity by the heading and speed, as the
\ 68000's muls, asl.l #1, swap: vx = -(floor(speed sin / 32768)), vz =
\ floor(speed cos / 32768), vy 0 (the map's zero). Its sine and cosine
\ are left in trig_sin and trig_cos, as the ST leaves them.
.set_velocity
{
    ZA_AUTO1 at
    STX at
    LDA ob_heading_lo,X : STA m_idx
    LDA ob_heading_hi,X : AND #&0F : STA m_idx+1
    JSR sincos
    MOVW trig_sin, m_sin : MOVW trig_cos, m_cos
    LDX at
    \ |speed|: its high byte for vel_part, its low byte the products'
    \ multiplicand
    LDA ob_speed_lo,X : STA vel_part.speed
    LDA ob_speed_hi,X : STA vel_part.speed+1 : BPL s_pos
    LDA #0 : SEC : SBC vel_part.speed : TAY
    LDA #0 : SBC vel_part.speed+1 : STA vel_part.ahi
    TYA
    BRA s_abs
.s_pos
    STA vel_part.ahi
    LDA vel_part.speed
.s_abs
    MUL_SET
    MOVW vel_part.y, m_sin
    JSR vel_part
    LDX at
    LDA #0 : SEC : SBC vel_part.r : STA ob_vx_lo,X
    LDA #0 : SBC vel_part.r+1 : STA ob_vx_hi,X
    MOVW vel_part.y, m_cos
    JSR vel_part
    LDX at
    LDA vel_part.r : STA ob_vz_lo,X : LDA vel_part.r+1 : STA ob_vz_hi,X
    RTS
}

\ vel_part: r = floor(speed y / 32768), as muls, asl.l #1, swap make it,
\ for y a sine (|y| <= 16384). |speed| below 512 (ahi, its high byte, 0
\ or 1) takes the products of its low byte (MUL_SET) with |y|'s bytes, a
\ product P of 23 bits at most, signed after; any other, fmul15.
.vel_part
{
    ZA_AUTO2 speed, y, r
    ZA_AUTO1 ahi, neg, p0, p1, p2, t
    LDA ahi : CMP #2 : BCC small
    MOVW mul_x, speed : MOVW mul_y, y
    JSR fmul15
    MOVW r, mul_r
    RTS
.small
    LDA y+1 : EOR speed+1 : STA neg
    LDA y+1 : BPL y_pos
    NEGW y
.y_pos
    LDY y : MUL8 p0 : STA p1
    LDY y+1 : MUL8 t : STA p2
    LDA p1 : CLC : ADC t : STA p1
    BCC carried
    INC p2
.carried
    LDA ahi : BEQ low
    LDA p1 : CLC : ADC y : STA p1
    LDA p2 : ADC y+1 : STA p2
.low
    \ P >> 15; for a negative product, its negation less 1 if P's low 15
    \ bits aren't all 0 (the floor)
    LDA p1 : ASL A : LDA p2 : ROL A
    BIT neg : BMI negative
    STA r : STZ r+1
    RTS
.negative
    STA t
    LDA p1 : AND #&7F : ORA p0 : STA p0
    LDA #0 : SEC : SBC p0               ; (C: P's low 15 bits all 0)
    LDA #0 : SBC t : STA r
    LDA #0 : SBC #0 : STA r+1
    RTS
}

\ turn_by: the heading = h0 + (h_bear - h0) asr 4, h0 the heading masked
\ (kept in the heading and rng_d0).
.turn_by
{
    LDA ob_heading_lo,X : STA rng_d0
    LDA ob_heading_hi,X : AND #&0F : STA rng_d0+1
    \ (h_bear is 0-&FFF too, so the difference's top four bits are its
    \ sign's, and asr 4 leaves its sign above bits 4-11)
    LDA h_bear : SEC : SBC rng_d0 : STA h_t
    LDA h_bear+1 : SBC rng_d0+1
    LDY #0 : CMP #&80 : BCC up
    DEY
.up
    ASL A : ASL A : ASL A : ASL A : STA h_t+1
    LDA h_t : LSR A : LSR A : LSR A : LSR A : ORA h_t+1
    CLC : ADC rng_d0 : STA ob_heading_lo,X
    TYA : ADC rng_d0+1 : STA ob_heading_hi,X
    RTS
}

\ ---------------------------------------------------------------------------
\ h_wanderer (&07CA4): nothing while frozen; on, and 1 in 64 it turns by
\ -16 to 15 (a second number), else 1 in 16 of the rest it fires.
.h_wanderer
{
    LDA enemies_active : BEQ done
    LDX h_slot
    HMOVE
    JSR h_random32
    STZ rng_d0+1
    LDA rng_d0 : AND #&3F : STA rng_d0 : BEQ turn
    AND #&0F : STA rng_d0 : BEQ laser
.done
    RTS
.laser
    JMP enemy_laser
.turn
    JSR h_random32
    LDA rng_d0 : AND #&1F : SEC : SBC #&10 : STA rng_d0
    LDA #0 : SBC #0 : STA rng_d0+1
    LDA ob_heading_lo,X : CLC : ADC rng_d0 : STA ob_heading_lo,X
    LDA ob_heading_hi,X : ADC rng_d0+1 : STA ob_heading_hi,X
    JMP set_velocity
}

\ ---------------------------------------------------------------------------
\ h_neutron (&07D8E): on, an eighth of the way to the player's height (the
\ wrapped difference, asr), spinning, until its life is out (ble on the
\ count less 1). It doesn't heed the freeze.
.h_neutron
{
    LDX h_slot
    JSR h_move
    LDA pl_y : SEC : SBC ob_y_lo,X : STA rng_d0
    LDA pl_y+1 : SBC ob_y_hi,X : STA rng_d0+1
    ASRW rng_d0 : ASRW rng_d0 : ASRW rng_d0
    JSR climb_spin
    JSR life : BCS missile_explode
    RTS
}

\ climb_spin: the height on by rng_d0, the roll by &40.
.climb_spin
    LDA ob_y_lo,X : CLC : ADC rng_d0 : STA ob_y_lo,X
    LDA ob_y_hi,X : ADC rng_d0+1 : STA ob_y_hi,X
    HADDX ob_roll_lo, ob_roll_hi, &40
    RTS

\ life: the count at +14 less 1; C set if subq.w #1 then ble would take
\ the branch, which is when the count was 1 or less (its overflow at
\ -32768 included).
.life
{
    LDA ob_timer_a_hi,X : BMI out
    BNE living
    LDA ob_timer_a_lo,X : CMP #2 : BCC out
.living
    HDECX ob_timer_a_lo, ob_timer_a_hi
    CLC
    RTS
.out
    HDECX ob_timer_a_lo, ob_timer_a_hi
    SEC
    RTS
}

\ missile_explode (&07DBC): set off, unless it already is.
.missile_explode
{
    LDA ob_exploding,X : BNE done
    LDA #&FF : STA ob_exploding,X : STZ ob_explosion,X
.done
    RTS
}

\ h_homing (&07DD2): as the neutron missile, a quarter of the way to the
\ player's height, and off too above -1700 (y - &F95C's N flag); then it
\ faces the player again, heading half round from the bearing.
.h_homing
{
    LDX h_slot
    JSR h_move
    LDA pl_y : SEC : SBC ob_y_lo,X : STA rng_d0
    LDA pl_y+1 : SBC ob_y_hi,X : STA rng_d0+1
    ASRW rng_d0 : ASRW rng_d0
    JSR climb_spin
    JSR life : BCS missile_explode
    LDA ob_y_lo,X : CMP #LO(&F95C) : LDA ob_y_hi,X : SBC #HI(&F95C) : BMI missile_explode
    JSR angle_to_player
    LDX h_slot
    LDA h_bear : STA ob_heading_lo,X
    LDA h_bear+1 : SEC : SBC #&08 : AND #&0F : STA ob_heading_hi,X
    JMP set_velocity
}

\ ---------------------------------------------------------------------------
\ enemy_laser (&07E18): if it's drawn and the player is neither docked nor
\ in the missile view, the shields lose 100 on level 1, else the type's
\ (the same for all). At camera z 0 that's all; otherwise the line to
\ the view's bottom edge takes a random number for its end, and there's a
\ flash, a sound and a hit counted. The ST draws the line here: the
\ drawing (view.6502's shots_draw) is given it, the gun's camera-space
\ place (the type's gun height on y) and the end's x ((the number & &7F)
\ + &60), up to SHOTS a step.
.enemy_laser
{
    ZA_AUTO2 damage
    LDA ob_drawn,X : BEQ done
    LDA docked : BNE done
    LDA missile_view : BNE done
    LDA ob_type,X : ASL A : STA rng_d0 : STZ rng_d0+1
    LDA #LO(LASER_DAMAGE) : STA damage : LDA #HI(LASER_DAMAGE) : STA damage+1
    LDA level+1 : BNE hurt
    LDA level : CMP #1 : BNE hurt
    LDA #100 : STA damage : STZ damage+1
.hurt
    LDA shields : SEC : SBC damage : STA shields
    LDA shields+1 : SBC damage+1 : STA shields+1
    BCS shielded
    STZ shields : STZ shields+1
.shielded
    LDA ob_cz_lo,X : ORA ob_cz_hi,X : BEQ done
    JSR h_random32
    JSR shot_record
    LDA #LO(&20) : STA flash0 : LDA #HI(&20) : STA flash0+1
    LDA #0 : LDX #1
    JSR sfx_start
    STZ rng_d0 : STZ rng_d0+1
    INC hits_taken : BNE done
    INC hits_taken+1 : BNE done
    INC hits_taken+2 : BNE done
    INC hits_taken+3
.done
    RTS
}

\ shot_record: slot X's shot, its end from the number random32 left, for
\ the drawing (view.6502's shots_draw), unless SHOTS are kept already.
.shot_record
{
    LDY shot_n : CPY #SHOTS : BCS full
    LDA rng_d0 : AND #&7F : CLC : ADC #&60 : STA shot_end,Y
    LDA ob_cx_lo,X : STA shot_x_lo,Y : LDA ob_cx_hi,X : STA shot_x_hi,Y
    LDA ob_cz_lo,X : STA shot_z_lo,Y : LDA ob_cz_hi,X : STA shot_z_hi,Y
    LDA ob_cy_lo,X : STA shot_y_lo,Y : LDA ob_cy_hi,X : STA shot_y_hi,Y
    LDA ob_type,X : TAX
    LDA shot_y_lo,Y : CLC : ADC gun_y_lo,X : STA shot_y_lo,Y
    LDA shot_y_hi,Y : ADC gun_y_hi,X : STA shot_y_hi,Y
    INC shot_n
.full
    RTS
}

\ ---------------------------------------------------------------------------
\ h_tank (&080D8): nothing while frozen. Near, one number: 1 in 128 it
\ asks for a homing missile, and 1 in 4 it aims, else it turns. Far, it
\ turns on the spot by &20 a step to the next quarter, then drives for 100
\ steps, aiming 1 in 16 of them.
.h_tank
{
    LDA enemies_active : BNE on
.done
    RTS
.on
    LDX h_slot
    JSR near_test : BCC far
    JSR h_random32
    STZ rng_d0+1
    LDA rng_d0 : AND #&7F : STA rng_d0 : BNE asked
    LDA #&FF : STA homing           ; (the number's low bits 0 too: it aims)
    JSR aim
    STZ homing
    RTS
.asked
    LDA rng_d0 : AND #3 : STA rng_d0 : BEQ to_aim
    JSR angle_to_player
    LDX h_slot
    LDA h_bear+1 : AND #&0F : STA h_bear+1
    JMP turn_step
.to_aim
    JMP aim
.far
    LDA ob_timer_b_lo,X : ORA ob_timer_b_hi,X : BNE drive
    HADDX ob_heading_lo, ob_heading_hi, &20
    LDA ob_heading_lo,X : STA rng_d0
    LDA ob_heading_hi,X : AND #&03 : STA rng_d0+1
    ORA rng_d0 : BNE turned
    LDA #100 : STA ob_timer_b_lo,X : STZ ob_timer_b_hi,X
.turned
    JMP set_velocity
.drive
    JSR h_move
    HDECX ob_timer_b_lo, ob_timer_b_hi
    JSR h_random32
    STZ rng_d0+1
    LDA rng_d0 : AND #&0F : STA rng_d0 : BEQ to_aim
    RTS
}

\ ---------------------------------------------------------------------------
\ The handlers object_handlers calls only for an object in the near list
\ (GATE_NEAR) or the draw list (GATE_DRAWN), the ST's first test in each.
\
\ h_juno (&08174): near, 1 in 8 a missile (never homing: nothing asks),
\ unaligned; else a sixteenth of the way round to face half round from
\ the bearing. Its freeze is the launch's alone.
.h_juno
{
    LDX h_slot
    JSR h_random32
    STZ rng_d0+1
    LDA rng_d0 : AND #7 : STA rng_d0 : BEQ launch_now
    JSR angle_to_player
    LDX h_slot
    LDA h_bear+1 : SEC : SBC #&08 : AND #&0F : STA h_bear+1
    JSR turn_by
    LDA ob_heading_lo,X : STA rng_d0                ; (the ST's d0: the heading)
    LDA ob_heading_hi,X : STA rng_d0+1
    RTS
.launch_now
    JMP launch
}

\ h_pyramid (&081AA): near and not on level 1, it spins, and 1 in 16 asks
\ for a homing missile, unaligned.
.h_pyramid
{
    LDA level+1 : BNE spin
    LDA level : CMP #1 : BEQ done
.spin
    LDX h_slot
    LDA ob_heading_lo,X : SEC : SBC #&40 : STA ob_heading_lo,X
    BCS spun
    DEC ob_heading_hi,X
.spun
    JSR h_random32
    STZ rng_d0+1
    LDA rng_d0 : AND #&0F : STA rng_d0 : BNE done
    LDA #&FF : STA homing
    JSR launch
    STZ homing
.done
    RTS
}

\ h_old_pyramid (&081D6, type 57 alone, which no code makes): near, it
\ spins, and 1 in 8 aims as the tri-launcher does.
.h_old_pyramid
{
    LDX h_slot
    LDA ob_heading_lo,X : SEC : SBC #&40 : STA ob_heading_lo,X
    BCS spun
    DEC ob_heading_hi,X
.spun
    JSR h_random32
    STZ rng_d0+1
    LDA rng_d0 : AND #7 : STA rng_d0 : BEQ to_aim
    RTS
.to_aim
    JMP h_tri.aim
}

\ h_tri (&081F4): near, it spins; and while the player carries a missile
\ it aims, its missiles heading half round from the bearing.
.h_tri
{
    LDX h_slot
    LDA ob_heading_lo,X : SEC : SBC #&60 : STA ob_heading_lo,X
    BCS aim
    DEC ob_heading_hi,X
.aim
    LDA missiles : ORA missiles+1 : BEQ done
    JSR angle_to_player
    LDX h_slot
    LDA h_bear+1 : SEC : SBC #&08 : AND #&0F : STA h_bear+1
    JMP try_missile
.done
    RTS
}

\ h_type3 (&0821A): drawn, it fires 1 in 32, frozen or not.
.h_type3
{
    LDX h_slot
    JSR h_random32
    STZ rng_d0+1
    LDA rng_d0 : AND #&1F : STA rng_d0 : BEQ laser
    RTS
.laser
    JMP enemy_laser
}

\ h_beam (&08232): from level 3 (level - 3's N flag), wherever it is, 1 in
\ 2048 it goes out: its type 0, its slot not freed.
.h_beam
{
    LDA level : CMP #3 : LDA level+1 : SBC #0 : BMI done
    JSR h_random32
    LDA rng_d0+1 : AND #&07 : STA rng_d0+1
    ORA rng_d0 : BNE done
    LDX h_slot
    STZ ob_type,X
.done
    RTS
}

\ ---------------------------------------------------------------------------
\ angle_to_player (&08390): h_bear = the ST's bearing from the player to
\ the object, T - base: base &C00 for dx >= 0, &400 for dx < 0, and T from
\ table A by q = dz / dx when |dz| >= |dx| (the signed compare of the
\ neg.w values, so -32768 stays least), else table B by q = (dz << 8) /
\ dx; q clamped by the N flags of q - &FF and q - &FF01, else the table's
\ entry (q + &FF) & &1FF (one below its centre, as the ST's). divs by 0
\ (EmuTOS's vector 5 is an rte) or overflowing leaves the dividend, whose
\ low word is then q. rng_d0 is dx, as the ST's d0.
\
\ With neither dx nor dz -32768 and dx not 0, |q| is |dz| / |dx| (table A,
\ at least 1) or (|dz| << 8) / |dx| (table B, below 256): from 256 up it
\ isn't made, as the clamp is decided by then (q - &FF's N flag is clear
\ again only from -32514 down). The rest go the ST's way (slow).
.angle_to_player
{
    ZA_AUTO2 dx, dz, r, q
    ZA_AUTO1 base, neg, n
    ZA_AUTO1 top                        ; the clamp's high byte: &4 table A, &2 table B
    LDA ob_x_lo,X : SEC : SBC pl_x : STA dx : STA rng_d0
    LDA ob_x_hi,X : SBC pl_x+1 : STA dx+1 : STA rng_d0+1
    LDA ob_z_lo,X : SEC : SBC pl_z : STA dz
    LDA ob_z_hi,X : SBC pl_z+1 : STA dz+1
    EOR dx+1 : STA neg                  ; (bit 7: q's sign, if it isn't 0)
    LDA #HI(&C00) : BIT dx+1 : BPL based
    LDA #HI(&400)
.based
    STA base
    LDA dx : BNE dx_fits
    LDA dx+1 : BNE dx_some
    JMP dx_zero
.dx_some
    CMP #&80 : BNE dx_fits
    JMP dx_least
.dx_fits
    LDA dz : BNE dz_fits
    LDA dz+1 : CMP #&80 : BNE dz_fits
    JMP dz_least
.dz_fits
    LDA dx+1 : BPL dx_pos
    NEGW dx
.dx_pos
    LDA dz+1 : BPL dz_pos
    NEGW dz
.dz_pos
    LDA dz : CMP dx : LDA dz+1 : SBC dx+1 : BCC path_b
    LDA #HI(&400) : STA top
    \ |q| from 256 (|dz| >> 8 >= |dx|) is clamped: to the top if q is
    \ positive or -32514 and below (|dx| 1), else to the bottom
    LDA dz+1 : CMP dx : LDA #0 : SBC dx+1 : BCC a_divide
    BIT neg : BPL clamp_top
    LDA dx+1 : BNE clamp_bottom
    LDA dx : CMP #1 : BNE clamp_bottom
    LDA dz : CMP #LO(32514) : LDA dz+1 : SBC #HI(32514) : BCS clamp_top
    BRA clamp_bottom
.a_divide
    LDA dz : STA n
    LDA dz+1 : STA r
    LDA #0
    BRA divide
.path_b
    LDA #HI(&200) : STA top
    STZ n
    LDA dz : STA r
    LDA dz+1
.divide
    \ n's 8 bits of quotient, from the remainder (r, A) below |dx|: each
    \ step rotates the last bit (C) into n and n's top into the remainder
    LDY #8
.step
    ROL n : ROL r : ROL A
    CMP dx+1 : BCC zero : BNE one
    LDX r : CPX dx : BCC zero
.one
    TAX : LDA r : SBC dx : STA r : TXA : SBC dx+1
.zero
    DEY : BNE step
    ROL n
    LDA n
    BIT neg : BMI minus
    CMP #&FF : BEQ clamp_top
    CMP #0 : BNE plus
    BRA minus
.clamp_bottom
    LDA #0 : SEC : SBC top
    BRA clamped
.clamp_top
    LDA top
.clamped
    \ the clamps' constants have low bytes 0
    STZ h_bear
.based_off
    SEC : SBC base : STA h_bear+1
    RTS

\ The entry, by top's table
.plus
    \ q = A, from 1: entry 256 + q - 1, which H keeps as itself
    TAY
    LDX top : CPX #HI(&200) : BEQ plus_b
    LDA atan_a_lo - 1,Y : STA h_bear
    ATAN_A_HI_PLUS
    BRA based_off
.plus_b
    LDA atan_b_lo - 1,Y : STA h_bear
    ATAN_B_HI_PLUS
    BRA based_off
.minus
    \ q = -A, or 0: entry 256 - (A + 1), which H keeps negated
    TAY
    LDX top : CPX #HI(&200) : BEQ minus_b
    ATAN_A_HI_MINUS : TAX
    LDA #0 : SEC : SBC atan_a_lo + 1,Y
    BRA minus_hi
.minus_b
    ATAN_B_HI_MINUS : TAX
    LDA #0 : SEC : SBC atan_b_lo + 1,Y
.minus_hi
    STA h_bear
    TXA : EOR #&FF : ADC #0             ; (C: no borrow, the low byte 0)
    BRA based_off

\ The ST's way: dx 0 divides by 0, leaving q dz in table A (dz -32768
\ takes table B, by the low word of dz << 8, 0); dx -32768 takes table A,
\ by 1 for dz -32768, else 0; dz -32768 otherwise takes table B, by divs.
.dx_zero
    LDA dz : BNE by_dz
    LDA dz+1 : CMP #&80 : BNE by_dz
.b_zero
    LDA #HI(&200) : STA top
    LDA #0 : BRA to_minus
.by_dz
    LDA #HI(&400) : STA top
    MOVW q, dz
    BRA clamp
.dx_least
    LDA #HI(&400) : STA top
    LDA dz : BNE a_zero
    LDA dz+1 : CMP #&80 : BNE a_zero
    LDA #1 : BRA to_plus
.a_zero
    LDA #0 : BRA to_minus
.dz_least
    LDA #HI(&200) : STA top
    STZ mul_p : STZ mul_p+1
    LDA #&80 : STA mul_p+2 : LDA #&FF : STA mul_p+3
    MOVW div_d, dx
    JSR sdiv32 : BCS b_zero
    MOVW q, div_q
.clamp
    LDA q : CMP #&FF : LDA q+1 : SBC #0 : BMI not_top
    JMP clamp_top
.not_top
    LDA q : CMP #&01 : LDA q+1 : SBC #&FF : BPL in_range
    JMP clamp_bottom
.in_range
    \ q from -255 to 254
    LDA q+1 : BMI q_minus
    LDA q : BEQ to_minus
.to_plus
    JMP plus
.q_minus
    LDA #0 : SEC : SBC q
.to_minus
    JMP minus
}
