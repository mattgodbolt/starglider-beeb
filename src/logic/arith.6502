\ ***************************************************************************
\ STARGLIDER for the BBC Master - the logic's arithmetic, in main RAM for
\ the logic in any bank (maths.6502 has the 68000's muls and divs)
\ ***************************************************************************

\ fmul15: mul_r = the 68000's `muls; asl.l #1; swap` of mul_x and mul_y:
\ floor(x * y / 32768), wrapped to 16 bits (a velocity from a speed and a
\ sine).
.fmul15
    JSR smul16
    ASL mul_p+1 : ROL mul_p+2 : ROL mul_p+3
    LDA mul_p+2 : STA mul_r
    LDA mul_p+3 : STA mul_r+1
    RTS

\ world_call: the world bank's routine at world_vec, from the logic's bank,
\ and back (ANDY stays paged).
.world_call
    LDA bank_now : PHA
    LDA #BANK_WORLD OR ROMSEL_ANDY : STA bank_now : STA romsel
    JSR world_jump
    PLA : STA bank_now : STA romsel
    RTS
.world_jump
    JMP (world_vec)
    ZA_CANJUMP sincos                           ; (every routine called this way)

\ logic_bank_call: the logic bank's routine at logic_vec, from the world bank,
\ and back (ANDY stays paged).
.logic_bank_call
    LDA bank_now : PHA
    LDA #BANK_LOGIC OR ROMSEL_ANDY : STA bank_now : STA romsel
    JSR logic_bank_jump
    PLA : STA bank_now : STA romsel
    RTS
.logic_bank_jump
    JMP (logic_vec)
    ZA_CANJUMP world_after, mine_proximity      ; (every routine called this way)

\ handler_dispatch (generated by tools/mkhandlers.py): object_handlers'
\ call of the handler at h_vec. In main RAM, as no bank's code shares its
\ address (baron matches an annotation to its jump by address alone:
\ waitingforvsync/baron#29, our #1), and with the handlers named one by one
\ in its ZA_CANJUMP: baron resolves a list symbol's labels only in the
\ annotation's own section (waitingforvsync/baron#30).
ZA_AUTO2 h_vec                      ; the handler object_handlers calls
INCLUDE "../../build/gen/dispatch.6502"
