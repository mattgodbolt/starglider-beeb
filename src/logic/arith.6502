\ ***************************************************************************
\ STARGLIDER for the BBC Master - the logic's arithmetic, in main RAM for
\ the logic in any bank (maths.6502 has the 68000's muls and divs)
\ ***************************************************************************

\ fmul15: mul_r = the 68000's `muls; asl.l #1; swap` of mul_x and mul_y:
\ floor(x * y / 32768), wrapped to 16 bits (a velocity from a speed and a
\ sine).
.fmul15
    JSR smul16
    ASL mul_p+1 : ROL mul_p+2 : ROL mul_p+3
    LDA mul_p+2 : STA mul_r
    LDA mul_p+3 : STA mul_r+1
    RTS

\ world_call: the world bank's routine at world_vec, from the logic's bank,
\ and back (ANDY stays paged).
.world_call
    LDA bank_now : PHA
    LDA #BANK_WORLD OR ROMSEL_ANDY : STA bank_now : STA romsel
    JSR world_jump
    PLA : STA bank_now : STA romsel
    RTS
.world_jump
    JMP (world_vec)
