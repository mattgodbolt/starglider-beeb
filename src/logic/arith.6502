\ ***************************************************************************
\ STARGLIDER for the BBC Master - the logic's calls between its banks, in
\ main RAM (maths.6502 has the 68000's muls and divs, which the logic in
\ any bank takes; fmul15, which only the world's bank takes, is there, in
\ flight.6502)
\ ***************************************************************************

\ world_call: the world bank's routine at world_vec, from the logic's bank,
\ and back (ANDY stays paged).
.world_call
    LDA bank_now : PHA
    LDA #BANK_WORLD OR ROMSEL_ANDY : STA bank_now : STA romsel
    JSR world_jump
    PLA : STA bank_now : STA romsel
    RTS
.world_jump
    JMP (world_vec)
    ZA_CANJUMP sincos                           ; (every routine called this way)

\ logic_bank_call: the logic bank's routine at logic_vec, from the world bank,
\ and back (ANDY stays paged).
.logic_bank_call
    LDA bank_now : PHA
    LDA #BANK_LOGIC OR ROMSEL_ANDY : STA bank_now : STA romsel
    JSR logic_bank_jump
    PLA : STA bank_now : STA romsel
    RTS
.logic_bank_jump
    JMP (logic_vec)
    ZA_CANJUMP world_after, mine_proximity, speech  ; (every routine called this way)
