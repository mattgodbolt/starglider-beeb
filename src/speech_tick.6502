\ ***************************************************************************
\ STARGLIDER for the BBC Master - the speech player (decision 5): its tick
\
\ In main RAM below &3000, run by the interrupt whichever bank is paged and
\ ANDY in or out. The clips run through three areas: bank 7's first 4K
\ (SPEECH_A), the logic bank's past the effects' tables (speech_b), and
\ bank 7's window section's tail (speech_c), so a byte is read with its
\ area's bank paged, ANDY out, and the bank put back (bank_now first, as
\ the disc's NMI routine expects). The player counts the ST's bytes left
\ (sample_left) down as the ST's Timer A does, three for each two
\ samples, and the clip ends at 0; past its last sample it holds the
\ level. Which sample is next is sp_next's branch, which each sets.
\
\ A tick can go on past an RTI: the part to follow pushes its address and
\ the flags, as an interrupt would, for the RTI to return to. So the
\ engine (irq_handler) takes the split, or whatever else waits, in the
\ middle of a tick, and a late tick follows its sample with those it owes.
\ ***************************************************************************

\ (The seldom paths first, within the branches' reach.)

\ sp_late: a late tick's (sp_behind's), after each sample it writes and
\ each turn of the engine's: T2's count, which has run on from the late
\ tick's due moment, against the next sample's (sp_due's), for the next
\ count, unless that moment is past too, or the clip has ended.
.sp_late
    LDA sample_left : ORA sample_left+1 : BEQ sp_late_out
.sp_again
    LDA usrvia_t2cl
    CMP #16 : BCC sp_again                      ; (a low byte about to wrap: until it has)
.sp_due_lo
    ADC #0                                      ; (sp_behind and sp_more set them)
    STA usrvia_t2cl                             ; the next count's low byte
    LDA usrvia_t2ch
.sp_due_hi
    ADC #0
    BMI sp_more
    STA usrvia_t2ch                             ; the next on time
.sp_late_out
    LDA &FC                                     ; the interrupted A, which the OS kept
    RTI
.sp_more
    \ that one's late too: the engine first, if the split is near or it has
    \ an interrupt waiting, then the sample, the next's moment a period on
    LDA usrvia_t1ch : BEQ sp_near
    BIT usrvia_ifr : BVS sp_yield
    BIT sysvia_ifr : BMI sp_yield
    LDA sp_due_lo + 1 : CLC : ADC #LO(SPEECH_PERIOD) : STA sp_due_lo + 1
    LDA sp_due_hi + 1 : ADC #HI(SPEECH_PERIOD) : STA sp_due_hi + 1
    BRA sp_owe
.sp_near
    \ (until its flag, or T1 past 0 without one, should it have been taken)
    BIT usrvia_ifr : BVS sp_yield
    LDA usrvia_t1ch : BEQ sp_near
    BRA sp_more
.sp_yield
    LDA #HI(sp_late) : PHA : LDA #LO(sp_late) : PHA : PHP
    JMP irq_handler

\ sp_behind: a tick a period late or more: its sample now, then those it
\ owes after it, at once (sp_late).
.sp_behind
    LDA #LO(SPEECH_PERIOD - SPEECH_LATE - 1) : STA sp_due_lo + 1
    LDA #HI(SPEECH_PERIOD - SPEECH_LATE - 1) : STA sp_due_hi + 1
.sp_owe
    LDA #HI(sp_late) : PHA : LDA #LO(sp_late) : PHA : PHP
    JMP sp_next

.sp_none
    \ past the clip's last sample: none, the level held
    LDA #LO(sp_first - sp_after) : STA sp_next + 1
    LDA &FC
    RTI
.sp_split
    \ the split near: its flag, then the engine, back to the count; or T1
    \ past 0 without one, should it have been taken
    BIT usrvia_ifr : BVS sp_split_first
    LDA usrvia_t1ch : BEQ sp_split
    BIT usrvia_ifr : BVS sp_split_first         ; (should it have come between)
    BRA sp_count
.sp_split_first
    LDA #HI(sp_count) : PHA : LDA #LO(sp_count) : PHA : PHP
.sp_engine
    JMP irq_handler

\ speech_irq: IRQ1V while a clip plays (sample_start sets it, the clip's
\ end puts irq_handler back), so that a tick needn't pass the engine's
\ tests: User VIA T2's interrupt alone is the speech's tick, and anything
\ else, the palette split's with it or not, the engine's (engine.6502).
\
\ Like sound_tick, a tick due within 256 microseconds of the palette split
\ lets the split go first, which it would hold up past its window. The
\ window is longer than a sample takes, and a late tick looks again before
\ each it owes, so no split comes during one. The tick starts the next
\ count, the period less what T2 has run on past 0 since this tick was
\ due, and writes its sample; a tick a period late or more writes its own
\ and those it owes, and starts the count to the next one due.
.speech_irq
    ZA_INTERRUPT
    LDA usrvia_ifr : AND #&60 : CMP #&20 : BNE sp_engine    ; (T2 is bit 5, T1 6)
    LDA usrvia_t1ch : BEQ sp_split              ; (its low byte read would acknowledge it)
.sp_count
    \ On time, the count's low byte is at least 256 less SPEECH_T2, too far
    \ from wrapping to change under the high byte's read; a late tick's
    \ count is read again (sp_late).
    LDA usrvia_t2cl                             ; acknowledged
    ADC #LO(SPEECH_T2 - 1)                      ; (C set by the test above)
    STA usrvia_t2cl                             ; the next count's low byte
    LDA usrvia_t2ch
    ADC #HI(SPEECH_T2 - 1)
    BMI sp_behind
    STA usrvia_t2ch                             ; (its high byte starts it)
.sp_next
    BRA sp_first                                ; (the next sample's: each sample sets it)
.sp_after
.sp_first
    \ a byte's first sample: the byte read, the sample written while the
    \ bank goes back, its second next; then the ST's three bytes for the
    \ two are counted
    LDA bank_now : PHA
.sp_bank
    LDA #BANK_PIC : STA bank_now : STA romsel   ; (its area's bank: speech_begin and sp_page set it)
.sp_at
    LDA SPEECH_A                                ; (the clip's next byte: likewise)
    CMP #SPEECH_END : BEQ sp_held
    STA sp_byte
    LSR A : LSR A : LSR A : LSR A : ORA #SN_TONE1 OR SN_VOL
    STA sysvia_ora_nh
    STZ sysvia_orb                              ; write enable low
    PLA : STA bank_now : STA romsel             ; (holding it low for the chip, as sn_write's wait)
    LDA #8 : STA sysvia_orb                     ; and high
    LDA #LO(sp_second - sp_after)
.sp_counted
    STA sp_next + 1
    LDA sample_left : SEC : SBC #3 : STA sample_left
    BCC sp_borrow
    LDA &FC
    RTI
.sp_held
    \ past the clip's last: none, and none next
    PLA : STA bank_now : STA romsel
    LDA #LO(sp_none - sp_after)
    BRA sp_counted
.sp_borrow
    LDA sample_left+1 : BEQ sp_ended
    DEC sample_left+1
    LDA &FC
    RTI

.sp_second
    \ a byte's second, written while the clip moves on, the next byte's
    \ first next
    LDA sp_byte : AND #15 : ORA #SN_TONE1 OR SN_VOL
    STA sysvia_ora_nh
    STZ sysvia_orb                              ; write enable low
    LDA #LO(sp_first - sp_after) : STA sp_next + 1
    INC sp_at + 1 : BEQ sp_page                 ; (likewise)
.sp_paged
    LDA #8 : STA sysvia_orb                     ; and high
    LDA &FC
    RTI
.sp_page
    \ the next page, or at the first two areas' end the next area's start:
    \ A's, in bank 7, goes on in B, in the logic bank, and B's in C, in bank 7
    INC sp_at + 2 : LDA sp_at + 2 : CMP #HI(ANDY_TOP) : BNE sp_paged
    LDA sp_bank + 1 : CMP #BANK_PIC : BNE sp_to_c
    LDA #BANK_LOGIC : STA sp_bank + 1
    LDA #LO(speech_b) : STA sp_at + 1
    LDA #HI(speech_b) : STA sp_at + 2
    BRA sp_paged
.sp_to_c
    LDA #BANK_PIC : STA sp_bank + 1
    LDA #LO(speech_c) : STA sp_at + 1
    LDA #HI(speech_c) : STA sp_at + 2
    BRA sp_paged

.sp_ended
    \ the clip's end: tone 1 silent, T2's interrupt off (its last count runs
    \ out unheeded), and the engine's interrupt back
    STZ sample_left : STZ sample_left+1
    LDA #&20 : STA usrvia_ier
    LDA #LO(irq_handler) : STA irq1v
    LDA #HI(irq_handler) : STA irq1v+1
    LDA #SN_TONE1 OR SN_VOL OR SN_OFF : JSR sn_write
    LDA &FC
    RTI
\ (sp_next's branch reaches each sample it's set to)
ASSERT sp_second - sp_after < 128 AND sp_after - sp_none <= 128
