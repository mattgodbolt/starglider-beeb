\ ***************************************************************************
\ STARGLIDER for the BBC Master - zero page and workspace
\
\ Fixed zero page is for what lasts or what the outside world reads and
\ writes (the frame's inputs; the products' pointers, whose high bytes are
\ set once). Everything else is baron's (ZA_AUTO, from the pool), placed by
\ when it's live. The workspace, in the OS's pages, holds the arrays, and
\ what the harness reads back.
\ ***************************************************************************

ZP_FIXED = &20
SECTION ZeroPage, org = &00, guard = ZP_FIXED, virtual = TRUE
    \ the products' pointers (maths.6502): mul_init sets the high bytes
.m_sqlo     SKIP 2
.m_sqhi     SKIP 2
.m_nglo     SKIP 2
.m_nghi     SKIP 2
    \ the frame's inputs, which the game (for now the scene harness) sets
.pl_x       SKIP 2          ; the player ($12E-$132(a6))
.pl_y       SKIP 2
.pl_z       SKIP 2
.pl_pitch   SKIP 2          ; ($13A-$13E)
.pl_heading SKIP 2
.pl_roll    SKIP 2
.n_slots    SKIP 1          ; the slots the coarse list looks at ($1D8)
.docked     SKIP 1          ; non-zero in the silo ($2CA)
.silo_missile SKIP 1        ; non-zero while the silo's missile is there
.all_faces  SKIP 1          ; &80: every face visible (the Interrogate screen's H, $2BD)
.beam_colour SKIP 1         ; the beam's colour, which animate_shapes cycles
.bank_now   SKIP 1          ; the sideways bank paged, as BANK pages it
ENDSECTION

ZA_POOL ZP_FIXED..&FF

\ The products (maths.6502)
ZA_AUTO2 mul_x, mul_y, mul_t, mul_r
ZA_AUTO 4, mul_p
ZA_AUTO1 mul_sign
ZA_AUTO2 div_d, div_u, div_q
ZA_AUTO 4, div_n

\ The renderer (render.6502): what crosses its routines
ZA_AUTO2 rec                ; the object's record
ZA_AUTO2 log_ptr            ; the next line in line_log
ZA_AUTO 18, cam             ; the camera's matrix: rows x', y', z' of words on x, y, z
ZA_AUTO 18, mat             ; the object's (build_matrix's)
ZA_AUTO 6, ang              ; build_matrix's pitch, heading and roll
ang_p = ang
ang_h = ang + 2
ang_r = ang + 4
ZA_AUTO1 slot, otype
ZA_AUTO2 tx, ty, tz         ; the object's camera-space position
\ the shape's header, as it lies: HDR_BYTES, then HDR_WORDS pointers
HDR_BYTES = 10
HDR_WORDS = 12
ZA_AUTO HDR_BYTES + HDR_WORDS * 2, sh
sh_nverts  = sh
sh_nedges  = sh + 1
sh_nfaces  = sh + 2
sh_colour  = sh + 3
sh_scale   = sh + 4
sh_nframes = sh + 5
sh_nstill  = sh + 6
sh_nrigid  = sh + 7
sh_radius  = sh + 8
sh_frames  = sh + 10
sh_ev0     = sh + 12
sh_ev1     = sh + 14
sh_fflags  = sh + 16
sh_fedges  = sh + 18
sh_elists  = sh + 20
sh_vx      = sh + 22
sh_vy      = sh + 24
sh_vz      = sh + 26
sh_nx      = sh + 28
sh_ny      = sh + 30
sh_nz      = sh + 32
\ the frame's arrays, each set back so it's indexed by vertex or face
ZA_AUTO2 fr_vx, fr_vy, fr_vz, fr_nx, fr_ny, fr_nz, fr_klo, fr_khi
ZA_AUTO 6, objc             ; the camera in the object's space
ZA_AUTO1 edge_i, va, vb
\ the window clip's points: four consecutive words, swapped as two pairs
ZA_AUTO 8, clip_pts
cx0 = clip_pts
cy0 = clip_pts + 2
cx1 = clip_pts + 4
cy1 = clip_pts + 6
ZA_AUTO2 px, pz, pq         ; project's and outcode's operands

\ The line drawer (line.6502)
ZA_AUTO2 line_x0, line_x1, line_scr, line_mx
ZA_AUTO1 line_y0, line_y1, line_my
ZA_AUTO1 line_dx, line_dy, line_cnt, line_ls, line_errs, line_err

WORK = &0400
SECTION Work, org = WORK, guard = &0E00, virtual = TRUE
    \ the lists: slot numbers, in the order pushed (render.6502)
.coarse_slots SKIP SLOTS + 2
.near_slots SKIP SLOTS + 2
.draw_slots SKIP SLOTS + 2
.coarse_n   SKIP 1
.near_n     SKIP 1
.draw_n     SKIP 1
.log_n      SKIP 2          ; lines in line_log
.mat_valid  SKIP 1          ; non-zero: mat is for mat_angles
.mat_angles SKIP 6
.ground_valid SKIP 1        ; non-zero: mat is ground_matrix's for ground_h
.ground_h   SKIP 2
.stamp      SKIP 1          ; the object's stamp on its edges and vertices
.rot_exact  SKIP SLOTS + 2  ; by slot: 1 if this frame's rotation was exact (decision 11)
    \ by shape and colour
.anim_frame SKIP 32         ; each shape's animation frame, as its list numbers them
.colour_map SKIP 16         ; the ST's colours to the screen's bytes (&00, &0F, &F0, &FF)
    \ the vertices and marks, by vertex and edge number
.edge_mark  SKIP 256
.vert_mark  SKIP 256
.v_xlo      SKIP 128
.v_xhi      SKIP 128
.v_ylo      SKIP 128
.v_yhi      SKIP 128
.v_zlo      SKIP 128
.v_zhi      SKIP 128
.v_sxlo     SKIP 128
.v_sxhi     SKIP 128
.v_sylo     SKIP 128
.v_syhi     SKIP 128
ENDSECTION

\ HAZEL, which the spike pages in (it makes no OS calls): the tables and
\ code (spike.6502).
TABLES = &C000
CODE2 = &D000

\ Every line drawn, for the harness (slot, edge, x0 (word), y0, x1 (word),
\ y1, colour), in a sideways bank of its own.
LOG = &8000
LOG_ENTRY = 9
LOG_LINES = 400
SECTION Log, org = LOG, guard = &C000, virtual = TRUE
.line_log   SKIP LOG_ENTRY * LOG_LINES
ENDSECTION
