\ ***************************************************************************
\ STARGLIDER for the BBC Master - zero page and workspace
\
\ Fixed zero page is for what lasts or what the outside world reads and
\ writes (the frame's inputs; the products' pointers, whose high bytes are
\ set once). Everything else is baron's (ZA_AUTO, from the pool), placed by
\ when it's live. The workspace, in the OS's pages, holds the arrays, and
\ what the harness reads back.
\ ***************************************************************************

ZP_FIXED = &20
SECTION ZeroPage, org = &00, guard = ZP_FIXED, virtual = TRUE
    \ the products' pointers (maths.6502): mul_init sets the high bytes
.m_sqlo     SKIP 2
.m_sqhi     SKIP 2
.m_nglo     SKIP 2
.m_nghi     SKIP 2
    \ the frame's inputs, which the game (for now the scene harness) sets
.pl_x       SKIP 2          ; {ST $12E(a6) word} the player
.pl_y       SKIP 2          ; {ST $130(a6) word}
.pl_z       SKIP 2          ; {ST $132(a6) word}
.pl_pitch   SKIP 2          ; {ST $13A(a6) word}
.pl_heading SKIP 2          ; {ST $13C(a6) word}
.pl_roll    SKIP 2          ; {ST $13E(a6) word}
.n_slots    SKIP 1          ; {ST $1D8(a6) word8} the slots the coarse list and the handlers look at
.docked     SKIP 1          ; {ST $2CA(a6) byte} non-zero in the silo
.silo_missile SKIP 1        ; non-zero while the silo's missile is there
.all_faces  SKIP 1          ; &80: every face visible (the Interrogate screen's H, $2BD)
.beam_colour SKIP 1         ; {ST P&0D97E word8} the beam's colour, which animate_shapes cycles
.bank_now   SKIP 1          ; the sideways bank paged, as BANK pages it
.draw_bank  SKIP 1          ; the screen drawn into: 0 main RAM's, ACCCON_X shadow's
.log_base   SKIP 2          ; where render logs its lines (in BANK_LOG)
.fields     SKIP 1          ; fields shown, counted by the interrupt (engine.6502)
    \ the renderer's: the last object's stamp on its edges and vertices,
    \ which lasts from frame to frame as the marks do
.stamp      SKIP 1
ENDSECTION

\ The pool stops short of &FC, where the MOS's IRQ entry keeps A.
ZA_POOL ZP_FIXED..&FB

\ The products (maths.6502)
ZA_AUTO2 mul_x, mul_y, mul_t, mul_r
ZA_AUTO 4, mul_p
ZA_AUTO1 mul_sign
ZA_AUTO2 div_d, div_u, div_q
ZA_AUTO 4, div_n

\ The renderer (render.6502): what crosses its routines
IF DEFINED(SPIKE)
ZA_AUTO2 log_ptr            ; the next line in line_log
ENDIF
ZA_AUTO 18, cam             ; the camera's matrix: rows x', y', z' of words on x, y, z
ZA_AUTO 18, mat             ; the object's (build_matrix's)
ZA_AUTO 6, ang              ; build_matrix's pitch, heading and roll
ang_p = ang
ang_h = ang + 2
ang_r = ang + 4
ZA_AUTO1 slot, otype
ZA_AUTO 6, tpos             ; the object's camera-space position, x y z words
tx = tpos
ty = tpos + 2
tz = tpos + 4
\ the shape's header, as it lies: HDR_BYTES, then HDR_WORDS pointers
HDR_BYTES = 10
HDR_WORDS = 12
ZA_AUTO HDR_BYTES + HDR_WORDS * 2, sh
sh_nverts  = sh
sh_nedges  = sh + 1
sh_nfaces  = sh + 2
sh_colour  = sh + 3
sh_scale   = sh + 4
sh_nframes = sh + 5
sh_nstill  = sh + 6
sh_nrigid  = sh + 7
sh_radius  = sh + 8
sh_frames  = sh + 10
sh_ev0     = sh + 12
sh_ev1     = sh + 14
sh_fflags  = sh + 16
sh_fedges  = sh + 18
sh_elists  = sh + 20
sh_vx      = sh + 22
sh_vy      = sh + 24
sh_vz      = sh + 26
sh_nx      = sh + 28
sh_ny      = sh + 30
sh_nz      = sh + 32
\ the frame's arrays, each set back so it's indexed by vertex or face
ZA_AUTO2 fr_vx, fr_vy, fr_vz, fr_nx, fr_ny, fr_nz, fr_klo, fr_khi
ZA_AUTO 6, objc             ; the camera in the object's space
ZA_AUTO1 edge_i, va, vb
\ the window clip's points: four consecutive words, swapped as two pairs
ZA_AUTO 8, clip_pts
cx0 = clip_pts
cy0 = clip_pts + 2
cx1 = clip_pts + 4
cy1 = clip_pts + 6
\ project's operands, px and pz, are two of the vertex transform's sums
\ (xform.6502), x', y' and z' in turn
ZA_AUTO 6, xf_sum
px = xf_sum
xf_y = xf_sum + 2
pz = xf_sum + 4
ZA_AUTO2 pq

\ The line drawer (line.6502). Its ends are the clip's points (y's low
\ bytes), so a line the clip accepts is already where the drawer reads it.
line_x0 = cx0
line_y0 = cy0
line_x1 = cx1
line_y1 = cy1
ZA_AUTO2 line_scr
ZA_AUTO1 line_dx, line_dy, line_cnt, line_ls, line_errs, line_err

\ The workspace, in the OS's pages, up to the disc reader's NMI page.
WORK = &0400
NMI_PAGE = &0D00
SECTION Work, org = WORK, guard = NMI_PAGE, virtual = TRUE
    \ the vertices and marks, by vertex and edge number, first, so that no
    \ index into one crosses a page
.edge_mark  SKIP 256
.vert_mark  SKIP 256
.v_xlo      SKIP 128
.v_xhi      SKIP 128
.v_ylo      SKIP 128
.v_yhi      SKIP 128
.v_zlo      SKIP 128
.v_zhi      SKIP 128
.v_sxlo     SKIP 128
.v_sxhi     SKIP 128
.v_sylo     SKIP 128
.v_syhi     SKIP 128
.v_code     SKIP 128        ; the window's outcode of each vertex on the screen
ASSERT LO(edge_mark) = 0 AND LO(v_xlo) = 0
    \ the lists' lengths (the lists: memory.6502)
.coarse_n   SKIP 1
.near_n     SKIP 1          ; {ST $240(a6) word8}
.draw_n     SKIP 1
.log_n      SKIP 2          ; lines in line_log
.mat_valid  SKIP 1          ; non-zero: mat is for mat_angles
.mat_angles SKIP 6
.ground_valid SKIP 1        ; non-zero: mat is ground_matrix's for ground_h
.ground_h   SKIP 2
.mat_scaled SKIP 1          ; non-zero: xf_amag and xf_asign are mat's, for scaled_for
.scaled_for SKIP 1          ; the shape's scale they're for
    \ the frame (engine.6502): the screen being drawn, 0 main RAM's or 1
    \ shadow's, whether it's ready to show, and each screen's erase list
.draw_buffer SKIP 1
.frame_ready SKIP 1
.stepped    SKIP 1          ; the field count the steps taken have reached
.frames     SKIP 2          ; frames drawn
.steps      SKIP 2          ; steps taken
.erase_stop SKIP 2          ; by screen: its erase list's next free index (0: full, so cleared whole)
    \ the disc (disc.6502): the reader's state, what's left of the file
    \ being read, and the game's files as the catalogue has them
DISC_MAX = 8
.fdc_state  SKIP 1          ; 0 idle, 1 seeking, 2 reading
.fdc_cur    SKIP 1          ; the head's track (&FF: not known)
.fdc_sect   SKIP 1          ; the sector being read, and its track
.fdc_track  SKIP 1
.fe_len     SKIP 2          ; the bytes still to read ...
.fe_dst     SKIP 2          ; ... to where ...
.fe_bank    SKIP 1          ; ... in which bank
.fe_track_lo SKIP 1         ; the bytes this track's read wants
.fe_track_hi SKIP 1
.nmi_left   SKIP 1          ; the NMI routine's count: a low byte (0 for 256) ...
.nmi_pages  SKIP 1          ; ... and the pages it starts
.df_len_lo  SKIP DISC_MAX   ; by file: its length ...
.df_len_hi  SKIP DISC_MAX
.df_sect_lo SKIP DISC_MAX   ; ... and its first sector
.df_sect_hi SKIP DISC_MAX
    \ by shape and colour
.anim_frame SKIP 32         ; each shape's animation frame, as its list numbers them
.colour_map SKIP 16         ; the ST's colours to the screen's bytes (&00, &0F, &F0, &FF)
.work_end                   ; (a build's own workspace can follow)
ENDSECTION

\ HAZEL, which the spike pages in (it makes no OS calls): the tables and
\ code (spike.6502).
TABLES = &C000
CODE2 = &D000

\ Every line drawn, for the harness (slot, edge, x0 (word), y0, x1 (word),
\ y1, colour), in a sideways bank of its own.
LOG = &8000
LOG_ENTRY = 9
LOG_LINES = 400
LOG2 = &A000                ; a second, for the other screen (main.6502)
SECTION Log, org = LOG, guard = &C000, virtual = TRUE
.line_log   SKIP LOG_ENTRY * LOG_LINES
ENDSECTION
