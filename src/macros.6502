\ ***************************************************************************
\ STARGLIDER for the BBC Master - macros
\ ***************************************************************************

\ CMPS16 a, b: compare two signed words (zero page), a with b or the
\ constant #b: N set if a < b.
MACRO CMPS16 a, b
    SEC
    LDA a : SBC b
    LDA a+1 : SBC b+1
    BVC ok
    EOR #&80
.ok
ENDMACRO
MACRO CMPS16 a, "#" b
    SEC
    LDA a : SBC #LO(b)
    LDA a+1 : SBC #HI(b)
    BVC ok
    EOR #&80
.ok
ENDMACRO

\ FMUL a, b: mul_r = fmul16(a, b), words in zero page.
MACRO FMUL a, b
    LDA a : STA mul_x : LDA a+1 : STA mul_x+1
    LDA b : STA mul_y : LDA b+1 : STA mul_y+1
    JSR fmul16
ENDMACRO
\ FMUL_BY b: mul_r = fmul16(mul_x, b), mul_x as the last product left it.
MACRO FMUL_BY b
    LDA b : STA mul_y : LDA b+1 : STA mul_y+1
    JSR fmul16
ENDMACRO

\ ADDW r, a / SUBW r, a: r = r + a, r - a (words).
MACRO ADDW r, a
    CLC
    LDA r : ADC a : STA r
    LDA r+1 : ADC a+1 : STA r+1
ENDMACRO
MACRO SUBW r, a
    SEC
    LDA r : SBC a : STA r
    LDA r+1 : SBC a+1 : STA r+1
ENDMACRO
MACRO MOVW r, a
    LDA a : STA r : LDA a+1 : STA r+1
ENDMACRO

\ Working variables several routines (and the macros) share.
ZA_AUTO2 acc                ; a row's sum
ZA_AUTO2 m_idx               ; sincos's index ...
ZA_AUTO 4, m_sc             ; ... and its results: the sine, then the cosine
m_sin = m_sc
m_cos = m_sc + 2
ZA_AUTO1 ocolour            ; the object's colour, the ST's number
ZA_AUTO 6, ep               ; an edge's ends in camera space, x y z words
ZA_AUTO 6, eq
ZA_AUTO 18, xf_amag         ; the object's matrix scaled to its shape: |A| words ...
ZA_AUTO 9, xf_asign         ; ... and signs (bit 7), by term (mkxform.py)
ZA_AUTO 6, objc_mag         ; the camera in the object's space: |c| words ...
ZA_AUTO 3, objc_sign        ; ... and signs

\ CLAMP v, lo, hi: the word v into lo..hi, below first (player_flight's
\ accumulators, as the ST clamps them).
MACRO CLAMP v, lo, hi
    CMPS16 v, #lo : BPL not_low
    LDA #LO(lo) : STA v : LDA #HI(lo) : STA v+1
    BRA done
.not_low
    SEC : LDA #LO(hi) : SBC v : LDA #HI(hi) : SBC v+1
    BVC ok : EOR #&80
.ok
    BPL done
    LDA #LO(hi) : STA v : LDA #HI(hi) : STA v+1
.done
ENDMACRO

\ WORLD acc, t, lo, hi: a vertex's coordinate in world units, in place:
\ its transform's sum in quarters (acc) plus the object's position t, into
\ acc and the vertex arrays lo and hi at Y; N and Z are its high byte's.
MACRO WORLD acc, t, lo, hi
    LDA acc+1
    CMP #&80 : ROR A : ROR acc
    CMP #&80 : ROR A : ROR acc
    TAX
    LDA acc : CLC : ADC t : STA acc : STA lo,Y
    TXA : ADC t+1 : STA acc+1 : STA hi,Y
ENDMACRO

\ WORLD_FOLDED acc, lo, hi: WORLD for a sum that started with the
\ object's position in it, in quarters (render.6502's fold): the shift
\ alone. N and Z are its low byte's.
MACRO WORLD_FOLDED acc, lo, hi
    LDA acc+1
    CMP #&80 : ROR A : ROR acc
    CMP #&80 : ROR A : ROR acc
    STA acc+1 : STA hi,Y
    LDA acc : STA lo,Y
ENDMACRO

\ WORLD_SHIFT acc: WORLD_FOLDED kept in acc alone.
MACRO WORLD_SHIFT acc
    LDA acc+1
    CMP #&80 : ROR A : ROR acc
    CMP #&80 : ROR A : ROR acc
    STA acc+1
ENDMACRO

\ BANK n: page sideways bank n. bank_now first, so an interrupt that pages
\ a bank of its own and puts back bank_now never puts back the bank before.
MACRO BANK n
    LDA #n : STA bank_now : STA romsel
ENDMACRO

\ ASRW v: the word v one bit right, as the 68000's asr: its sign kept.
MACRO ASRW v
    LDA v+1 : CMP #&80 : ROR A : STA v+1
    ROR v
ENDMACRO

\ NEGW v: the word v negated.
MACRO NEGW v
    LDA #0 : SEC : SBC v : STA v
    LDA #0 : SBC v+1 : STA v+1
ENDMACRO
