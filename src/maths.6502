\ ***************************************************************************
\ STARGLIDER for the BBC Master - arithmetic
\
\ Products are quarter-squares (a * b = f(a + b) - f(a - b), f(n) = n*n/4),
\ read through zero-page pointers that one operand sets (mul_set), so a
\ run of products by the same byte costs only the reads.
\
\ The 68000's arithmetic the game's logic uses is here exactly: muls
\ (smul16), the fixed-point product the matrices use (fmul16: muls, asl.l
\ #2, swap) and divs with its overflow (sdiv32).
\ ***************************************************************************


\ mul_init: the pointers' high bytes, once.
.mul_init
    LDA #HI(sqr_lo) : STA m_sqlo+1
    LDA #HI(sqr_hi) : STA m_sqhi+1
    LDA #HI(neg_lo) : STA m_nglo+1
    LDA #HI(neg_hi) : STA m_nghi+1
    RTS

\ MUL_SET: A is the multiplicand for the MUL8s that follow.
MACRO MUL_SET
    STA m_sqlo : STA m_sqhi
    EOR #&FF
    STA m_nglo : STA m_nghi
ENDMACRO

\ MUL8 lo: the product of the multiplicand and Y, unsigned: its low byte
\ into lo, its high byte in A.
MACRO MUL8 lo
    SEC
    LDA (m_sqlo),Y : SBC (m_nglo),Y : STA lo
    LDA (m_sqhi),Y : SBC (m_nghi),Y
ENDMACRO

\ umul16: mul_p (4 bytes) = mul_x * mul_y, both unsigned 16-bit. The
\ middle byte's carries go into x1 y0's high byte, which they can't
\ overflow: it's at most &FE, and &FE only when its low byte is 1.
.umul16
{
    ZA_AUTO1 c0
    LDA mul_x : MUL_SET
    LDY mul_y : MUL8 mul_p : STA mul_p+1        ; x0 y0
    LDY mul_y+1 : MUL8 mul_t : STA mul_p+2      ; x0 y1
    LDA mul_x+1 : MUL_SET
    MUL8 mul_t+1 : STA mul_p+3                  ; x1 y1
    LDY mul_y : MUL8 c0 : TAX                   ; x1 y0
    LDA mul_p+1 : CLC : ADC mul_t : BCC n1
    INX : CLC
.n1
    ADC c0 : STA mul_p+1 : BCC n2
    INX
.n2
    TXA : CLC : ADC mul_p+2 : BCC n3
    INC mul_p+3 : CLC
.n3
    ADC mul_t+1 : STA mul_p+2 : BCC done
    INC mul_p+3
.done
    RTS
}

\ SIGNED: mul_p, umul16's product, made mul_x * mul_y signed (the 68000's
\ muls): the unsigned product of the two's complement words, less 2^16 y
\ if x is negative and 2^16 x if y is.
MACRO SIGNED
    BIT mul_x+1 : BPL x_pos
    LDA mul_p+2 : SEC : SBC mul_y : STA mul_p+2
    LDA mul_p+3 : SBC mul_y+1 : STA mul_p+3
.x_pos
    BIT mul_y+1 : BPL y_pos
    LDA mul_p+2 : SEC : SBC mul_x : STA mul_p+2
    LDA mul_p+3 : SBC mul_x+1 : STA mul_p+3
.y_pos
ENDMACRO

\ smul16: mul_p = mul_x * mul_y, signed 16-bit to 32 (the 68000's muls).
.smul16
    JSR umul16
    SIGNED
    RTS

\ fmul16: mul_r = the 68000's `muls; asl.l #2; swap` of mul_x and mul_y:
\ floor(x * y / 16384), wrapped to 16 bits. Two's complement shifts round
\ down, so the floor comes free.
.fmul16
    JSR umul16
    SIGNED
    LDA mul_p+2 : STA mul_r
    LDA mul_p+3 : STA mul_r+1
    LDA mul_p+1
    ASL A : ROL mul_r : ROL mul_r+1
    ASL A : ROL mul_r : ROL mul_r+1
    RTS

\ DIV_BYTE n: a byte of sdiv32's quotient, from the dividend's byte n and
\ the remainder (div_n+2, A) below div_u, into n: each step rotates n's
\ next bit into the remainder and the last step's quotient bit (C) into
\ n, and a last rotate takes the eighth. (The first bit rotated in comes
\ out again with that last rotate.)
MACRO DIV_BYTE n
    LDX #8
.step
    ROL n : ROL div_n+2 : ROL A
    BCS sub                             ; the remainder passed 16 bits
    CMP div_u+1 : BCC next              ; C = 0: the bit's 0
    BNE sub
    LDY div_n+2 : CPY div_u : BCC next
.sub
    TAY                                 ; (C = 1 on every way here)
    LDA div_n+2 : SBC div_u : STA div_n+2
    TYA : SBC div_u+1
    SEC                                 ; the bit's 1
.next
    DEX : BNE step
    ROL n
ENDMACRO

\ sdiv32: the 68000's divs. mul_p (32-bit signed) / div_d (16-bit signed):
\ C = 0 and the quotient, truncated towards zero, in div_q; or C = 1 if it
\ doesn't fit 16 bits, when divs leaves its operand alone. div_d is not 0.
.sdiv32
{
    LDA mul_p+3 : EOR div_d+1 : STA mul_sign
    LDA div_d : STA div_u : LDA div_d+1 : STA div_u+1
    BPL dpos
    LDA #0 : SEC : SBC div_u : STA div_u
    LDA #0 : SBC div_u+1 : STA div_u+1
.dpos
    LDA mul_p : STA div_n : LDA mul_p+1 : STA div_n+1
    LDA mul_p+2 : STA div_n+2 : LDA mul_p+3 : STA div_n+3
    BPL npos
    LDA #0 : SEC : SBC div_n : STA div_n
    LDA #0 : SBC div_n+1 : STA div_n+1
    LDA #0 : SBC div_n+2 : STA div_n+2
    LDA #0 : SBC div_n+3 : STA div_n+3
.npos
    \ An unsigned quotient of 17 bits or more never fits: the high half
    \ must be below the divisor.
    LDA div_n+2 : CMP div_u : LDA div_n+3 : SBC div_u+1
    BCC divide
    RTS                                 ; (C = 1)
.divide
    \ The quotient a byte at a time, high then low, each by 8 steps of
    \ shift and subtract with the remainder in div_n+2 and A. When the
    \ remainder a byte on is still below the divisor, the high byte is 0,
    \ and the remainder starts there.
    LDA div_n+3 : BNE both
    LDA div_n+1 : CMP div_u : LDA div_n+2 : SBC div_u+1
    BCS both
    LDY div_n+1 : LDA div_n+2 : STY div_n+2
    STZ div_n+1
    BRA low
.both
    LDA div_n+3
    DIV_BYTE div_n+1
.low
    DIV_BYTE div_n
    \ It fits a signed word: up to 32767, or 32768 if negative.
    BIT mul_sign : BMI negative
    LDA div_n+1 : BMI overflow
    LDA div_n : STA div_q : LDA div_n+1 : STA div_q+1
    CLC : RTS
.negative
    LDA div_n+1 : BPL fits
    CMP #&80 : BNE overflow
    LDA div_n : BNE overflow
.fits
    LDA #0 : SEC : SBC div_n : STA div_q
    LDA #0 : SBC div_n+1 : STA div_q+1
    CLC : RTS
.overflow
    SEC : RTS
}
