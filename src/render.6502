\ ***************************************************************************
\ STARGLIDER for the BBC Master - the renderer
\
\ The ST's world_render (&04FE8) from the camera to the lines: the camera
\ matrix, the coarse, near and draw lists with each object rotated into
\ camera space, then each drawn object's matrix, faces, vertices, edges,
\ near-plane clip, projection and window clip.
\
\ The camera and the lists are the world bank's (world.6502); this is the
\ drawing, from the draw list, which is approximate where it only draws
\ (decisions 1, 9, 10): tools/scenecheck.py compares every list and line
\ with tools/st_render.py.
\ ***************************************************************************

\ The window, the projection's centre and its shift: the ST's colour-mode
\ values ($146-$14C, $1FC, $1FE, $212; &08CA0). (The missile view clips
\ to a window of its own: CLIP_SITES, below.)
VIEW_XMIN = 16
VIEW_XMAX = 303
VIEW_YMIN = 10
VIEW_YMAX = 128
VIEW_CX   = 143
VIEW_CY   = 68
NEAR_Z    = 2

\ ---------------------------------------------------------------------------
\ render: the frame's lists and every drawn object's lines.
\ (The spike times its phases between these labels.)
IF DEFINED(SPIKE)
.render
    STZ log_n : STZ log_n+1
    LDA log_base : STA log_ptr : LDA log_base+1 : STA log_ptr+1
    JSR spike_missile
    BANK BANK_WORLD
    JSR camera
.render_lists
    JSR coarse_list
    JSR rotate_lists
    JSR spike_missile
.render_objects
    JSR draw_phase
.render_done
    RTS
ENDIF

\ marks_wipe: every edge's and vertex's mark 0, and stamp, so the next
\ stamp is on none of them (and before the first frame: setup.6502's
\ erase_init).
.marks_wipe
    LDX #0 : STX stamp
.wipe
    STZ edge_mark,X : STZ vert_mark,X
    INX : BNE wipe
    RTS

\ draw_phase: the draw list's objects into the screen draw_buffer names
\ (draw_bank set to match), each line onto its erase list (memory.6502).
\ (The disc's frame, engine.6502, draws more between them.)
IF DEFINED(SPIKE)
.draw_phase
    JSR draw_begin
    JSR view_objects
    JMP draw_end
ENDIF

\ draw_begin: line_plot's stores moved to the erase list of the screen
\ draw_buffer names (to that screen's pages), from its start; draw_end
\ keeps where it got to. erase_more carries the list on from there, for
\ more drawn onto the same frame (view.6502's over_draw), and erase_keep
\ keeps it again.
.draw_begin
    LDA #ERASE_LINES : STA erase_i
.erase_aim
    LDA draw_buffer : CLC : ADC #HI(ERASE_LIST)
    ASSERT EF_LO = 0 AND EF_HI = 1 AND EF_ROW = 2 AND EF_DX = 3 AND EF_DY = 4 AND EF_CODE = 5
    STA line_plot.f_lo0+2 : STA line_plot.f_lo1+2 : ADC #2
    STA line_plot.f_hi0+2 : STA line_plot.f_hi1+2 : ADC #2
    STA line_plot.f_row0+2 : STA line_plot.f_row1+2 : ADC #2
    STA line_plot.f_dx+2 : ADC #2
    STA line_plot.f_dy0+2 : STA line_plot.f_dy1+2 : ADC #2
    STA line_plot.f_code+2
    RTS
.erase_more
    LDX draw_buffer
    LDA erase_stop,X : STA erase_i
    BRA erase_aim
.draw_end
.erase_keep
    LDX draw_buffer
    LDA erase_i : STA erase_stop,X
    RTS

\ TRIG_BY b: FMUL_BY b by fmul_trig (world.6502), for build_matrix's
\ products, once it has paged the world's bank.
MACRO TRIG_BY b
    LDA b : STA mul_y : LDA b+1 : STA mul_y+1
    JSR fmul_trig
ENDMACRO

\ build_matrix (&04114): mat from ang_p, ang_h, ang_r (pitch, heading,
\ roll), as rows x', y', z' of coefficients on x, y, z. The ST keeps the
\ last object's matrix when the angles haven't changed, and so does this.
.build_matrix
{
    ZA_AUTO2 m_s1, m_c1, m_s2, m_c2, m_s3, m_c3, m_d6, m_d7, m_t
    LDA mat_valid : BEQ build
    LDX #5
.same
    LDA ang,X : ZA_INDEXEDBY 0..5
    CMP mat_angles,X : BNE build
    DEX : BPL same
    RTS
.build
    STZ ground_valid            ; mat isn't ground_matrix's now
    LDX #5
.keep
    LDA ang,X : ZA_INDEXEDBY 0..5
    STA mat_angles,X
    DEX : BPL keep
    LDA #&FF : STA mat_valid
    BANK BANK_WORLD
    LDA ang_p : STA m_idx : LDA ang_p+1 : AND #&0F : STA m_idx+1
    JSR sincos : MOVW m_s1, m_sin : MOVW m_c1, m_cos
    LDA ang_h : STA m_idx : LDA ang_h+1 : AND #&0F : STA m_idx+1
    JSR sincos : MOVW m_s2, m_sin : MOVW m_c2, m_cos
    \ the roll: 9 bits, times 8
    LDA ang_r : STA m_idx : LDA ang_r+1 : AND #1 : STA m_idx+1
    ASL m_idx : ROL m_idx+1 : ASL m_idx : ROL m_idx+1 : ASL m_idx : ROL m_idx+1
    JSR sincos : MOVW m_s3, m_sin : MOVW m_c3, m_cos
    \ The ST's products and sums (&04190), taken by the factor they share,
    \ each sum built in its entry: the same values in any order. First
    \ those of the pitch and roll alone, which the camera keeps while only
    \ its heading turns, calling matrix_heading with mul_x c1 (world.6502);
    \ then those with the heading, in the world's bank (matrix.6502).
    MOVW mul_x, m_s3
    TRIG_BY m_s1 : MOVW m_d6, mul_r
    TRIG_BY m_c1 : MOVW mat+2, mul_r                                ; x' on y
    MOVW mul_x, m_c1
    TRIG_BY m_c3 : MOVW mat+8, mul_r                                ; y' on y
    LDA #0 : SEC : SBC m_s1 : STA mat+14
    LDA #0 : SBC m_s1+1 : STA mat+15                                ; z' on y
    JMP matrix_heading
}

\ ground_matrix: mat for an object with no pitch of its own, at heading
\ ang_h: with the camera's pitch and roll, each entry of the ST's matrix
\ (&04190) is a mix of sin and cos of the heading by five of the frame's
\ constants (kconst: s3 s1, s1 c3, c1, c3, s3), so ten products make it.
\ The ST nests its products differently; this is for drawing only.
ZA_AUTO 10, kconst          ; the constants, words ...
ZA_AUTO 10, kmag            ; ... as magnitudes ...
ZA_AUTO 5, ksign            ; ... and signs
.ground_matrix
{
    ZA_AUTO 10, ps              ; sin h by each constant
    \ the last ground object's heading, while mat is still its
    LDA ground_valid : BEQ lookup
    LDA ang_h : CMP ground_h : BNE lookup
    LDA ang_h+1 : CMP ground_h+1 : BNE lookup
    RTS
.lookup
    MOVW ground_h, ang_h
    LDA #&FF : STA ground_valid
    STZ mat_valid               ; mat isn't build_matrix's now
    STZ mat_scaled              ; nor xf_amag's
    \ Kept since the camera last pitched or rolled? The matrix is the
    \ heading's and kconst's, and kconst is the camera's pitch and roll.
    LDX gm_n : BEQ build
.find
    DEX
    LDA ang_h : CMP gm_h_lo,X : BNE not_this
    LDA ang_h+1 : CMP gm_h_hi,X : BEQ hit
.not_this
    TXA : BNE find
    BRA build
.hit
FOR i = 0..11
    LDA gm_mat + i * GM_N,X : STA mat + 2 * (3 * (i DIV 4) + 2 * ((i DIV 2) MOD 2)) + (i MOD 2)
NEXT
    JMP camera_column
.build
    BANK BANK_WORLD
    LDA ang_h : STA m_idx : LDA ang_h+1 : AND #&0F : STA m_idx+1
    JSR sincos
    MOVW kv, m_sin : JSR kmul
    LDX #9
.keep
    LDA kp,X : ZA_INDEXEDBY 0..9
    STA ps,X : ZA_INDEXEDBY 0..9
    DEX : BPL keep
    MOVW kv, m_cos : JSR kmul           ; kp: cos h by each
    LDA kp+6 : CLC : ADC ps : STA mat : LDA kp+7 : ADC ps+1 : STA mat+1           ; c c3 + s s3s1
    LDA ps+2 : SEC : SBC kp+8 : STA mat+6 : LDA ps+3 : SBC kp+9 : STA mat+7       ; s s1c3 - c s3
    MOVW mat+12, ps+4                                                             ; s c1
    LDA kp : SEC : SBC ps+6 : STA mat+4 : LDA kp+1 : SBC ps+7 : STA mat+5         ; c s3s1 - s c3
    LDA ps+8 : CLC : ADC kp+2 : STA mat+10 : LDA ps+9 : ADC kp+3 : STA mat+11     ; s s3 + c s1c3
    MOVW mat+16, kp+4                                                             ; c c1
    \ kept for the heading, over the oldest
    LDX gm_next
    LDA ang_h : STA gm_h_lo,X : LDA ang_h+1 : STA gm_h_hi,X
FOR i = 0..11
    LDA mat + 2 * (3 * (i DIV 4) + 2 * ((i DIV 2) MOD 2)) + (i MOD 2) : STA gm_mat + i * GM_N,X
NEXT
    INX : CPX #GM_N : BCC next_ok
    LDX #0
.next_ok
    STX gm_next
    LDA gm_n : CMP #GM_N : BCS camera_column
    INC gm_n
.camera_column
    MOVW mat+2, cam+2                   ; c1 s3, c1 c3, -s1: the camera's own
    MOVW mat+8, cam+8
    MOVW mat+14, cam+14
    RTS
}

\ The last GM_N ground matrices made since the camera last pitched or
\ rolled (draw_objects empties them when it does), by heading: mat's six
\ entries that aren't the camera's own, by byte. While the player flies
\ level, the objects drawn at one frame mostly have the headings they
\ had at the last.
GM_N = 8
.gm_h_lo    SKIP GM_N
.gm_h_hi    SKIP GM_N
.gm_mat     SKIP 12 * GM_N
.gm_n       EQUB 0                  ; how many are kept ...
.gm_next    EQUB 0                  ; ... and the next to fill
.gm_pitch   EQUW 0                  ; the camera's pitch and roll they're for
.gm_roll    EQUW 0

\ object_matrix: build_matrix for an object with a pitch of its own, or
\ the matrix it made last for the same angles. A matrix is its angles'
\ alone, and an object that doesn't turn keeps them while the player's
\ hold. The last OM_N made are kept, each its angles, then mat.
OM_N = 2
OM_SIZE = 6 + 18
.object_matrix
{
    ZA_AUTO1 at
    LDX om_n : BEQ build
.find
    TXA : SEC : SBC #OM_SIZE : STA at
    CLC : ADC #5 : TAX
    LDY #5
.compare
    LDA ang,Y : ZA_INDEXEDBY 0..5
    CMP om_kept,X : BNE not_this
    DEX : DEY : BPL compare
    \ found: left as build_matrix leaves one it makes
    TXA : CLC : ADC #1 + 6 + 17 : TAX
    LDY #17
    ZA_DISCARD mat
.out
    LDA om_kept,X : STA mat,Y : ZA_INDEXEDBY 0..17
    DEX : DEY : BPL out
    LDX #5
.angles
    LDA ang,X : ZA_INDEXEDBY 0..5
    STA mat_angles,X
    DEX : BPL angles
    LDA #&FF : STA mat_valid
    STZ ground_valid
    STZ mat_scaled
    RTS
.not_this
    LDX at : BNE find
.build
    JSR build_matrix
    STZ mat_scaled                      ; (xf_amag isn't mat's)
    \ kept, over the oldest
    LDA om_next : CLC : ADC #5 : TAX
    LDY #5
.angles_in
    LDA ang,Y : ZA_INDEXEDBY 0..5
    STA om_kept,X
    DEX : DEY : BPL angles_in
    TXA : CLC : ADC #1 + 6 + 17 : TAX
    LDY #17
.mat_in
    LDA mat,Y : ZA_INDEXEDBY 0..17
    STA om_kept,X
    DEX : DEY : BPL mat_in
    LDA om_next : CLC : ADC #OM_SIZE : CMP #OM_N * OM_SIZE : BCC next_ok
    LDA #0
.next_ok
    STA om_next
    LDA om_n : CMP #OM_N * OM_SIZE : BCS full
    ADC #OM_SIZE : STA om_n
.full
    RTS
}
.om_kept    SKIP OM_N * OM_SIZE
.om_n       EQUB 0                  ; offsets: the end of those kept ...
.om_next    EQUB 0                  ; ... and the next to fill

\ ---------------------------------------------------------------------------
\ draw_objects (&05108): the draw list read from its top. Each object's
\ matrix takes the player's pitch and heading added to its own, and the
\ player's roll negated (the ST's sum of angles, not a product of
\ matrices). In the missile view the missile's stand in (L_05248's loop,
\ &0545A: code.6502's view_objects).
.draw_objects
{
    ZA_AUTO1 list_i
    STZ mat_scaled                      ; (zero page isn't kept from frame to frame)
    \ the ground matrices kept hold while the camera neither pitches nor rolls
    LDA pl_pitch : CMP gm_pitch : BNE flush
    LDA pl_pitch+1 : CMP gm_pitch+1 : BNE flush
    LDA pl_roll : CMP gm_roll : BNE flush
    LDA pl_roll+1 : CMP gm_roll+1 : BEQ kept
.flush
    STZ gm_n : STZ gm_next
    MOVW gm_pitch, pl_pitch
    MOVW gm_roll, pl_roll
.kept
    LDX draw_n : BNE each
    RTS
.each
    DEX : STX list_i
    LDA draw_slots,X : STA slot : TAX
    LDA ob_type,X : STA otype : BEQ next
    LDA ob_exploding,X : BNE next           ; draw_shape_exploding: later
    LDA ob_cx_lo,X : STA tx : LDA ob_cx_hi,X : STA tx+1
    LDA ob_cy_lo,X : STA ty : LDA ob_cy_hi,X : STA ty+1
    LDA ob_cz_lo,X : STA tz : LDA ob_cz_hi,X : STA tz+1
    LDA ob_pitch_lo,X : CLC : ADC pl_pitch : STA ang_p
    LDA ob_pitch_hi,X : ADC pl_pitch+1 : STA ang_p+1
    LDA ob_heading_lo,X : CLC : ADC pl_heading : STA ang_h
    LDA ob_heading_hi,X : ADC pl_heading+1 : STA ang_h+1
    LDA #0 : SEC : SBC pl_roll : STA ang_r
    LDA #0 : SBC pl_roll+1 : STA ang_r+1
    \ its box, from none, for box_end (box.6502, in the loading area's
    \ bank, as view_objects leaves it for the first object: each pages
    \ what it reads)
    LDA erase_i : STA box_start
    LDA #&FF : STA box_c0 : STA box_y0
    STZ box_c1 : STZ box_y1 : STZ box_codes
    JSR draw_shape
    BANK_ANDY BANK_PIC
    JSR box_end
.next
    LDX list_i : BEQ done
    JMP each
.done
    RTS
}

\ ---------------------------------------------------------------------------
\ draw_shape (&04B1C): the object in `slot`, at (tx, ty, tz) in camera
\ space, its angles in ang_p, ang_h, ang_r.
.draw_shape
{
    ZA_AUTO1 shape, nmove, nturn, row_i, u_lo, h0, l0, far
    ZA_AUTO2 fr, t16, hp
    BANK BANK_SHAPES                    ; (type_shape's, and the header's)
    LDX otype
    LDA type_shape,X : CMP #SHAPES : BCC known
    RTS
.known
    STA shape
    \ Far enough away (16 radii or more), the perspective is linear across
    \ the object, to within half a pixel: its vertices go straight onto
    \ the screen (decision 10). Its centre and its vertices' reach there
    \ come first (far_place), from its position and its radius (in its
    \ header, in the shapes' bank): a reach wholly outside the window holds
    \ every vertex, so the object draws nothing, and goes no further, not
    \ even to its matrix. A near object wholly beyond one of the window's
    \ edges goes no further either (near_outside).
    TAX
    LDA shape_lo,X : STA hp : LDA shape_hi,X : STA hp+1
    STZ far
    LDY #sh_radius - sh
    LDA (hp),Y : STA sh_radius : STA t16
    INY : LDA (hp),Y : STA sh_radius+1
    ASL t16 : ROL A : ASL t16 : ROL A : ASL t16 : ROL A : ASL t16 : ROL A
    STA t16+1
    CMPS16 tz, t16 : BMI close
    JSR far_place : BCC far_in
    RTS
.close
    BANK BANK_PIC                       ; (near_outside's: box.6502)
    JSR near_outside
    BANK BANK_SHAPES                    ; (which leaves C)
    BCC reaches
    RTS
.far_in
    DEC far                             ; (bit 7: far)
.reaches
    \ An object with no pitch of its own has the camera's pitch and roll,
    \ and the camera in its space comes from the world's positions.
    LDA ang_p : CMP pl_pitch : BNE pitched
    LDA ang_p+1 : CMP pl_pitch+1 : BNE pitched
    JSR ground_matrix
    BANK BANK_WORLD                     ; (ground_camera's: matrix.6502)
    JSR ground_camera
    JMP got_camera
.pitched
    JSR object_matrix
    \ The camera in object space, in world units: c = -(mat transposed) t.
    ZA_DISCARD objc
    LDX #0
.cam_axis
    STX row_i
    LDA mat,X : ZA_INDEXEDBY {0, 2, 4}
    STA mul_x : LDA mat+1,X : ZA_INDEXEDBY {0, 2, 4}
    STA mul_x+1
    MOVW mul_y, tx : JSR fmul16 : MOVW acc, mul_r
    LDX row_i
    LDA mat+6,X : ZA_INDEXEDBY {0, 2, 4}
    STA mul_x : LDA mat+7,X : ZA_INDEXEDBY {0, 2, 4}
    STA mul_x+1
    MOVW mul_y, ty : JSR fmul16 : ADDW acc, mul_r
    LDX row_i
    LDA mat+12,X : ZA_INDEXEDBY {0, 2, 4}
    STA mul_x : LDA mat+13,X : ZA_INDEXEDBY {0, 2, 4}
    STA mul_x+1
    MOVW mul_y, tz : JSR fmul16 : ADDW acc, mul_r
    LDX row_i
    LDA #0 : SEC : SBC acc : STA objc,X : ZA_INDEXEDBY {0, 2, 4}
    LDA #0 : SBC acc+1 : STA objc+1,X : ZA_INDEXEDBY {0, 2, 4}
    INX : INX : CPX #6 : BEQ got_camera
    JMP cam_axis
.got_camera
    \ as magnitudes and signs, for the faces' products
FOR i = 0..2
    LDA objc + 2 * i + 1 : AND #&80 : STA objc_sign + i
    BMI negative
    LDA objc + 2 * i : STA objc_mag + 2 * i
    LDA objc + 2 * i + 1 : STA objc_mag + 2 * i + 1
    BRA done
.negative
    LDA #0 : SEC : SBC objc + 2 * i : STA objc_mag + 2 * i
    LDA #0 : SBC objc + 2 * i + 1 : STA objc_mag + 2 * i + 1
.done
NEXT
    BANK BANK_SHAPES
    \ The header, two bytes a turn, from where it's patched in
    LDX shape
    LDA shape_lo,X : STA header_a+1 : STA header_b+1
    LDA shape_hi,X : STA header_a+2 : STA header_b+2
    ASSERT (HDR_BYTES + HDR_WORDS * 2) MOD 2 = 0
    LDX #HDR_BYTES + HDR_WORDS * 2 - 1
    ZA_DISCARD sh
.header
.header_a
    LDA &8000,X : STA sh,X : ZA_INDEXEDBY 0..HDR_BYTES + HDR_WORDS * 2 - 1
    DEX
.header_b
    LDA &8000,X : STA sh,X : ZA_INDEXEDBY 0..HDR_BYTES + HDR_WORDS * 2 - 1
    DEX : BPL header
    \ The frame: the animation's, by shape.
    LDX shape : LDA anim_frame,X : ASL A : TAY
    LDA (sh_frames),Y : STA fr : INY : LDA (sh_frames),Y : STA fr+1
    \ Its arrays follow each other: the moving vertices' x, y, z, the
    \ changing faces' normals, then every face's K. Each pointer is set
    \ back by the count of still vertices or rigid faces, so it's indexed
    \ by vertex or face number: each the one before it on by an array's
    \ length, the low byte in A and the high in X. Past the vertices, fr
    \ + 3 nmove, is fr_vz + nverts.
    LDA sh_nverts : SEC : SBC sh_nstill : STA nmove
    LDA sh_nfaces : SEC : SBC sh_nrigid : STA nturn
    LDX fr+1
    LDA fr : SEC : SBC sh_nstill : STA fr_vx
    BCS vx_hi
    DEX
.vx_hi
    STX fr_vx+1
    CLC : ADC nmove : STA fr_vy
    BCC vy_hi
    INX
.vy_hi
    STX fr_vy+1
    CLC : ADC nmove : STA fr_vz
    BCC vz_hi
    INX
.vz_hi
    STX fr_vz+1
    CLC : ADC sh_nverts
    BCC past_vertices
    INX
.past_vertices
    SEC : SBC sh_nrigid : STA fr_nx
    BCS nx_hi
    DEX
.nx_hi
    STX fr_nx+1
    CLC : ADC nturn : STA fr_ny
    BCC ny_hi
    INX
.ny_hi
    STX fr_ny+1
    CLC : ADC nturn : STA fr_nz
    BCC nz_hi
    INX
.nz_hi
    STX fr_nz+1
    CLC : ADC sh_nfaces : STA fr_klo
    BCC klo_hi
    INX
.klo_hi
    STX fr_klo+1
    CLC : ADC sh_nfaces : STA fr_khi
    BCC khi_hi
    INX
.khi_hi
    STX fr_khi+1
    \ The colour: the shape's, or the beam's, which animate_shapes cycles.
    LDA sh_colour : CMP #&FF : BNE colour_ok
    LDA beam_colour
.colour_ok
    AND #15 : STA ocolour : TAX
    LDA colour_map,X : JSR set_colour
    \ The matrix scaled to the shape, for the vertices: A = m g / 256, so
    \ A k / 1024 is in world units (g = 32 x scale): (|m| scale + 4) / 8,
    \ which is (2 |m| x 16 scale + 128) / 256, the bytes falling where
    \ they're wanted. (16 scale is a byte: mkshapes.py.) Kept from the
    \ last object if mat and the scale are the same.
    LDA mat_scaled : BEQ scale
    LDA sh_scale : CMP scaled_for : BNE scale
    JMP kept
.scale
    LDA sh_scale : STA scaled_for
    ASL A : ASL A : ASL A : ASL A : MUL_SET
    LDX #0
    ZA_DISCARD xf_amag
.scale_term
    LDA mat,X : ZA_INDEXEDBY 0..16
    STA u_lo
    ORA mat+1,X : ZA_INDEXEDBY 0..16
    BEQ scale_zero
    LDA mat+1,X : ZA_INDEXEDBY 0..16
    BPL scale_pos
    LDA #0 : SEC : SBC u_lo : STA u_lo
    LDA #0 : SBC mat+1,X : ZA_INDEXEDBY 0..16
.scale_pos
    ASL u_lo : ROL A : TAY                      ; u = 2 |m|
    MUL8 h0 : STA xf_amag+1,X : ZA_INDEXEDBY 0..16
    LDY u_lo : MUL8 l0                          ; A: its high byte
    ASL l0                                      ; the rounding
    ADC h0 : STA xf_amag,X : ZA_INDEXEDBY 0..16
    BCC scale_next
    INC xf_amag+1,X : ZA_INDEXEDBY 0..16
.scale_next
    INX : INX : CPX #18 : BNE scale_term
    BRA scaled
.scale_zero                                     ; (as the products would make it)
    STZ xf_amag,X : ZA_INDEXEDBY 0..16
    STZ xf_amag+1,X : ZA_INDEXEDBY 0..16
    BRA scale_next
.scaled
    \ and the signs, &00 or &80 (the transforms' setups widen them in
    \ place, which leaves them as good for the next object)
FOR e = 0..8
    LDA mat + 2 * e + 1 : AND #&80 : STA xf_asign + e
NEXT
    LDA #&FF : STA mat_scaled
.kept
    \ A new stamp marks this object's edges and vertices.
    INC stamp : BNE stamped
    JSR marks_wipe
    INC stamp
.stamped
    JSR faces
    BIT far : BPL near
    JSR far_setup
    JMP edges_far
.near
    JSR xform_setup                     ; (and the position folded in where it can be)
    \ Folded, and wholly in front of the near plane (tz - the radius >=
    \ NEAR_Z + FOLD_SLACK): no vertex is behind it, nor any edge clipped at
    \ it, so vertex.in_front skips the tests and the camera-space position,
    \ and each edge goes straight to the window's clip.
    ASSERT LO(vertex.folded) <> LO(vertex.back)
    LDA xform_back+1 : CMP #LO(vertex.folded) : BNE straddling
    LDA tz+1 : BMI straddling
    LDA tz : SEC : SBC sh_radius : TAX
    LDA tz+1 : SBC sh_radius+1 : BMI straddling
    BNE in_front
    CPX #NEAR_Z + FOLD_SLACK : BCC straddling
.in_front
    LDA #LO(vertex.in_front) : STA xform_back+1
    LDA #HI(vertex.in_front) : STA xform_back+2
    LDA #TAX_OP : STA vertex.track          ; (its vertices into its box)
    LDA #LO(clip_line.ends) : LDX #HI(clip_line.ends)
    BRA patched
.straddling
    \ No box (decision 20) for an object that may be cut at the near plane,
    \ where its vertices can't bound what it draws, and that reaches so
    \ near it's seldom small on the screen (nor for the few left unfolded):
    \ its vertices aren't taken.
    STZ box_start
    LDA #RTS_OP : STA vertex.track
    LDA #LO(edge) : LDX #HI(edge)
.patched
    STA edges.call+1 : STX edges.call+2
    JMP edges
}
TAX_OP = &AA
RTS_OP = &60

\ A far object: far_place puts its centre on the screen (sc_x0, sc_y0, from
\ the view's centre), and finds whether it lies wholly inside the window or
\ wholly outside; far_setup makes the first-order matrix B onto the
\ screen. To first order in the object's offsets, its x on the screen is
\ X0 + (128 / tz)(A_x - (tx / tz) A_z) k / 1024, and tx / tz is X0 / 128:
\ so B_x = 128 (A_x - X0 A_z / 128) / tz, which is proj_x.r8's, and the
\ same for y.
ZA_AUTO 4, sc_0                 ; x, y
sc_x0 = sc_0
sc_y0 = sc_0 + 2
ZA_AUTO 4, sc_0q                ; ... and in quarters of a pixel
sc_x0q = sc_0q
sc_y0q = sc_0q + 2
ZA_AUTO1 far_inside             ; bit 7: no edge needs the window clip
ZA_AUTO 12, sc_bmag             ; B: |B| words, two rows of x, y, z ...
ZA_AUTO 6, sc_bsign             ; ... and signs
\ (far_place's centre and quarters are in the shapes' bank, which it runs
\ with: shapecode.6502.)

\ far_place: the centre (sc_0, sc_0q), and the vertices' reach on the
\ screen (plus one) from it against each edge of the window: wholly
\ inside it, far_inside's bit 7 says no edge needs the window's clip;
\ wholly outside, C set says the object draws nothing. It comes before
\ the object's faces and its matrix's scaling, which an object outside
\ doesn't need, and leaves proj_x set for the object's depth, for
\ far_setup's B.
\
\ A vertex within a radius r of the centre goes 128 (dx - X0 dz / 128) /
\ tz across by B, so up to 128 r / tz (pq, the radius on the screen)
\ times the root of 1 + (X0 / 128)^2 from it, and the same down for Y0.
\ That is at most 1 + |X0| / 256 while |X0| is up to 4/3 of 128
\ (FAR_C_MAX), as it is within the window: the reach is pq + pq |X0| /
\ 256, rounded up. Past FAR_C_MAX, where the centre is beyond the window
\ and the object can't be inside, the root is under 1 + |X0| / 128, and
\ the reach pq + pq |X0| / 128, up to |X0| of 255; from 256 the object is
\ neither inside nor outside, and its edges are clipped. The reach bounds
\ every vertex, inside the window or out, so a reach wholly past one edge
\ has every vertex past it, and every edge is one the clip rejects.
\ (1 + c / 256 is at least the root of 1 + (c / 128)^2 up to 4/3 of 128;
\ 1 + c / 128 is, everywhere)
FAR_C_MAX = 128 * 4 DIV 3
.far_place
{
    ZA_AUTO1 plo
    ZA_AUTO2 r, xlo, xhi, ylo, yhi
    MOVW pz, tz : JSR proj_z
    LDX #0 : JSR centre
    LDX #2 : JSR centre
    STZ far_inside
    \ the reach's box, lo to hi across and down
    MOVW px, sh_radius : JSR proj_x
    LDA pq+1 : BNE unbounded
    LDA pq : MUL_SET
    LDX #0 : JSR far_reach : BCS unbounded
    STA r : STY r+1
    LDA sc_x0 : SEC : SBC r : STA xlo : LDA sc_x0+1 : SBC r+1 : STA xlo+1
    LDA sc_x0 : CLC : ADC r : STA xhi : LDA sc_x0+1 : ADC r+1 : STA xhi+1
    LDX #2 : JSR far_reach : BCC bounded
.unbounded
    CLC : RTS
.outside
    SEC : RTS
.bounded
    STA r : STY r+1
    LDA sc_y0 : SEC : SBC r : STA ylo : LDA sc_y0+1 : SBC r+1 : STA ylo+1
    LDA sc_y0 : CLC : ADC r : STA yhi : LDA sc_y0+1 : ADC r+1 : STA yhi+1
    \ against each edge (its low byte the window's, patched: CLIP_SITES):
    \ outside if a far side is short of an edge, ...
    SEC : LDA xlo
.out_right
    SBC #LO(VIEW_XMAX - VIEW_CX + 1)
    LDA xlo+1 : SBC #HI(VIEW_XMAX - VIEW_CX + 1)
    BVC xlo_right : EOR #&80
.xlo_right
    BPL outside                             ; its left past the right edge
    SEC : LDA xhi
.out_left
    SBC #LO(VIEW_XMIN - VIEW_CX)
    LDA xhi+1 : SBC #HI(VIEW_XMIN - VIEW_CX)
    BVC xhi_left : EOR #&80
.xhi_left
    BMI outside                             ; its right short of the left edge
    SEC : LDA ylo
.out_bottom
    SBC #LO(VIEW_YMAX - VIEW_CY + 1)
    LDA ylo+1 : SBC #HI(VIEW_YMAX - VIEW_CY + 1)
    BVC ylo_below : EOR #&80
.ylo_below
    BPL outside                             ; its top past the bottom edge
    SEC : LDA yhi
.out_top
    SBC #LO(VIEW_YMIN - VIEW_CY)
    LDA yhi+1 : SBC #HI(VIEW_YMIN - VIEW_CY)
    BVC yhi_above : EOR #&80
.yhi_above
    BMI outside                             ; its bottom short of the top edge
    \ ... and inside if every near side is within them
    SEC : LDA xlo
.in_left
    SBC #LO(VIEW_XMIN - VIEW_CX)
    LDA xlo+1 : SBC #HI(VIEW_XMIN - VIEW_CX)
    BVC xlo_left : EOR #&80
.xlo_left
    BMI cut
    SEC : LDA xhi
.in_right
    SBC #LO(VIEW_XMAX - VIEW_CX + 1)
    LDA xhi+1 : SBC #HI(VIEW_XMAX - VIEW_CX + 1)
    BVC xhi_right : EOR #&80
.xhi_right
    BPL cut
    SEC : LDA ylo
.in_top
    SBC #LO(VIEW_YMIN - VIEW_CY)
    LDA ylo+1 : SBC #HI(VIEW_YMIN - VIEW_CY)
    BVC ylo_above : EOR #&80
.ylo_above
    BMI cut
    SEC : LDA yhi
.in_bottom
    SBC #LO(VIEW_YMAX - VIEW_CY + 1)
    LDA yhi+1 : SBC #HI(VIEW_YMAX - VIEW_CY + 1)
    BVC yhi_below : EOR #&80
.yhi_below
    BPL cut
    LDA #&80 : STA far_inside
.cut
    CLC : RTS
\ far_reach: A (low) and Y (high) = pq + pq |c| / 256 rounded up, plus
\ one, for the centre's c = sc_0,X (pq the multiplicand), or past
\ FAR_C_MAX pq + pq |c| / 128 rounded up, plus one; C set if |c| is 256
\ or more.
.far_reach
    LDA sc_0+1,X : ZA_INDEXEDBY {0, 2}
    BEQ c_pos
    CMP #&FF : BNE c_far
    LDA #0 : SEC : SBC sc_0,X : ZA_INDEXEDBY {0, 2}
    BEQ c_far                               ; (-256)
    BRA c_mag
.c_pos
    LDA sc_0,X : ZA_INDEXEDBY {0, 2}
.c_mag
    CMP #FAR_C_MAX + 1 : BCS c_wide
    TAY : MUL8 plo                          ; pq |c| / 256 rounded down ...
    LDY #0
    BRA c_add
.c_wide
    TAY : MUL8 plo                          ; (or doubled, + 1 for its rounding)
    LDY #0
    ASL A : BCC c_one
    INY : CLC
.c_one
    ADC #1 : BCC c_add
    INY
.c_add
    CLC : ADC pq : BCC c_pq                 ; ... + pq ...
    INY : CLC
.c_pq
    ADC #2 : BCC c_near                     ; ... + 2
    INY
.c_near
    CLC : RTS
.c_far
    SEC : RTS
}

\ far_setup: B, for an object far_place has placed and found not wholly
\ outside the window.
.far_setup
{
    ZA_AUTO1 term, halved, xneg, pneg, plo
    ZA_AUTO2 xs, d
    ZA_AUTO 3, d24
    \ B's 128 d / tz from R's high byte alone, rounded (proj_x.r8, decision
    \ 22): a far object is at most about 16 pixels across, so 8 bits of B
    \ are enough, and so are 8 of R. It's at least 16 radii away, so deep
    \ enough for r8.
    ASSERT 16 * SHAPE_RADIUS_MIN >= 128
    LDA proj_x.a+1 : ASL A                  ; R's low byte's top bit ...
    LDA proj_x.c+1 : ADC #0                 ; ... rounds its high byte
    BCC r_rounded
    LDA #&FF
.r_rounded
    STA proj_x.ra+1 : STA proj_x.rc+1 : STA proj_x.re+1
    EOR #&FF
    STA proj_x.rb+1 : STA proj_x.rd+1 : STA proj_x.rf+1
    \ B by term (3 row + j): d = A_row - X0 A_z / 128 (X0 or Y0), the
    \ product rounded down as the 68000's shifts would, then 128 d / tz
    ZA_DISCARD sc_bmag, sc_bsign
    STZ term
.each_term
    LDA term : BEQ row_x
    CMP #3 : BNE same_row
    MOVW xs, sc_y0
    BRA new_row
.row_x
    MOVW xs, sc_x0
.new_row
    \ |X0| and its sign. Below 256 it's set up for the products, and below
    \ 128 it's set up doubled, when their bytes 1-3 are |X0 A_z| / 128.
    LDA xs+1 : STA xneg : BPL x_pos
    LDA #0 : SEC : SBC xs : STA xs : LDA #0 : SBC xs+1 : STA xs+1
.x_pos
    LDA xs+1 : BNE same_row
    LDA xs : BMI x_set
    ASL A
.x_set
    MUL_SET
.same_row
    LDX term : LDY a_z,X
    TYA : ASL A : TAX
    LDA xf_amag,X : ZA_INDEXEDBY {12, 14, 16}
    ORA xf_amag+1,X : ZA_INDEXEDBY {12, 14, 16}
    BEQ no_z
    LDA xf_asign,Y : ZA_INDEXEDBY 6..8
    EOR xneg : STA pneg
    LDA xs+1 : BNE wide
    LDY xf_amag,X : ZA_INDEXEDBY {12, 14, 16}
    MUL8 mul_p : STA mul_p+1
    LDY xf_amag+1,X : ZA_INDEXEDBY {12, 14, 16}
    MUL8 plo : STA mul_p+2
    LDA plo : CLC : ADC mul_p+1 : STA mul_p+1
    BCC narrow
    INC mul_p+2
.narrow
    STZ mul_p+3
    BIT xs : BMI undoubled
    \ 2 |X0 A_z|, + 254 if the product is negative (its top byte stays 0:
    \ 2 |X0| and |A_z| are under 256 and 2^15)
    BIT pneg : BPL rounded
    LDA mul_p : CLC : ADC #254 : STA mul_p
    BCC rounded
    INC mul_p+1 : BNE rounded
    INC mul_p+2
    BRA rounded
.no_z
    \ A_z = 0: no product, so d = A_row, and if that's 0 too, so is B
    LDA term : ASL A : TAX
    LDA xf_amag,X : ZA_INDEXEDBY 0..10
    ORA xf_amag+1,X : ZA_INDEXEDBY 0..10
    BEQ b_zero
    STZ mul_p+1 : STZ mul_p+2 : STZ mul_p+3
    BRA rounded
.b_zero
    STZ sc_bmag,X : ZA_INDEXEDBY 0..10
    STZ sc_bmag+1,X : ZA_INDEXEDBY 0..10
    LDX term
    STZ sc_bsign,X : ZA_INDEXEDBY 0..5
    JMP next_term
.wide
    MOVW mul_x, xs
    LDA xf_amag,X : ZA_INDEXEDBY {12, 14, 16}
    STA mul_y : LDA xf_amag+1,X : ZA_INDEXEDBY {12, 14, 16}
    STA mul_y+1
    JSR umul16
.undoubled
    \ |X0 A_z|, + 127 if the product is negative, then doubled
    BIT pneg : BPL doubled
    LDA mul_p : CLC : ADC #127 : STA mul_p
    BCC doubled
    INC mul_p+1 : BNE doubled
    INC mul_p+2 : BNE doubled
    INC mul_p+3
.doubled
    ASL mul_p : ROL mul_p+1 : ROL mul_p+2 : ROL mul_p+3
.rounded
    \ bytes 1-3: |X0 A_z| / 128, rounded down if the product's positive
    \ and up if it's negative, as the 68000's shifts would round it
    LDX term
    LDA xf_asign,X : ZA_INDEXEDBY 0..5
    STA d
    TXA : ASL A : TAX
    LDA xf_amag,X : ZA_INDEXEDBY 0..10
    STA d24 : LDA xf_amag+1,X : ZA_INDEXEDBY 0..10
    STA d24+1 : STZ d24+2
    BIT d : BPL a_pos
    LDA #0 : SEC : SBC d24 : STA d24 : LDA #0 : SBC d24+1 : STA d24+1 : LDA #0 : SBC #0 : STA d24+2
.a_pos
    BIT pneg : BMI add
    LDA d24 : SEC : SBC mul_p+1 : STA d24
    LDA d24+1 : SBC mul_p+2 : STA d24+1
    LDA d24+2 : SBC mul_p+3 : STA d24+2
    BRA got_d
.add
    LDA d24 : CLC : ADC mul_p+1 : STA d24
    LDA d24+1 : ADC mul_p+2 : STA d24+1
    LDA d24+2 : ADC mul_p+3 : STA d24+2
.got_d
    \ |B| = 128 |d| / tz, |d| halved (and |B| doubled) until it's below
    \ 2^15, as r8 takes it; B's sign is d's
    LDX term
    LDA d24+2 : AND #&80 : STA sc_bsign,X : ZA_INDEXEDBY 0..5
    BPL d_pos
    LDA #0 : SEC : SBC d24 : STA d24
    LDA #0 : SBC d24+1 : STA d24+1
    LDA #0 : SBC d24+2 : STA d24+2
.d_pos
    LDX #0
.fit
    LDA d24+2 : BNE halve
    BIT d24+1 : BPL fits
.halve
    LSR d24+2 : ROR d24+1 : ROR d24
    INX
    BRA fit
.fits
    STX halved
    MOVW px, d24
    JSR proj_x.r8
    LDX halved : BEQ unhalved
.double
    ASL pq : ROL pq+1
    DEX : BNE double
.unhalved
    LDA term : ASL A : TAX
    LDA pq : STA sc_bmag,X : ZA_INDEXEDBY 0..10
    LDA pq+1 : STA sc_bmag+1,X : ZA_INDEXEDBY 0..10
.next_term
    INC term : LDA term : CMP #6 : BEQ terms_done
    JMP each_term
.terms_done
    JMP screen_setup
\ A_z's term, 6 + j, by B's term
.a_z
    EQUB 6, 7, 8, 6, 7, 8
}

\ edges_far: each marked edge of a far object, the last first, its
\ vertices straight onto the screen; clipped to the window only if the
\ object reaches past it.
.edges_far
{
    LDA sh_nedges : STA edge_i
    \ each edge to the window's clip, or past it if the object's inside
    LDA #LO(clip_line.ends) : LDX #HI(clip_line.ends)
    BIT far_inside : BPL patch
    LDA #LO(clip_line.ends_in) : LDX #HI(clip_line.ends_in)
.patch
    STA call+1 : STX call+2
.each
    LDY edge_i : BNE test
    RTS
.test
    DEY : STY edge_i
    LDA edge_mark,Y : CMP stamp : BNE each
    LDA (sh_ev1),Y : STA vb
    LDA (sh_ev0),Y : STA va
    \ each end onto the screen if it isn't yet
    TAY : LDA vert_mark,Y : CMP stamp : BEQ a_done
    JSR vertex_far
.a_done
    LDY vb : LDA vert_mark,Y : CMP stamp : BEQ b_done
    JSR vertex_far
.b_done
    LDX va : LDY vb
.call
    JSR clip_line.ends                      ; patched: or clip_line.ends_in
    ZA_CANCALL clip_line.ends, clip_line.ends_in
    BRA each
}

\ TO_PIXELS q, centre, lo, hi: the word q, quarters of a pixel from the
\ view's centre, to pixels truncated towards zero, as the ST's divs
\ truncates (a negative q is (q + 3) >> 2), into lo and hi at Y.
MACRO TO_PIXELS q, centre, lo, hi
    LDA q+1 : BPL positive
    LDA q : CLC : ADC #3 : STA q
    LDA q+1 : ADC #0
    CMP #&80 : ROR A : ROR q
    CMP #&80 : ROR A : ROR q
    BRA shifted
.positive
    LSR A : ROR q : LSR A : ROR q
.shifted
    TAX
    LDA q : CLC : ADC #LO(centre) : STA lo,Y
    TXA : ADC #HI(centre) : STA hi,Y
ENDMACRO

\ VERTEX_CODE: A = the window's outcode of vertex Y on the screen (v_sx,
\ v_sy), as OUTCODE makes it; X is lost. Its edges are patched
\ (CLIP_SITES), at the offsets VC_* from its first byte, which it asserts.
MACRO VERTEX_CODE
.start
    LDA v_sxhi,Y : BNE x_high
    LDA v_sxlo,Y
.xmin
    CMP #VIEW_XMIN
    LDA #0
.low
    BCS x_done                              ; (to low_right in a window below x 256)
    BCC x_left
.x_high
    BMI x_left
.xhi
    CMP #HI(VIEW_XMAX + 1) : BNE x_right
.low_right
    LDA v_sxlo,Y
.xlo
    CMP #LO(VIEW_XMAX + 1)
    LDA #0 : BCC x_done
.x_right
    LDA #8 : BRA x_done
.x_left
    LDA #2
.x_done
    LDX v_syhi,Y : BNE y_high
    LDX v_sylo,Y
.ymin
    CPX #VIEW_YMIN : BCC y_above
.ymax
    CPX #VIEW_YMAX + 1 : BCC y_done
.y_below
    ORA #4 : BRA y_done
.y_high
    BPL y_below
.y_above
    ORA #1
.y_done
    ASSERT xmin + 1 - start = VC_XMIN AND low + 1 - start = VC_LOW AND xhi + 1 - start = VC_XHI
    ASSERT xlo + 1 - start = VC_XLO AND ymin + 1 - start = VC_YMIN AND ymax + 1 - start = VC_YMAX
    ASSERT x_done - (low + 2) = VC_TO_DONE AND low_right - (low + 2) = VC_TO_RIGHT
ENDMACRO
VC_XMIN = 9 : VC_LOW = 13 : VC_XHI = 19 : VC_XLO = 26 : VC_YMIN = 46 : VC_YMAX = 50
VC_TO_DONE = 23 : VC_TO_RIGHT = 8

\ BOX_Y: the object's box (decision 20: box.6502's box_end, and zp.6502's
\ box_c0 to box_codes) taken to A, a line within the window. BOX_VERTEX:
\ to vertex Y, within the window, its line here and its column by box_x.
MACRO BOX_Y
    CMP box_y0 : BCS low_in
    STA box_y0
.low_in
    CMP box_y1 : BCC high_in
    STA box_y1
.high_in
ENDMACRO
MACRO BOX_VERTEX
    LDA v_sylo,Y
    BOX_Y
    JMP box_x
ENDMACRO
\ (box_out, for a vertex past the window, and box_x are in the shapes'
\ bank, which the vertices run with: shapecode.6502.)

\ vertex_far: vertex Y of a far object onto the screen, and its outcode
\ unless the object is inside the window; the caller makes it once an
\ object, by its mark. It goes into the object's box.
.vertex_far
{
    ZA_AUTO1 vtx
    LDA stamp : STA vert_mark,Y
    STY vtx
    CPY sh_nstill : BCS moving
    LDA (sh_vx),Y : EOR #&80 : STA xf_u
    LDA (sh_vy),Y : EOR #&80 : STA xf_u+1
    LDA (sh_vz),Y : EOR #&80 : STA xf_u+2
    BRA got
.moving
    LDA (fr_vx),Y : EOR #&80 : STA xf_u
    LDA (fr_vy),Y : EOR #&80 : STA xf_u+1
    LDA (fr_vz),Y : EOR #&80 : STA xf_u+2
.got
.screen
    JMP screen_vertex                       ; or screen8_vertex (screen_setup's), back to back
    ZA_CANJUMP screen_vertex, screen8_vertex
.back
    LDY vtx                                 ; from the centre's quarters
    TO_PIXELS sc_acc, VIEW_CX, v_sxlo, v_sxhi
    TO_PIXELS sc_acc+2, VIEW_CY, v_sylo, v_syhi
    BIT far_inside : BMI inside
.code
    VERTEX_CODE : STA v_code,Y
    TAX : BEQ inside                        ; (VERTEX_CODE leaves Z its last test's)
    JMP box_out
.inside
    BOX_VERTEX
}

\ faces: each face's edges marked if it's visible: always-visible, or the
\ camera on its outer side, n.c > 4K.
\
\ dot = 4K - n.c is made in two passes, by |c|'s high bytes then its low.
\ The low pass changes dot by at most 127 (l_x + l_y + l_z), l being
\ |c|'s low bytes, which is under 256 E (E = (l_x + l_y + l_z + 1) / 2):
\ so with the high pass's top two bytes D, D >= E is a face not visible,
\ and D + E < 0 one visible, without the low pass. That's tested only
\ when D can't pass a word (|c| < 16384 on every axis) and |c| isn't
\ under 512 on every axis, where it seldom settles a face.
.faces
{
    ZA_AUTO1 face_i, last
    ZA_AUTO 3, nrm              ; the face's normal, x y z ...
    ZA_AUTO 3, nmag             ; ... and its magnitudes
    ZA_AUTO 3, dot
    ZA_AUTO2 pp
    ZA_AUTO2 epos, eneg         ; E, -E
    LDA sh_elists : STA mark_edge+1 : LDA sh_elists+1 : STA mark_edge+2
    \ each axis's products by its |c|'s bytes (faceterm.6502)
    LDA objc_mag : STA fxl.lo_a+1 : STA fxl.lo_c+1 : EOR #&FF : STA fxl.lo_b+1 : STA fxl.lo_d+1
    LDA objc_mag+1 : STA fxh.hi_a+1 : STA fxh.hi_c+1 : EOR #&FF : STA fxh.hi_b+1 : STA fxh.hi_d+1
    LDA objc_mag+2 : STA fyl.lo_a+1 : STA fyl.lo_c+1 : EOR #&FF : STA fyl.lo_b+1 : STA fyl.lo_d+1
    LDA objc_mag+3 : STA fyh.hi_a+1 : STA fyh.hi_c+1 : EOR #&FF : STA fyh.hi_b+1 : STA fyh.hi_d+1
    LDA objc_mag+4 : STA fzl.lo_a+1 : STA fzl.lo_c+1 : EOR #&FF : STA fzl.lo_b+1 : STA fzl.lo_d+1
    LDA objc_mag+5 : STA fzh.hi_a+1 : STA fzh.hi_c+1 : EOR #&FF : STA fzh.hi_b+1 : STA fzh.hi_d+1
    \ the high pass to settle faces, or not
    LDX #BRA_OP
    LDA objc_mag+1 : ORA objc_mag+3 : ORA objc_mag+5
    CMP #64 : BCS settling              ; some |c| >= 16384
    CMP #2 : BCC settling               ; every |c| < 512
    LDX #LDA_IMM
    \ E = (l_x + l_y + l_z + 1) / 2
    LDA objc_mag : SEC : ADC objc_mag+2 : STA epos
    LDA #0 : ROL A : STA epos+1
    LDA epos : CLC : ADC objc_mag+4 : STA epos
    BCC e_sum
    INC epos+1
.e_sum
    LSR epos+1 : ROR epos
    LDA #0 : SEC : SBC epos : STA eneg
    LDA #0 : SBC epos+1 : STA eneg+1
.settling
    STX settle_k
    LDA sh_nfaces : STA face_i
.next
    LDY face_i : BNE test               ; the last first
    RTS
.test
    DEY : STY face_i
    LDA (sh_fflags),Y : ORA all_faces : BPL tested
    JMP visible
.tested
    CPY sh_nrigid : BCS turning
    LDA (sh_nx),Y : STA nrm : LDA (sh_ny),Y : STA nrm+1 : LDA (sh_nz),Y : STA nrm+2
    BRA normal
.turning
    LDA (fr_nx),Y : STA nrm : LDA (fr_ny),Y : STA nrm+1 : LDA (fr_nz),Y : STA nrm+2
.normal
    \ dot = 4K - n.c, 24 bits: negative if the face is visible (as n.c - 4K
    \ > 0 is, but for -2^23, far beyond any object near enough to draw)
    LDA (fr_khi),Y : BMI k_neg
    STA dot+1 : STZ dot+2
    \ K >= 0: not visible unless some product n c is positive
    LDA nrm : BEQ y_sign : EOR objc_sign : BPL k_low
.y_sign
    LDA nrm+1 : BEQ z_sign : EOR objc_sign+1 : BPL k_low
.z_sign
    LDA nrm+2 : BEQ next : EOR objc_sign+2 : BMI next
    BRA k_low
.k_neg
    STA dot+1 : LDA #&FF : STA dot+2
.k_low
    LDA (fr_klo),Y
    ASL A : ROL dot+1 : ROL dot+2
    ASL A : ROL dot+1 : ROL dot+2
    STA dot
    \ each component's |n| |c| taken away, or added if n c is negative:
    \ by |c|'s high bytes ...
.fxh
{
    AXIS = 0 : HIGH = TRUE
    INCLUDE "faceterm.6502"
}
.fyh
{
    AXIS = 1 : HIGH = TRUE
    INCLUDE "faceterm.6502"
}
.fzh
{
    AXIS = 2 : HIGH = TRUE
    INCLUDE "faceterm.6502"
}
    \ ... settled by them, if they can (settle_k: LDA # to try, BRA not to)
.settle_k
    BRA low
    ZA_CANJUMP low, settle
.settle
    LDA dot+1 : CLC : ADC eneg
    LDA dot+2 : ADC eneg+1 : BMI not_out
    JMP next                            ; D >= E
.not_out
    LDA dot+1 : CLC : ADC epos
    LDA dot+2 : ADC epos+1 : BPL low
    JMP visible                         ; D + E < 0
.low
    \ ... and by the low
.fxl
{
    AXIS = 0 : HIGH = FALSE
    INCLUDE "faceterm.6502"
}
.fyl
{
    AXIS = 1 : HIGH = FALSE
    INCLUDE "faceterm.6502"
}
.fzl
{
    AXIS = 2 : HIGH = FALSE
    INCLUDE "faceterm.6502"
}
    LDA dot+2 : BMI visible
    JMP next
.visible
    \ its edge list: a count, then the edges
    LDY face_i
    LDA (sh_fedges),Y : TAY
    CLC : ADC (sh_elists),Y : STA last
    LDA stamp
.mark
    INY
.mark_edge
    LDX &8000,Y                         ; patched: sh_elists
    STA edge_mark,X
    CPY last : BNE mark
    JMP next
}

\ edges (&04D16): each marked edge, the last first, its vertices
\ transformed as needed.
.edges
{
    LDA sh_nedges : STA edge_i
.each
    LDY edge_i : BNE test
    RTS
.test
    DEY : STY edge_i
    LDA edge_mark,Y : CMP stamp : BNE each
    LDA (sh_ev1),Y : STA vb
    LDA (sh_ev0),Y : STA va
    \ each end transformed if it isn't yet
    TAY : LDA vert_mark,Y : CMP stamp : BEQ a_done
    JSR vertex
.a_done
    LDY vb : LDA vert_mark,Y : CMP stamp : BEQ b_done
    JSR vertex
.b_done
    LDX va : LDY vb
.call
    JSR edge                                ; patched (draw_shape): or clip_line.ends
    ZA_CANCALL edge, clip_line.ends
    BRA each
}

\ vertex: vertex Y of the shape into camera space (&03FFE) and, in front
\ of the near plane, projected, with its outcode, into the object's box;
\ the caller makes it once an object, by its mark.
.vertex
{
    ZA_AUTO1 vtx
    LDA stamp : STA vert_mark,Y
    STY vtx
    CPY sh_nstill : BCS moving
    LDA (sh_vx),Y : EOR #&80 : STA xf_u
    LDA (sh_vy),Y : EOR #&80 : STA xf_u+1
    LDA (sh_vz),Y : EOR #&80 : STA xf_u+2
    BRA got
.moving
    LDA (fr_vx),Y : EOR #&80 : STA xf_u
    LDA (fr_vy),Y : EOR #&80 : STA xf_u+1
    LDA (fr_vz),Y : EOR #&80 : STA xf_u+2
.got
    JMP xform_vertex                        ; back to back, folded or in_front (xform_back)
.back
    \ the sums px, xf_y, pz into world units, the object's position added
    \ (only where it can't be folded in, seldom: so in a loop)
    LDX #4
.add_t
    LDA xf_sum+1,X : ZA_INDEXEDBY {0, 2, 4}
    CMP #&80 : ROR A
    ROR xf_sum,X : ZA_INDEXEDBY {0, 2, 4}
    CMP #&80 : ROR A
    ROR xf_sum,X : ZA_INDEXEDBY {0, 2, 4}
    TAY
    LDA xf_sum,X : ZA_INDEXEDBY {0, 2, 4}
    CLC : ADC tpos,X : ZA_INDEXEDBY {0, 2, 4}
    STA xf_sum,X : ZA_INDEXEDBY {0, 2, 4}
    TYA : ADC tpos+1,X : ZA_INDEXEDBY {0, 2, 4}
    STA xf_sum+1,X : ZA_INDEXEDBY {0, 2, 4}
    DEX : DEX : BPL add_t
    LDY vtx
    LDA px : STA v_xlo,Y : LDA px+1 : STA v_xhi,Y
    LDA xf_y : STA v_ylo,Y : LDA xf_y+1 : STA v_yhi,Y
    LDA pz : STA v_zlo,Y : LDA pz+1 : STA v_zhi,Y
    BRA tested
.folded
    \ the same, the object's position in them from the start
    LDY vtx
    WORLD_FOLDED px, v_xlo, v_xhi
    WORLD_FOLDED xf_y, v_ylo, v_yhi
    WORLD_FOLDED pz, v_zlo, v_zhi
    LDA pz+1
.tested
    \ behind the near plane if z < NEAR_Z (a byte), from z's high byte
    ASSERT NEAR_Z < 256
    BMI behind
    BNE front
    LDA pz : CMP #NEAR_Z : BCS front
.behind
    RTS
.in_front
    \ the same for an object wholly in front of the near plane: no z to
    \ test, and no position for edge to keep
    WORLD_SHIFT px
    WORLD_SHIFT xf_y
    WORLD_SHIFT pz
.front
    JSR proj_z
    JSR proj_x
    LDY vtx
    LDA pq : CLC : ADC #LO(VIEW_CX) : STA v_sxlo,Y
    LDA pq+1 : ADC #HI(VIEW_CX) : STA v_sxhi,Y
    MOVW px, xf_y : JSR proj_x
    LDY vtx
    LDA pq : CLC : ADC #LO(VIEW_CY) : STA v_sylo,Y
    LDA pq+1 : ADC #HI(VIEW_CY) : STA v_syhi,Y
.code
    VERTEX_CODE : STA v_code,Y
.track
    TAX                                     ; patched (draw_shape): RTS, for an object with no box
    BEQ inside                              ; (VERTEX_CODE leaves Z its last test's)
    JMP box_out
.inside
    BOX_VERTEX
}

\ proj_z: ready proj_x for the depth pz (2 or more): the reciprocal's
\ bytes patched into proj_x's reads, and its shift S (recip.6502) as
\ where proj_x jumps to make it.
.proj_z
{
    ZA_AUTO1 m
    LDA pz+1 : BNE big
    LDX pz
    LDY zsmall_idx,X
    LDA zsmall_sh,X : TAX
    LDA proj_x.shift_lo-10,X : STA proj_x.shift+1
    LDA proj_x.shift_hi-10,X : STA proj_x.shift+2
    BRA exact
.big
    TAX
    LDY zhigh_sh,X                          ; S = 17 + Y
    LDA proj_x.shift_lo+7,Y : STA proj_x.shift+1
    LDA proj_x.shift_hi+7,Y : STA proj_x.shift+2
    LDA pz : STA m
    LDA pz+1
    CPY #0 : BEQ shifted
.shift
    LSR A : ROR m
    DEY : BNE shift
    LDY m
    LDA rcp_lo,Y : LDX rcp_hi,Y
    BRA got
.shifted
    LDY m
.exact
    LDA rcpx_lo,Y : LDX rcpx_hi,Y
.got
    \ A, X: R's low and high bytes
    STA proj_x.a+1 : STA proj_x.g+1 : STA proj_x.i+1
    EOR #&FF
    STA proj_x.b+1 : STA proj_x.h+1 : STA proj_x.j+1
    TXA
    STA proj_x.c+1 : STA proj_x.e+1 : STA proj_x.k+1 : STA proj_x.m+1
    EOR #&FF
    STA proj_x.d+1 : STA proj_x.f+1 : STA proj_x.l+1 : STA proj_x.n+1
    RTS
}

\ proj_x: pq = 128 px / pz, truncated towards zero, from proj_z's
\ reciprocal: |x| R >> S. Where the ST's divs overflows (z < 256 and
\ |x| >= 256 z) it's the ST's result instead, the low word of x << 7.
.proj_x
{
    ZA_AUTO1 xl, xh, u0, u1, w0, p1
    LDA px+1 : BPL pos
    LDA #0 : SEC : SBC px : STA xl
    LDA #0 : SBC px+1 : STA xh
    BRA magnitude
.pos
    STA xh : LDA px : STA xl
    ORA xh : BEQ zero
.magnitude
    LDA pz+1 : BNE fits
    LDA xh : CMP pz : BCC fits
    LDA px+1 : LSR A : LDA px : ROR A : STA pq+1
    LDA #0 : ROR A : STA pq
    RTS
.zero
    STZ pq : STZ pq+1
    RTS
.fits
    \ |x| R >> 8 into A:pq:p1: x's low byte by R's high byte and by its low
    \ byte (that one's high byte only), then x's high byte by R, if it
    \ isn't zero. Each product's high byte leaves C set, as a product
    \ isn't negative.
    LDY xl
    SEC
.c  LDA sqr_lo,Y
.d  SBC neg_lo,Y
    STA p1
.e  LDA sqr_hi,Y
.f  SBC neg_hi,Y
    STA pq
.a  LDA sqr_hi,Y
.b  SBC neg_hi,Y
    \ that + p1, carrying into pq (a product's high byte, below 255)
    CLC : ADC p1 : STA p1
    BCC c1
    INC pq
.c1
    LDY xh : BNE high
    TYA
    JMP (shift+1)                           ; (BRA shift's cycles, but none for a page)
    ZA_CANJUMP right24_2, right24_3, right24_4, left24_3, left24_2, left24_1, right0, right16_1, right16_2, right16_3, right16_4, right16_5, left16_2, left16_1
.high
    SEC
.g  LDA sqr_lo,Y
.h  SBC neg_lo,Y
    STA u0
.i  LDA sqr_hi,Y
.j  SBC neg_hi,Y
    STA u1
.k  LDA sqr_lo,Y
.l  SBC neg_lo,Y
    STA w0
.m  LDA sqr_hi,Y
.n  SBC neg_hi,Y
    TAX
    \ p1 + u0, carrying into pq + u1 + w0, carrying into X
    CLC : LDA p1 : ADC u0 : STA p1
    LDA pq : ADC u1
    BCC c2
    INX
    CLC
.c2
    ADC w0 : STA pq
    BCC c3
    INX
.c3
    TXA
    \ >> S, unrolled: each S has its own way in (shift_lo, shift_hi),
    \ which shifts A:pq:p1 left or right, whichever is fewer bits
.shift
    JMP right0                              ; patched by proj_z
    ZA_CANJUMP right24_2, right24_3, right24_4, left24_3, left24_2, left24_1, right0, right16_1, right16_2, right16_3, right16_4, right16_5, left16_2, left16_1
\ S = 10-12: right 2-4, the low word
.right24_4
    LSR A : ROR pq : ROR p1
.right24_3
    LSR A : ROR pq : ROR p1
.right24_2
    LSR A : ROR pq : ROR p1
    LSR A : ROR pq : ROR p1
    LDA pq : STA pq+1 : LDA p1 : STA pq
    BRA sign
\ S = 13-15: left 3-1, the middle word
.left24_3
    ASL p1 : ROL pq : ROL A
.left24_2
    ASL p1 : ROL pq : ROL A
.left24_1
    ASL p1 : ROL pq : ROL A
    STA pq+1
    BRA sign
\ S = 22, 23: left 2, 1, the high word
.left16_2
    STZ pq+1
    ASL pq : ROL A : ROL pq+1
    ASL pq : ROL A : ROL pq+1
    STA pq
    BRA sign
.left16_1
    STZ pq+1
    ASL pq : ROL A : ROL pq+1
    STA pq
    BRA sign
\ S = 16-21: right 0-5, the high word
.right16_5
    LSR A : ROR pq
.right16_4
    LSR A : ROR pq
.right16_3
    LSR A : ROR pq
.right16_2
    LSR A : ROR pq
.right16_1
    LSR A : ROR pq
.right0
    STA pq+1
.sign
    BIT px+1 : BPL done
    LDA #0 : SEC : SBC pq : STA pq
    LDA #0 : SBC pq+1 : STA pq+1
.done
    RTS
\ r8: pq = 128 px / pz for px from 0 to 32767 and pz from 128, from R's
\ high byte alone (decision 22): px R_hi >> (S - 8), for far_setup's B,
\ which patches R_hi in. From S = 16 the shifts read A:pq alone, not p1.
.r8
    ZA_DISCARD p1
    LDY px
    SEC
.ra LDA sqr_hi,Y
.rb SBC neg_hi,Y
    STA pq                                  ; px's low byte by R_hi, its high byte
    LDY px+1 : BEQ r8_low
    SEC
.rc LDA sqr_lo,Y
.rd SBC neg_lo,Y
    TAX
.re LDA sqr_hi,Y
.rf SBC neg_hi,Y                            ; px's high byte by R_hi
    STA u1
    TXA : CLC : ADC pq : STA pq
    LDA u1 : ADC #0
    JMP shift
.r8_low
    TYA
    JMP shift
\ the ways in, by S from 10
.shift_lo
    EQUB LO(right24_2), LO(right24_3), LO(right24_4), LO(left24_3), LO(left24_2), LO(left24_1)
    EQUB LO(right0), LO(right16_1), LO(right16_2), LO(right16_3), LO(right16_4), LO(right16_5)
    EQUB LO(left16_2), LO(left16_1)
.shift_hi
    EQUB HI(right24_2), HI(right24_3), HI(right24_4), HI(left24_3), HI(left24_2), HI(left24_1)
    EQUB HI(right0), HI(right16_1), HI(right16_2), HI(right16_3), HI(right16_4), HI(right16_5)
    EQUB HI(left16_2), HI(left16_1)
}

\ edge (&04D66): the edge from vertex va to vb, clipped at z = 2 if it
\ crosses the plane, projected and clipped to the window.
ASSERT NEAR_Z > 0 AND NEAR_Z < 256
.edge
{
    \ each end (X, Y: va, vb) in front if z >= NEAR_Z, which its high byte
    \ mostly settles
    LDA v_zhi,X : BMI p_behind : BNE p_front
    LDA v_zlo,X : CMP #NEAR_Z : BCC p_behind
.p_front
    LDA v_zhi,Y : BMI crosses : BNE in_front
    LDA v_zlo,Y : CMP #NEAR_Z : BCS in_front
    BRA crosses
.p_behind
    LDA v_zhi,Y : BMI both_behind : BNE crosses
    LDA v_zlo,Y : CMP #NEAR_Z : BCS crosses
.both_behind
    RTS
.in_front
    JMP clip_line.ends
.crosses
    LDA v_zlo,X : STA ep+4 : LDA v_zhi,X : STA ep+5
    LDA v_zlo,Y : STA eq+4 : LDA v_zhi,Y : STA eq+5
    LDA v_xlo,X : STA ep : LDA v_xhi,X : STA ep+1
    LDA v_ylo,X : STA ep+2 : LDA v_yhi,X : STA ep+3
    LDA v_xlo,Y : STA eq : LDA v_xhi,Y : STA eq+1
    LDA v_ylo,Y : STA eq+2 : LDA v_yhi,Y : STA eq+3
    JSR clip_near
    MOVW pz, ep+4 : JSR proj_z
    MOVW px, ep : JSR proj_x
    LDA pq : CLC : ADC #LO(VIEW_CX) : STA cx0 : LDA pq+1 : ADC #HI(VIEW_CX) : STA cx0+1
    MOVW px, ep+2 : JSR proj_x
    LDA pq : CLC : ADC #LO(VIEW_CY) : STA cy0 : LDA pq+1 : ADC #HI(VIEW_CY) : STA cy0+1
    MOVW pz, eq+4 : JSR proj_z
    MOVW px, eq : JSR proj_x
    LDA pq : CLC : ADC #LO(VIEW_CX) : STA cx1 : LDA pq+1 : ADC #HI(VIEW_CX) : STA cx1+1
    MOVW px, eq+2 : JSR proj_x
    LDA pq : CLC : ADC #LO(VIEW_CY) : STA cy1 : LDA pq+1 : ADC #HI(VIEW_CY) : STA cy1+1
    JMP clip_line
}

\ clip_near (&0A374): ep and eq (x, y, z words), one behind z = 2. The
\ ST's arithmetic exactly: when eq is the one behind they're swapped, and
\ stay so; the fraction is (2 - z) << 16 over the edge's dz, a 16-bit
\ quotient used as if it had 15 bits, and 0 when divs overflows.
.clip_near
{
    ZA_AUTO1 row_i
.again
    CMPS16 ep+4, #NEAR_Z : BMI clip
    CMPS16 eq+4, #NEAR_Z : BMI swap
    RTS
.swap
    LDX #5
.swap1
    LDA ep,X : ZA_INDEXEDBY 0..5
    PHA
    LDA eq,X : ZA_INDEXEDBY 0..5
    STA ep,X : ZA_INDEXEDBY 0..5
    PLA : STA eq,X : ZA_INDEXEDBY 0..5
    DEX : BPL swap1
    BRA again
.clip
    STZ mul_p : STZ mul_p+1
    LDA #LO(NEAR_Z) : SEC : SBC ep+4 : STA mul_p+2
    LDA #HI(NEAR_Z) : SBC ep+5 : STA mul_p+3
    LDA eq+4 : SEC : SBC ep+4 : STA div_d
    LDA eq+5 : SBC ep+5 : STA div_d+1
    \ When both are positive (all but where a depth is too far off for a
    \ word), divs overflows just when 2 (2 - z) >= dz: a fraction of 0,
    \ which leaves x and y as they are, so neither divs nor muls is needed.
    \ An overflow is a fraction of 0 too.
    ORA mul_p+3 : BMI divide
    LDA mul_p+2 : ASL A : TAX
    LDA mul_p+3 : ROL A : TAY
    TXA : CMP div_d : TYA : SBC div_d+1 : BCS cut
.divide
    JSR sdiv32
    BCS cut
    LDX #0
    JSR cut_axis
    LDX #2
    JSR cut_axis
.cut
    LDA #LO(NEAR_Z) : STA ep+4 : LDA #HI(NEAR_Z) : STA ep+5
    BRA again
.cut_axis
    STX row_i
    LDA eq,X : ZA_INDEXEDBY {0, 2}
    SEC : SBC ep,X : ZA_INDEXEDBY {0, 2}
    STA mul_x
    LDA eq+1,X : ZA_INDEXEDBY {0, 2}
    SBC ep+1,X : ZA_INDEXEDBY {0, 2}
    STA mul_x+1
    MOVW mul_y, div_q
    JSR smul16
    ASL mul_p+1 : ROL mul_p+2 : ROL mul_p+3
    LDX row_i
    LDA ep,X : ZA_INDEXEDBY {0, 2}
    CLC : ADC mul_p+2 : STA ep,X : ZA_INDEXEDBY {0, 2}
    LDA ep+1,X : ZA_INDEXEDBY {0, 2}
    ADC mul_p+3 : STA ep+1,X : ZA_INDEXEDBY {0, 2}
    RTS
}

\ OUTCODE x, y: A = the window's outcode of the point (x, y), words: 8
\ right, 4 below, 2 left, 1 above (&0A174). Y is lost. The window's left
\ edge and its y lie in their low bytes, so a high byte settles most
\ points alone. Its edges are patched (CLIP_SITES), at the offsets OC_*
\ from its first byte, which it asserts: the view's right edge lies in x's
\ high byte 1, the missile view's in 0, where low's branch goes on to
\ low_right.
MACRO OUTCODE x, y
.start
    LDA x+1 : BNE x_high
    LDA x
.xmin
    CMP #VIEW_XMIN
    LDA #0
.low
    BCS x_done                              ; (to low_right in a window below x 256)
    BCC x_left
.x_high
    BMI x_left
.xhi
    CMP #HI(VIEW_XMAX + 1) : BNE x_right
.low_right
    LDA x
.xlo
    CMP #LO(VIEW_XMAX + 1)
    LDA #0 : BCC x_done
.x_right
    LDA #8 : BRA x_done
.x_left
    LDA #2
.x_done
    LDY y+1 : BNE y_high
    LDY y
.ymin
    CPY #VIEW_YMIN : BCC y_above
.ymax
    CPY #VIEW_YMAX + 1 : BCC y_done
.y_below
    ORA #4 : BRA y_done
.y_high
    BPL y_below
.y_above
    ORA #1
.y_done
    ASSERT xmin + 1 - start = OC_XMIN AND low + 1 - start = OC_LOW AND xhi + 1 - start = OC_XHI
    ASSERT xlo + 1 - start = OC_XLO AND ymin + 1 - start = OC_YMIN AND ymax + 1 - start = OC_YMAX
    ASSERT x_done - (low + 2) = OC_TO_DONE AND low_right - (low + 2) = OC_TO_RIGHT
ENDMACRO
OC_XMIN = 7 : OC_LOW = 11 : OC_XHI = 17 : OC_XLO = 23 : OC_YMIN = 41 : OC_YMAX = 45
OC_TO_DONE = 22 : OC_TO_RIGHT = 8

\ BYTE_MAG w, far: A = |w| if it's under 256, and otherwise to far.
MACRO BYTE_MAG w, far
    LDA w+1 : BEQ positive
    INC A : BNE far                     ; the high byte wasn't &FF
    SEC : SBC w : BEQ far               ; -256 is too far
    BRA done
.positive
    LDA w
.done
ENDMACRO

\ clip_line (&0A170): Cohen-Sutherland to the window, as the ST clips: a
\ vertical or horizontal line is clamped; otherwise point 0 is cut, the
\ points swapped first (and left so) when point 0 is inside. Then the line
\ is logged and drawn. cx0, cy0, cx1, cy1 are consecutive words.
.clip_line
{
    ZA_AUTO1 code0, code1
    ZA_AUTO2 edge                       ; the window's edge a cut is to
    ZA_AUTO2 num                        ; muldiv's product, then quotient
    ZA_AUTO1 den                        ; ... and its divisor
.again
    OUTCODE cx1, cy1 : STA code1
.again0                                 ; only point 0 moved
    OUTCODE cx0, cy0 : STA code0
    ORA code1 : BNE outside
    JMP accept
.outside
    LDA code0 : AND code1 : BEQ crossing
    RTS
\ ends: the edge from vertex X to vertex Y, both on the screen, by their
\ outcodes (v_code): nothing if both are beyond one of the window's edges,
\ drawn as it is if both are inside (ends_in), and otherwise clipped. Only
\ a line clipped needs its ends' y high bytes.
.ends
    LDA v_code,X : AND v_code,Y : BNE ends_out
    LDA v_code,X : ORA v_code,Y : BNE ends_clip
.ends_in
    LDA v_sxlo,X : STA cx0 : LDA v_sxhi,X : STA cx0+1
    LDA v_sylo,X : STA cy0
    LDA v_sxlo,Y : STA cx1 : LDA v_sxhi,Y : STA cx1+1
    LDA v_sylo,Y : STA cy1
    JMP accept
.ends_out
    RTS
.ends_clip
    LDA v_code,X : STA code0 : LDA v_code,Y : STA code1
    LDA v_sxlo,X : STA cx0 : LDA v_sxhi,X : STA cx0+1
    LDA v_sylo,X : STA cy0 : LDA v_syhi,X : STA cy0+1
    LDA v_sxlo,Y : STA cx1 : LDA v_sxhi,Y : STA cx1+1
    LDA v_sylo,Y : STA cy1 : LDA v_syhi,Y : STA cy1+1
.crossing
    LDA cx1 : CMP cx0 : BNE not_vertical
    LDA cx1+1 : CMP cx0+1 : BNE not_vertical
    LDX #cy0 - clip_pts : JSR clamp_y
    LDX #cy1 - clip_pts : JSR clamp_y
    JMP again
.not_vertical
    LDA cy1 : CMP cy0 : BNE slanted
    LDA cy1+1 : CMP cy0+1 : BNE slanted
    LDX #cx0 - clip_pts : JSR clamp_x
    LDX #cx1 - clip_pts : JSR clamp_x
    JMP again
.slanted
    LDA code0 : BNE cut
    LDX #3
.swap
    LDA clip_pts,X : ZA_INDEXEDBY 0..3
    LDY clip_pts+4,X : ZA_INDEXEDBY 0..3
    STA clip_pts+4,X : ZA_INDEXEDBY 0..3
    STY clip_pts,X : ZA_INDEXEDBY 0..3
    DEX : BPL swap
    LDA code1 : STA code0
    STZ code1                           ; point 1 is now the one inside
.cut
    \ the window's first edge that point 0 is outside: above, left, below,
    \ right, by code0's bits from the bottom (each patched: CLIP_SITES)
    LSR code0 : BCC not_top
.edge_top
    LDA #VIEW_YMIN : BRA cut_y
.not_top
    LSR code0 : BCC not_left
.edge_left
    LDX #LO(VIEW_XMIN) : LDA #HI(VIEW_XMIN) : BRA cut_x
.not_left
    LSR code0 : BCC not_bottom
.edge_bottom
    LDA #VIEW_YMAX : BRA cut_y
.not_bottom
.edge_right
    LDX #LO(VIEW_XMAX)
.edge_right_hi
    LDA #HI(VIEW_XMAX)
.cut_x
    \ y0 += (edge - x0)(y1 - y0) / (x1 - x0), x0 = edge
    STX edge : STA edge+1
    TXA : SEC : SBC cx0 : STA mul_x : LDA edge+1 : SBC cx0+1 : STA mul_x+1
    JSR dy_dx
    ADDW cy0, pq
    MOVW cx0, edge
    JMP again0
.cut_y
    \ x0 += (edge - y0)(x1 - x0) / (y1 - y0), y0 = edge
    STA edge
    SEC : SBC cy0 : STA mul_x : LDA #0 : SBC cy0+1 : STA mul_x+1
    JSR dx_dy
    ADDW cx0, pq
    LDA edge : STA cy0 : STZ cy0+1
    JMP again0
\ dx_dy, dy_dx: pq = mul_x (x1 - x0) / (y1 - y0), or with x and y the
\ other way: muls then divs, and on overflow the product's low word.
.dx_dy
    LDA cx1 : SEC : SBC cx0 : STA mul_y : LDA cx1+1 : SBC cx0+1 : STA mul_y+1
    LDA cy1 : SEC : SBC cy0 : STA div_d : LDA cy1+1 : SBC cy0+1 : STA div_d+1
    BRA muldiv
.dy_dx
    LDA cy1 : SEC : SBC cy0 : STA mul_y : LDA cy1+1 : SBC cy0+1 : STA mul_y+1
    LDA cx1 : SEC : SBC cx0 : STA div_d : LDA cx1+1 : SBC cx0+1 : STA div_d+1
    BRA muldiv
.by_words
    JSR smul16
    JSR sdiv32
    BCS overflow
    MOVW pq, div_q
    RTS
.overflow
    MOVW pq, mul_p
    RTS
\ muldiv: mul_x mul_y / div_d as muls and divs make it. In nearly every
\ cut all three are within a byte, and as |mul_x| <= |div_d| the quotient
\ is too: then it's worked in bytes, a product and 8 steps of division.
.muldiv
    BYTE_MAG mul_x, by_words : MUL_SET
    BYTE_MAG mul_y, by_words : TAY
    MUL8 num : STA num+1
    BYTE_MAG div_d, by_words : STA den
    LDA num+1 : CMP den : BCS by_words  ; more than 8 bits
    LDX #8
.step
    ASL num : ROL A : BCS step_sub      ; num's top bit into the remainder
    CMP den : BCC step_next
.step_sub
    SBC den : INC num                   ; C = 1: a quotient bit
.step_next
    DEX : BNE step
    \ truncated towards zero, so the sign follows
    LDY #0
    LDA mul_x+1 : EOR mul_y+1 : EOR div_d+1 : BPL signed
    LDA #0 : SEC : SBC num : STA num
    BEQ signed
    DEY
.signed
    LDA num : STA pq : STY pq+1
    RTS
\ clamp_y, clamp_x: the word at clip_pts + X into the window's y or x
\ range, below first (&0A2F8, &0A330). The edges are patched (CLIP_SITES),
\ and in a window below x 256, x_byte's branch goes on to byte_right.
.clamp_y
    LDA clip_pts+1,X : ZA_INDEXEDBY {2, 6}
    BMI y_low : BNE y_high
    LDA clip_pts,X : ZA_INDEXEDBY {2, 6}
.y_min
    CMP #VIEW_YMIN : BCC y_low
.y_max
    CMP #VIEW_YMAX + 1 : BCC clamped
.y_high
    LDA #VIEW_YMAX
    BRA y_set
.y_low
    LDA #VIEW_YMIN
.y_set
    STA clip_pts,X : ZA_INDEXEDBY {2, 6}
    STZ clip_pts+1,X : ZA_INDEXEDBY {2, 6}
.clamped
    RTS
.clamp_x
    LDA clip_pts+1,X : ZA_INDEXEDBY {0, 4}
    BMI x_low : BEQ x_byte
.x_hi
    CMP #HI(VIEW_XMAX + 1) : BNE x_high
.byte_right
    LDA clip_pts,X : ZA_INDEXEDBY {0, 4}
.x_lo
    CMP #LO(VIEW_XMAX + 1) : BCC clamped
.x_high
    LDA #LO(VIEW_XMAX) : STA clip_pts,X : ZA_INDEXEDBY {0, 4}
.x_high_hi
    LDA #HI(VIEW_XMAX) : STA clip_pts+1,X : ZA_INDEXEDBY {0, 4}
    RTS
.x_byte
    LDA clip_pts,X : ZA_INDEXEDBY {0, 4}
.x_min
    CMP #VIEW_XMIN
.x_in
    BCS clamped                         ; (to byte_right in a window below x 256)
.x_low
    LDA #VIEW_XMIN : STA clip_pts,X : ZA_INDEXEDBY {0, 4}
    STZ clip_pts+1,X : ZA_INDEXEDBY {0, 4}
    RTS
.accept
IF DEFINED(SPIKE)
    \ the spike's log, for tools/scenecheck.py: slot, edge, x0, y0, x1,
    \ y1, colour
    LDA log_n : CMP #LO(LOG_LINES) : LDA log_n+1 : SBC #HI(LOG_LINES) : BCC room
    JMP draw                            ; full
.room
    LDA #BANK_LOG : STA romsel
    LDY #0
    LDA slot : STA (log_ptr),Y : INY
    LDA edge_i : STA (log_ptr),Y : INY
    LDA cx0 : STA (log_ptr),Y : INY
    LDA cx0+1 : STA (log_ptr),Y : INY
    LDA cy0 : STA (log_ptr),Y : INY
    LDA cx1 : STA (log_ptr),Y : INY
    LDA cx1+1 : STA (log_ptr),Y : INY
    LDA cy1 : STA (log_ptr),Y : INY
    LDA ocolour : STA (log_ptr),Y : INY
    LDA bank_now : STA romsel
    TYA : CLC : ADC log_ptr : STA log_ptr
    BCC logged
    INC log_ptr+1
.logged
    INC log_n : BNE counted
    INC log_n+1
.counted
ENDIF
.draw
    JMP line_plot                       ; (its ends are cx0, cy0, cx1, cy1)
}

\ ---------------------------------------------------------------------------
\ The window's clip, patched (mview.6502's clip_window): each site's
\ operand for a window, as clip_values makes them. The view's is the
\ assembled one; the missile view's is the ST's $2A0-$2A6 (&08CF4), which
\ L_05248 puts in $146-$14C while it draws, the projection's centre left
\ the view's. A window's left edge and its y lie in their low bytes, and
\ its right edge either below x 256 (then the low branches go on to the
\ right edge's test) or in the high byte 1.
MV_XMIN = &50
MV_XMAX = &EF
MV_YMIN = &10
MV_YMAX = &70
CLIP_SITES = FLATTEN({
    far_place.in_left + 1, far_place.in_right + 1, far_place.in_top + 1, far_place.in_bottom + 1,
    far_place.out_left + 1, far_place.out_right + 1, far_place.out_top + 1, far_place.out_bottom + 1,
    vertex_far.code + {VC_XMIN, VC_LOW, VC_XHI, VC_XLO, VC_YMIN, VC_YMAX},
    vertex.code + {VC_XMIN, VC_LOW, VC_XHI, VC_XLO, VC_YMIN, VC_YMAX},
    clip_line.again + {OC_XMIN, OC_LOW, OC_XHI, OC_XLO, OC_YMIN, OC_YMAX},
    clip_line.again0 + {OC_XMIN, OC_LOW, OC_XHI, OC_XLO, OC_YMIN, OC_YMAX},
    clip_line.edge_top + 1, clip_line.edge_left + 1, clip_line.edge_bottom + 1,
    clip_line.edge_right + 1, clip_line.edge_right_hi + 1,
    clip_line.y_min + 1, clip_line.y_max + 1, clip_line.y_high + 1, clip_line.y_low + 1,
    clip_line.x_hi + 1, clip_line.x_lo + 1, clip_line.x_high + 1, clip_line.x_high_hi + 1,
    clip_line.x_min + 1, clip_line.x_in + 1, clip_line.x_low + 1,
    box_end.e_top + 1, box_end.e_left + 1, box_end.e_bottom + 1, box_end.e_right + 1})
FUNCTION clip_low(x1, to_done, to_right) = LO(to_right + (x1 >= 255) * (to_done - to_right))
FUNCTION clip_values(x0, x1, y0, y1) = FLATTEN({
    REPEATED(2, {LO(x0 - VIEW_CX), LO(x1 - VIEW_CX + 1), LO(y0 - VIEW_CY), LO(y1 - VIEW_CY + 1)}),
    REPEATED(2, {x0, clip_low(x1, VC_TO_DONE, VC_TO_RIGHT), HI(x1 + 1), LO(x1 + 1), y0, y1 + 1}),
    REPEATED(2, {x0, clip_low(x1, OC_TO_DONE, OC_TO_RIGHT), HI(x1 + 1), LO(x1 + 1), y0, y1 + 1}),
    y0, LO(x0), y1, LO(x1), HI(x1),
    y0, y1 + 1, y1, y0,
    HI(x1 + 1), LO(x1 + 1), LO(x1), HI(x1),
    x0, clip_low(x1, clip_line.clamped - (clip_line.x_in + 2), clip_line.byte_right - (clip_line.x_in + 2)), x0,
    y0, x0 DIV 4, y1, x1 DIV 4})
CLIP_N = SHAPE(CLIP_SITES)[0]
ASSERT SHAPE(clip_values(VIEW_XMIN, VIEW_XMAX, VIEW_YMIN, VIEW_YMAX))[0] = CLIP_N
FOR w = {{VIEW_XMIN, VIEW_XMAX, VIEW_YMIN, VIEW_YMAX}, {MV_XMIN, MV_XMAX, MV_YMIN, MV_YMAX}}
    ASSERT w[0] < 256 AND w[2] < 256 AND w[3] < 255 AND (w[1] < 255 OR HI(w[1] + 1) = 1)
    \ (only the low bytes are patched where they're relative to the centre)
    ASSERT HI(w[0] - VIEW_CX) = HI(VIEW_XMIN - VIEW_CX) AND HI(w[1] - VIEW_CX + 1) = HI(VIEW_XMAX - VIEW_CX + 1)
    ASSERT HI(w[2] - VIEW_CY) = HI(VIEW_YMIN - VIEW_CY) AND HI(w[3] - VIEW_CY + 1) = HI(VIEW_YMAX - VIEW_CY + 1)
    \ (a box, box_end's, is whole bytes within the window)
    ASSERT w[0] MOD 4 = 0 AND w[1] MOD 4 = 3
    \ (a far object centred within the window is within FAR_C_MAX of the
    \ projection's centre, where far_reach's bound holds)
    ASSERT VIEW_CX - w[0] <= FAR_C_MAX AND w[1] - VIEW_CX <= FAR_C_MAX
    ASSERT VIEW_CY - w[2] <= FAR_C_MAX AND w[3] - VIEW_CY <= FAR_C_MAX
NEXT
