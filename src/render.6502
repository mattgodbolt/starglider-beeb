\ ***************************************************************************
\ STARGLIDER for the BBC Master - the renderer
\
\ The ST's world_render (&04FE8) from the camera to the lines: the camera
\ matrix, the coarse, near and draw lists with each object rotated into
\ camera space, then each drawn object's matrix, faces, vertices, edges,
\ near-plane clip, projection and window clip.
\
\ The camera and the lists are the world bank's (world.6502); this is the
\ drawing, from the draw list, which is approximate where it only draws
\ (decisions 1, 9, 10): tools/scenecheck.py compares every list and line
\ with tools/st_render.py.
\ ***************************************************************************

\ The window, the projection's centre and its shift: the ST's colour-mode
\ values ($146-$14C, $1FC, $1FE, $212; &08CA0).
VIEW_XMIN = 16
VIEW_XMAX = 303
VIEW_YMIN = 10
VIEW_YMAX = 128
VIEW_CX   = 143
VIEW_CY   = 68
NEAR_Z    = 2

\ ---------------------------------------------------------------------------
\ render: the frame's lists and every drawn object's lines.
\ (The spike times its phases between these labels.)
IF DEFINED(SPIKE)
.render
    STZ log_n : STZ log_n+1
    LDA log_base : STA log_ptr : LDA log_base+1 : STA log_ptr+1
    BANK BANK_WORLD
    JSR camera
.render_lists
    JSR coarse_list
    JSR rotate_lists
.render_objects
    JSR draw_phase
.render_done
    RTS
ENDIF

\ erase_init: both screens to be cleared whole before they're first drawn,
\ as if their erase lists had overflowed.
.erase_init
    STZ erase_stop : STZ erase_stop+1
    RTS

\ draw_phase: the draw list's objects into the screen draw_buffer names
\ (draw_bank set to match), each line onto its erase list (memory.6502):
\ line_plot's stores moved to that screen's pages.
.draw_phase
    LDA draw_buffer : CLC : ADC #HI(ERASE_LIST)
    ASSERT EF_LO = 0 AND EF_HI = 1 AND EF_ROW = 2 AND EF_DX = 3 AND EF_DY = 4 AND EF_CODE = 5
    STA line_plot.f_lo+2 : ADC #2
    STA line_plot.f_hi+2 : ADC #2
    STA line_plot.f_row+2 : ADC #2
    STA line_plot.f_dx+2 : ADC #2
    STA line_plot.f_dy+2 : ADC #2
    STA line_plot.f_code+2
    LDA #ERASE_LINES : STA erase_i
    JSR draw_objects
    LDX draw_buffer
    LDA erase_i : STA erase_stop,X
    RTS

\ build_matrix (&04114): mat from ang_p, ang_h, ang_r (pitch, heading,
\ roll), as rows x', y', z' of coefficients on x, y, z. The ST keeps the
\ last object's matrix when the angles haven't changed, and so does this.
.build_matrix
{
    ZA_AUTO2 m_s1, m_c1, m_s2, m_c2, m_s3, m_c3, m_d6, m_d7, m_t
    LDA mat_valid : BEQ build
    LDX #5
.same
    LDA ang,X : ZA_INDEXEDBY 0..5
    CMP mat_angles,X : BNE build
    DEX : BPL same
    RTS
.build
    STZ ground_valid            ; mat isn't ground_matrix's now
    LDX #5
.keep
    LDA ang,X : ZA_INDEXEDBY 0..5
    STA mat_angles,X
    DEX : BPL keep
    LDA #&FF : STA mat_valid
    BANK BANK_WORLD
    LDA ang_p : STA m_idx : LDA ang_p+1 : AND #&0F : STA m_idx+1
    JSR sincos : MOVW m_s1, m_sin : MOVW m_c1, m_cos
    LDA ang_h : STA m_idx : LDA ang_h+1 : AND #&0F : STA m_idx+1
    JSR sincos : MOVW m_s2, m_sin : MOVW m_c2, m_cos
    \ the roll: 9 bits, times 8
    LDA ang_r : STA m_idx : LDA ang_r+1 : AND #1 : STA m_idx+1
    ASL m_idx : ROL m_idx+1 : ASL m_idx : ROL m_idx+1 : ASL m_idx : ROL m_idx+1
    JSR sincos : MOVW m_s3, m_sin : MOVW m_c3, m_cos
    \ The products, in the ST's order (&04190).
    FMUL m_s3, m_s1 : MOVW m_d6, mul_r
    FMUL m_c2, m_c3 : MOVW m_d7, mul_r
    FMUL m_s2, m_d6 : MOVW mat+0, m_d7 : ADDW mat+0, mul_r          ; x' on x
    FMUL m_s1, m_s2 : MOVW m_t, mul_r
    FMUL m_t, m_c3 : MOVW mat+6, mul_r
    FMUL m_s3, m_c2 : SUBW mat+6, mul_r                             ; y' on x
    FMUL m_s2, m_c1 : MOVW mat+12, mul_r                            ; z' on x
    FMUL m_c1, m_s3 : MOVW mat+2, mul_r                             ; x' on y
    FMUL m_c1, m_c3 : MOVW mat+8, mul_r                             ; y' on y
    LDA #0 : SEC : SBC m_s1 : STA mat+14
    LDA #0 : SBC m_s1+1 : STA mat+15                                ; z' on y
    FMUL m_d6, m_c2 : MOVW mat+4, mul_r
    FMUL m_s2, m_c3 : SUBW mat+4, mul_r                             ; x' on z
    FMUL m_s3, m_s2 : MOVW mat+10, mul_r
    FMUL m_d7, m_s1 : ADDW mat+10, mul_r                            ; y' on z
    FMUL m_c1, m_c2 : MOVW mat+16, mul_r                            ; z' on z
    RTS
}

\ ground_matrix: mat for an object with no pitch of its own, at heading
\ ang_h: with the camera's pitch and roll, each entry of the ST's matrix
\ (&04190) is a mix of sin and cos of the heading by five of the frame's
\ constants (kconst: s3 s1, s1 c3, c1, c3, s3), so ten products make it.
\ The ST nests its products differently; this is for drawing only.
ZA_AUTO 10, kconst          ; the constants, words ...
ZA_AUTO 10, kmag            ; ... as magnitudes ...
ZA_AUTO 5, ksign            ; ... and signs
.ground_matrix
{
    ZA_AUTO 10, ps              ; sin h by each constant
    \ the last ground object's heading, while mat is still its
    LDA ground_valid : BEQ build
    LDA ang_h : CMP ground_h : BNE build
    LDA ang_h+1 : CMP ground_h+1 : BNE build
    RTS
.build
    MOVW ground_h, ang_h
    LDA #&FF : STA ground_valid
    STZ mat_valid               ; mat isn't build_matrix's now
    BANK BANK_WORLD
    LDA ang_h : STA m_idx : LDA ang_h+1 : AND #&0F : STA m_idx+1
    JSR sincos
    MOVW kv, m_sin : JSR kmul
    LDX #9
.keep
    LDA kp,X : ZA_INDEXEDBY 0..9
    STA ps,X : ZA_INDEXEDBY 0..9
    DEX : BPL keep
    MOVW kv, m_cos : JSR kmul           ; kp: cos h by each
    LDA kp+6 : CLC : ADC ps : STA mat : LDA kp+7 : ADC ps+1 : STA mat+1           ; c c3 + s s3s1
    LDA ps+2 : SEC : SBC kp+8 : STA mat+6 : LDA ps+3 : SBC kp+9 : STA mat+7       ; s s1c3 - c s3
    MOVW mat+12, ps+4                                                             ; s c1
    LDA kp : SEC : SBC ps+6 : STA mat+4 : LDA kp+1 : SBC ps+7 : STA mat+5         ; c s3s1 - s c3
    LDA ps+8 : CLC : ADC kp+2 : STA mat+10 : LDA ps+9 : ADC kp+3 : STA mat+11     ; s s3 + c s1c3
    MOVW mat+16, kp+4                                                             ; c c1
    MOVW mat+2, cam+2                   ; c1 s3, c1 c3, -s1: the camera's own
    MOVW mat+8, cam+8
    MOVW mat+14, cam+14
    RTS
}

\ kmul: kp = kv (a signed word) by each of the five constants, each
\ (kv K) >> 14 in magnitude, signed.
ZA_AUTO2 kv
ZA_AUTO 10, kp
.kmul
{
    ZA_AUTO 20, ka              ; each product, 32 bits
    ZA_AUTO1 kneg, tlo
    LDA kv+1 : STA kneg : BPL positive
    LDA #0 : SEC : SBC kv : STA kv : LDA #0 : SBC kv+1 : STA kv+1
.positive
    LDA kv : MUL_SET
FOR k = 0..4
    LDY kmag + 2 * k : MUL8 ka + 4 * k : STA ka + 4 * k + 1
    LDY kmag + 2 * k + 1 : MUL8 tlo : STA ka + 4 * k + 2
    LDA ka + 4 * k + 1 : CLC : ADC tlo : STA ka + 4 * k + 1
    LDA ka + 4 * k + 2 : ADC #0 : STA ka + 4 * k + 2
    STZ ka + 4 * k + 3
NEXT
    LDA kv+1 : MUL_SET
FOR k = 0..4
    LDY kmag + 2 * k : MUL8 tlo
    CLC : ADC ka + 4 * k + 2 : STA ka + 4 * k + 2
    LDA ka + 4 * k + 3 : ADC #0 : STA ka + 4 * k + 3
    LDA ka + 4 * k + 1 : CLC : ADC tlo : STA ka + 4 * k + 1
    LDA ka + 4 * k + 2 : ADC #0 : STA ka + 4 * k + 2
    LDA ka + 4 * k + 3 : ADC #0 : STA ka + 4 * k + 3
    LDY kmag + 2 * k + 1 : MUL8 tlo
    CLC : ADC ka + 4 * k + 3 : STA ka + 4 * k + 3
    LDA ka + 4 * k + 2 : CLC : ADC tlo : STA ka + 4 * k + 2
    LDA ka + 4 * k + 3 : ADC #0 : STA ka + 4 * k + 3
NEXT
FOR k = 0..4
    \ >> 14: bytes 1-3 shifted left 2, the top two
    ASL ka + 4 * k + 1 : ROL ka + 4 * k + 2 : ROL ka + 4 * k + 3
    ASL ka + 4 * k + 1 : ROL ka + 4 * k + 2 : ROL ka + 4 * k + 3
    LDA kneg : EOR ksign + k : BMI negative
    LDA ka + 4 * k + 2 : STA kp + 2 * k : LDA ka + 4 * k + 3 : STA kp + 2 * k + 1
    BRA done
.negative
    LDA #0 : SEC : SBC ka + 4 * k + 2 : STA kp + 2 * k
    LDA #0 : SBC ka + 4 * k + 3 : STA kp + 2 * k + 1
.done
NEXT
    RTS
}

\ ---------------------------------------------------------------------------
\ draw_objects (&05108): the draw list read from its top. Each object's
\ matrix takes the player's pitch and heading added to its own, and the
\ player's roll negated (the ST's sum of angles, not a product of
\ matrices).
.draw_objects
{
    ZA_AUTO1 list_i
    LDX draw_n : BNE each
    RTS
.each
    DEX : STX list_i
    LDA draw_slots,X : STA slot : TAX
    LDA ob_type,X : STA otype : BEQ next
    LDA ob_exploding,X : BNE next           ; draw_shape_exploding: later
    LDA ob_cx_lo,X : STA tx : LDA ob_cx_hi,X : STA tx+1
    LDA ob_cy_lo,X : STA ty : LDA ob_cy_hi,X : STA ty+1
    LDA ob_cz_lo,X : STA tz : LDA ob_cz_hi,X : STA tz+1
    LDA ob_pitch_lo,X : CLC : ADC pl_pitch : STA ang_p
    LDA ob_pitch_hi,X : ADC pl_pitch+1 : STA ang_p+1
    LDA ob_heading_lo,X : CLC : ADC pl_heading : STA ang_h
    LDA ob_heading_hi,X : ADC pl_heading+1 : STA ang_h+1
    LDA #0 : SEC : SBC pl_roll : STA ang_r
    LDA #0 : SBC pl_roll+1 : STA ang_r+1
    JSR draw_shape
.next
    LDX list_i : BEQ done
    JMP each
.done
    RTS
}

\ ---------------------------------------------------------------------------
\ draw_shape (&04B1C): the object in `slot`, at (tx, ty, tz) in camera
\ space, its angles in ang_p, ang_h, ang_r.
.draw_shape
{
    ZA_AUTO1 shape, nmove, nturn, row_i, sc0, sc1, sc2, sc3
    ZA_AUTO2 hdr, fr, fr_k, t16
    LDX otype
    LDA type_shape,X : CMP #SHAPES : BCC known
    RTS
.known
    STA shape
    \ An object with no pitch of its own has the camera's pitch and roll.
    LDA ang_p : CMP pl_pitch : BNE pitched
    LDA ang_p+1 : CMP pl_pitch+1 : BNE pitched
    JSR ground_matrix
    BRA got_matrix
.pitched
    JSR build_matrix
.got_matrix
    BANK BANK_SHAPES
    LDX shape
    LDA shape_lo,X : STA hdr : LDA shape_hi,X : STA hdr+1
    LDY #HDR_BYTES + HDR_WORDS * 2 - 1
    ZA_DISCARD sh
.header
    LDA (hdr),Y : STA sh,Y : ZA_INDEXEDBY 0..HDR_BYTES + HDR_WORDS * 2 - 1
    DEY : BPL header
    \ The frame: the animation's, by shape.
    LDX shape : LDA anim_frame,X : ASL A : TAY
    LDA (sh_frames),Y : STA fr : INY : LDA (sh_frames),Y : STA fr+1
    \ Its arrays follow each other: the moving vertices' x, y, z, the
    \ changing faces' normals, then every face's K. Each pointer is set
    \ back by the count of still vertices or rigid faces, so it's indexed
    \ by vertex or face number.
    LDA sh_nverts : SEC : SBC sh_nstill : STA nmove
    LDA sh_nfaces : SEC : SBC sh_nrigid : STA nturn
    LDA fr : SEC : SBC sh_nstill : STA fr_vx : LDA fr+1 : SBC #0 : STA fr_vx+1
    LDA fr_vx : CLC : ADC nmove : STA fr_vy : LDA fr_vx+1 : ADC #0 : STA fr_vy+1
    LDA fr_vy : CLC : ADC nmove : STA fr_vz : LDA fr_vy+1 : ADC #0 : STA fr_vz+1
    \ fr_nx = fr + 3 nmove - nrigid
    LDA nmove : ASL A : ADC nmove : STA t16 : LDA #0 : ROL A : STA t16+1   ; 3 nmove (C = 0 after ASL of < 128)
    LDA fr : CLC : ADC t16 : STA fr_k : LDA fr+1 : ADC t16+1 : STA fr_k+1  ; past the vertices
    LDA fr_k : SEC : SBC sh_nrigid : STA fr_nx : LDA fr_k+1 : SBC #0 : STA fr_nx+1
    LDA fr_nx : CLC : ADC nturn : STA fr_ny : LDA fr_nx+1 : ADC #0 : STA fr_ny+1
    LDA fr_ny : CLC : ADC nturn : STA fr_nz : LDA fr_ny+1 : ADC #0 : STA fr_nz+1
    LDA nturn : ASL A : ADC nturn : STA t16 : LDA #0 : ROL A : STA t16+1
    LDA fr_k : CLC : ADC t16 : STA fr_klo : LDA fr_k+1 : ADC t16+1 : STA fr_klo+1
    LDA fr_klo : CLC : ADC sh_nfaces : STA fr_khi : LDA fr_klo+1 : ADC #0 : STA fr_khi+1
    \ The colour: the shape's, or the beam's, which animate_shapes cycles.
    LDA sh_colour : CMP #&FF : BNE colour_ok
    LDA beam_colour
.colour_ok
    AND #15 : STA ocolour : TAX
    LDA colour_map,X : JSR set_colour
    \ The matrix scaled to the shape, for the vertices: A = m g / 256, so
    \ A k / 1024 is in world units (g = 32 x scale): (|m| scale + 4) / 8.
    LDA sh_scale : MUL_SET
    LDX #0
    ZA_DISCARD xf_amag, xf_asign
.scale_term
    STX row_i
    LDA mat+1,X : ZA_INDEXEDBY 0..16
    STA t16+1 : LDA mat,X : ZA_INDEXEDBY 0..16
    STA t16
    LDA t16+1 : BPL scale_pos
    LDA #0 : SEC : SBC t16 : STA t16 : LDA #0 : SBC t16+1 : STA t16+1
.scale_pos
    LDY t16 : MUL8 sc0 : STA sc1                ; low byte by scale
    LDY t16+1 : MUL8 sc3 : STA sc2              ; high byte by scale
    LDA sc1 : CLC : ADC sc3 : STA sc1
    LDA sc2 : ADC #0 : STA sc2
    LDA sc0 : CLC : ADC #4 : STA sc0
    BCC rounded
    INC sc1 : BNE rounded
    INC sc2
.rounded
    LSR sc2 : ROR sc1 : ROR sc0
    LSR sc2 : ROR sc1 : ROR sc0
    LSR sc2 : ROR sc1 : ROR sc0
    LDX row_i
    LDA sc0 : STA xf_amag,X : ZA_INDEXEDBY 0..16
    LDA sc1 : STA xf_amag+1,X : ZA_INDEXEDBY 0..16
    TXA : LSR A : TAY
    LDA mat+1,X : ZA_INDEXEDBY 0..16
    AND #&80 : STA xf_asign,Y : ZA_INDEXEDBY 0..8
    INX : INX : CPX #18 : BEQ scaled
    JMP scale_term
.scaled
    \ The camera in object space, in world units: c = -(mat transposed) t.
    ZA_DISCARD objc
    LDX #0
.cam_axis
    STX row_i
    LDA mat,X : ZA_INDEXEDBY {0, 2, 4}
    STA mul_x : LDA mat+1,X : ZA_INDEXEDBY {0, 2, 4}
    STA mul_x+1
    MOVW mul_y, tx : JSR fmul16 : MOVW acc, mul_r
    LDX row_i
    LDA mat+6,X : ZA_INDEXEDBY {0, 2, 4}
    STA mul_x : LDA mat+7,X : ZA_INDEXEDBY {0, 2, 4}
    STA mul_x+1
    MOVW mul_y, ty : JSR fmul16 : ADDW acc, mul_r
    LDX row_i
    LDA mat+12,X : ZA_INDEXEDBY {0, 2, 4}
    STA mul_x : LDA mat+13,X : ZA_INDEXEDBY {0, 2, 4}
    STA mul_x+1
    MOVW mul_y, tz : JSR fmul16 : ADDW acc, mul_r
    LDX row_i
    LDA #0 : SEC : SBC acc : STA objc,X : ZA_INDEXEDBY {0, 2, 4}
    LDA #0 : SBC acc+1 : STA objc+1,X : ZA_INDEXEDBY {0, 2, 4}
    INX : INX : CPX #6 : BEQ axes_done
    JMP cam_axis
.axes_done
    \ as magnitudes and signs, for the faces' products
    ZA_DISCARD objc_mag, objc_sign
    LDX #0
.c_mag
    TXA : LSR A : TAY
    LDA objc+1,X : ZA_INDEXEDBY {0, 2, 4}
    AND #&80 : STA objc_sign,Y : ZA_INDEXEDBY 0..2
    BMI c_neg
    LDA objc,X : ZA_INDEXEDBY {0, 2, 4}
    STA objc_mag,X : ZA_INDEXEDBY {0, 2, 4}
    LDA objc+1,X : ZA_INDEXEDBY {0, 2, 4}
    STA objc_mag+1,X : ZA_INDEXEDBY {0, 2, 4}
    BRA c_next
.c_neg
    LDA #0 : SEC : SBC objc,X : ZA_INDEXEDBY {0, 2, 4}
    STA objc_mag,X : ZA_INDEXEDBY {0, 2, 4}
    LDA #0 : SBC objc+1,X : ZA_INDEXEDBY {0, 2, 4}
    STA objc_mag+1,X : ZA_INDEXEDBY {0, 2, 4}
.c_next
    INX : INX : CPX #6 : BNE c_mag
    \ A new stamp marks this object's edges and vertices.
    INC stamp : BNE stamped
    LDX #0
.wipe
    STZ edge_mark,X : STZ vert_mark,X
    INX : BNE wipe
    INC stamp
.stamped
    JSR faces
    \ Far enough away (16 radii or more), the perspective is linear across
    \ the object, to within half a pixel: its vertices go straight onto
    \ the screen (decision 10).
    LDA sh_radius : STA t16 : LDA sh_radius+1
    ASL t16 : ROL A : ASL t16 : ROL A : ASL t16 : ROL A : ASL t16 : ROL A
    STA t16+1
    CMPS16 tz, t16 : BMI near
    JSR far_setup
    JMP edges_far
.near
    JSR xform_setup
    JMP edges
}

\ far_setup: the object's centre on the screen (sc_x0, sc_y0, from the
\ view's centre), the first-order matrix B onto the screen, and whether
\ the object lies wholly inside the window. To first order in the
\ object's offsets, its x on the screen is X0 + (128 / tz)(A_x - (tx /
\ tz) A_z) k / 1024, and tx / tz is X0 / 128: so B_x = 128 (A_x - X0 A_z
\ / 128) / tz, which is proj_x's, and the same for y.
ZA_AUTO2 sc_x0, sc_y0
ZA_AUTO2 sc_x0q, sc_y0q         ; ... and in quarters of a pixel
ZA_AUTO1 far_inside             ; bit 7: no edge needs the window clip
ZA_AUTO 12, sc_bmag             ; B: |B| words, two rows of x, y, z ...
ZA_AUTO 6, sc_bsign             ; ... and signs
\ quarters: pq = 512 px / pz, in quarters of a pixel, as precisely as
\ px allows (proj_z's depth).
.quarters
{
    ZA_AUTO1 shifts
    LDA #2 : STA shifts
.try
    \ px << shifts fits a word if its top shifts + 1 bits agree
    LDA px : STA pq : LDA px+1 : STA pq+1
    LDX shifts : BEQ fits
.up
    ASL pq : ROL pq+1                       ; it fits while the bit out is the sign
    BCS was_neg
    BMI too_big
    BRA shifted
.was_neg
    BPL too_big
.shifted
    DEX : BNE up
.fits
    MOVW px, pq
    JSR proj_x
    LDA #2 : SEC : SBC shifts : TAX : BEQ done
.back
    ASL pq : ROL pq+1
    DEX : BNE back
.done
    RTS
.too_big
    DEC shifts
    BRA try
}

.far_setup
{
    ZA_AUTO1 j, row, term, halved
    ZA_AUTO2 az, d
    ZA_AUTO 3, d24
    MOVW pz, tz : JSR proj_z
    MOVW px, tx : JSR proj_x : MOVW sc_x0, pq
    MOVW px, ty : JSR proj_x : MOVW sc_y0, pq
    \ and in quarters of a pixel, for the vertices: 128 (4 t) / tz, or 2 t
    \ when 4 t won't fit a word, or t
    MOVW px, tx : JSR quarters : MOVW sc_x0q, pq
    MOVW px, ty : JSR quarters : MOVW sc_y0q, pq
    ZA_DISCARD sc_bmag, sc_bsign
    LDX #0
.column
    STX j
    \ A_z, signed
    TXA : CLC : ADC #6 : TAY
    LDA xf_asign,Y : ZA_INDEXEDBY 6..8
    STA mul_sign
    TYA : ASL A : TAY
    LDA xf_amag,Y : ZA_INDEXEDBY {12, 14, 16}
    STA az : LDA xf_amag+1,Y : ZA_INDEXEDBY {12, 14, 16}
    STA az+1
    BIT mul_sign : BPL az_pos
    LDA #0 : SEC : SBC az : STA az : LDA #0 : SBC az+1 : STA az+1
.az_pos
    STZ row
.each_row
    \ d = A_row - X0 A_z / 128 (X0 or Y0)
    LDA row : BNE use_y
    MOVW mul_x, sc_x0
    BRA got_centre
.use_y
    MOVW mul_x, sc_y0
.got_centre
    MOVW mul_y, az
    JSR smul16
    ASL mul_p : ROL mul_p+1 : ROL mul_p+2 : ROL mul_p+3     ; / 128: bytes 1-3 of the product << 1
    LDA row : ASL A : ADC row : ADC j : STA term   ; 3 row + j
    TAX
    LDA xf_asign,X : ZA_INDEXEDBY 0..5
    STA mul_sign
    TXA : ASL A : TAX
    LDA xf_amag,X : ZA_INDEXEDBY 0..10
    STA d24 : LDA xf_amag+1,X : ZA_INDEXEDBY 0..10
    STA d24+1 : STZ d24+2
    BIT mul_sign : BPL a_pos
    LDA #0 : SEC : SBC d24 : STA d24 : LDA #0 : SBC d24+1 : STA d24+1 : LDA #0 : SBC #0 : STA d24+2
.a_pos
    LDA d24 : SEC : SBC mul_p+1 : STA d24
    LDA d24+1 : SBC mul_p+2 : STA d24+1
    LDA d24+2 : SBC mul_p+3 : STA d24+2
    \ B = 128 d / tz, d halved (and B doubled) until it fits proj_x's word
    STZ halved
.fit
    LDA d24+1 : ASL A : LDA d24+2 : ADC #0 : BEQ fits   ; bits 15-23 all one or all zero
    LDA d24+2 : CMP #&80 : ROR d24+2 : ROR d24+1 : ROR d24
    INC halved
    BRA fit
.fits
    MOVW px, d24
    JSR proj_x
    LDX halved : BEQ unhalved
.double
    ASL pq : ROL pq+1
    DEX : BNE double
.unhalved
    LDX term
    LDA pq+1 : AND #&80 : STA sc_bsign,X : ZA_INDEXEDBY 0..5
    TXA : ASL A : TAX
    BIT pq+1 : BPL b_pos
    LDA #0 : SEC : SBC pq : STA pq : LDA #0 : SBC pq+1 : STA pq+1
.b_pos
    LDA pq : STA sc_bmag,X : ZA_INDEXEDBY 0..10
    LDA pq+1 : STA sc_bmag+1,X : ZA_INDEXEDBY 0..10
    INC row : LDA row : CMP #2 : BEQ rows_done
    JMP each_row
.rows_done
    LDX j : INX : CPX #3 : BEQ columns_done
    JMP column
.columns_done
    JSR screen_setup
    \ Inside the window? The centre, a radius (on the screen, plus one)
    \ from each edge.
    STZ far_inside
    MOVW px, sh_radius : JSR proj_x
    INC pq : BNE r_ok
    INC pq+1
.r_ok
    LDA sc_x0 : SEC : SBC pq : STA d : LDA sc_x0+1 : SBC pq+1 : STA d+1
    CMPS16 d, #VIEW_XMIN - VIEW_CX : BMI outside
    LDA sc_x0 : CLC : ADC pq : STA d : LDA sc_x0+1 : ADC pq+1 : STA d+1
    CMPS16 d, #VIEW_XMAX - VIEW_CX + 1 : BPL outside
    LDA sc_y0 : SEC : SBC pq : STA d : LDA sc_y0+1 : SBC pq+1 : STA d+1
    CMPS16 d, #VIEW_YMIN - VIEW_CY : BMI outside
    LDA sc_y0 : CLC : ADC pq : STA d : LDA sc_y0+1 : ADC pq+1 : STA d+1
    CMPS16 d, #VIEW_YMAX - VIEW_CY + 1 : BPL outside
    LDA #&80 : STA far_inside
.outside
    RTS
}

\ edges_far: each marked edge of a far object, its vertices straight onto
\ the screen; clipped to the window only if the object reaches past it.
.edges_far
{
    STZ edge_i
.each
    LDY edge_i : CPY sh_nedges : BCC test
    RTS
.test
    LDA edge_mark,Y : CMP stamp : BNE next
    LDA (sh_ev0),Y : STA va
    LDA (sh_ev1),Y : STA vb
    LDA va : JSR vertex_far
    LDA vb : JSR vertex_far
    LDX va : LDY vb
    LDA v_sxlo,X : STA cx0 : LDA v_sxhi,X : STA cx0+1
    LDA v_sylo,X : STA cy0 : LDA v_syhi,X : STA cy0+1
    LDA v_sxlo,Y : STA cx1 : LDA v_sxhi,Y : STA cx1+1
    LDA v_sylo,Y : STA cy1 : LDA v_syhi,Y : STA cy1+1
    BIT far_inside : BPL clip
    JSR clip_line.accept
    BRA next
.clip
    JSR clip_line
.next
    INC edge_i
    BRA each
}

\ vertex_far: vertex A of a far object onto the screen; once an object.
.vertex_far
{
    ZA_AUTO1 vtx
    TAX
    LDA vert_mark,X : CMP stamp : BNE new
    RTS
.new
    LDA stamp : STA vert_mark,X
    STX vtx
    TXA : TAY
    CPY sh_nstill : BCS moving
    LDA (sh_vx),Y : EOR #&80 : STA xf_u
    LDA (sh_vy),Y : EOR #&80 : STA xf_u+1
    LDA (sh_vz),Y : EOR #&80 : STA xf_u+2
    BRA got
.moving
    LDA (fr_vx),Y : EOR #&80 : STA xf_u
    LDA (fr_vy),Y : EOR #&80 : STA xf_u+1
    LDA (fr_vz),Y : EOR #&80 : STA xf_u+2
.got
    JSR screen_vertex
    \ the centre's quarters added, then truncated towards zero to pixels,
    \ as the ST's divs truncates
    LDY vtx
    LDA sc_acc : CLC : ADC sc_x0q : STA sc_acc : LDA sc_acc+1 : ADC sc_x0q+1
    JSR to_pixels
    LDA sc_acc : CLC : ADC #LO(VIEW_CX) : STA v_sxlo,Y
    LDA sc_acc+1 : ADC #HI(VIEW_CX) : STA v_sxhi,Y
    LDA sc_acc+2 : CLC : ADC sc_y0q : STA sc_acc : LDA sc_acc+3 : ADC sc_y0q+1
    JSR to_pixels
    LDA sc_acc : CLC : ADC #LO(VIEW_CY) : STA v_sylo,Y
    LDA sc_acc+1 : ADC #HI(VIEW_CY) : STA v_syhi,Y
    RTS
\ to_pixels: sc_acc (its low byte; the high byte in A) / 4, truncated
\ towards zero, into sc_acc.
.to_pixels
    BPL quarter
    EOR #&FF : STA sc_acc+1 : LDA sc_acc : EOR #&FF : CLC : ADC #1 : STA sc_acc
    LDA sc_acc+1 : ADC #0
    LSR A : ROR sc_acc : LSR A : ROR sc_acc
    EOR #&FF : STA sc_acc+1 : LDA sc_acc : EOR #&FF : CLC : ADC #1 : STA sc_acc
    LDA sc_acc+1 : ADC #0 : STA sc_acc+1
    RTS
.quarter
    LSR A : ROR sc_acc : LSR A : ROR sc_acc : STA sc_acc+1
    RTS
}

\ faces: each face's edges marked if it's visible: always-visible, or the
\ camera on its outer side, n.c > 4K.
.faces
{
    ZA_AUTO1 face_i, row_i, count, psign, ph
    ZA_AUTO 3, nrm              ; the face's normal, x y z
    ZA_AUTO 3, dot, kk, pp
    STZ face_i
.each
    LDY face_i : CPY sh_nfaces : BCC test
    RTS
.test
    LDA (sh_fflags),Y : ORA all_faces : BPL tested
    JMP visible
.tested
    CPY sh_nrigid : BCS turning
    LDA (sh_nx),Y : STA nrm : LDA (sh_ny),Y : STA nrm+1 : LDA (sh_nz),Y : STA nrm+2
    BRA normal
.turning
    LDA (fr_nx),Y : STA nrm : LDA (fr_ny),Y : STA nrm+1 : LDA (fr_nz),Y : STA nrm+2
.normal
    \ dot = n.c, 24 bits: each component's |n| |c| added or taken away
    STZ dot : STZ dot+1 : STZ dot+2
    LDX #0
.axis
    LDA nrm,X : ZA_INDEXEDBY 0..2
    BEQ axis_next                       ; nothing on this axis
    STX row_i
    EOR objc_sign,X : ZA_INDEXEDBY 0..2
    STA psign
    LDA nrm,X : ZA_INDEXEDBY 0..2
    BPL n_pos
    EOR #&FF : CLC : ADC #1
.n_pos
    MUL_SET
    TXA : ASL A : TAX
    LDY objc_mag,X : ZA_INDEXEDBY {0, 2, 4}
    MUL8 pp : STA pp+1
    LDY objc_mag+1,X : ZA_INDEXEDBY {0, 2, 4}
    MUL8 ph : CLC : ADC #0 : STA pp+2           ; ph: its low byte
    LDA pp+1 : CLC : ADC ph : STA pp+1
    BCC carried
    INC pp+2
.carried
    BIT psign : BMI subtract
    CLC
    LDA dot : ADC pp : STA dot
    LDA dot+1 : ADC pp+1 : STA dot+1
    LDA dot+2 : ADC pp+2 : STA dot+2
    BRA added
.subtract
    SEC
    LDA dot : SBC pp : STA dot
    LDA dot+1 : SBC pp+1 : STA dot+1
    LDA dot+2 : SBC pp+2 : STA dot+2
.added
    LDX row_i
.axis_next
    INX : CPX #3 : BNE axis
    \ visible if dot - 4K > 0
    LDY face_i
    LDA (fr_klo),Y : STA kk : LDA (fr_khi),Y : STA kk+1
    LDA #0 : BIT kk+1 : BPL kpos
    LDA #&FF
.kpos
    STA kk+2
    ASL kk : ROL kk+1 : ROL kk+2
    ASL kk : ROL kk+1 : ROL kk+2
    SEC
    LDA dot : SBC kk : STA dot
    LDA dot+1 : SBC kk+1 : STA dot+1
    LDA dot+2 : SBC kk+2 : STA dot+2
    BMI next
    ORA dot : ORA dot+1 : BEQ next              ; zero: on the plane
.visible
    LDY face_i
    LDA (sh_fedges),Y : TAY
    LDA (sh_elists),Y : STA count
.mark
    INY : LDA (sh_elists),Y : TAX
    LDA stamp : STA edge_mark,X
    DEC count : BNE mark
.next
    INC face_i
    JMP each
}

\ edges (&04D16): each marked edge, its vertices transformed as needed.
.edges
{
    STZ edge_i
.each
    LDY edge_i : CPY sh_nedges : BCC test
    RTS
.test
    LDA edge_mark,Y : CMP stamp : BNE next
    LDA (sh_ev0),Y : STA va
    LDA (sh_ev1),Y : STA vb
    LDA va : JSR vertex
    LDA vb : JSR vertex
    JSR edge
.next
    INC edge_i
    BRA each
}

\ vertex: vertex A of the shape into camera space (&03FFE) and, in front
\ of the near plane, projected; once an object.
.vertex
{
    ZA_AUTO1 vtx
    ZA_AUTO2 cvx, cvy, cvz
    TAX
    LDA vert_mark,X : CMP stamp : BNE new
    RTS
.new
    LDA stamp : STA vert_mark,X
    STX vtx
    TXA : TAY
    CPY sh_nstill : BCS moving
    LDA (sh_vx),Y : EOR #&80 : STA xf_u
    LDA (sh_vy),Y : EOR #&80 : STA xf_u+1
    LDA (sh_vz),Y : EOR #&80 : STA xf_u+2
    BRA got
.moving
    LDA (fr_vx),Y : EOR #&80 : STA xf_u
    LDA (fr_vy),Y : EOR #&80 : STA xf_u+1
    LDA (fr_vz),Y : EOR #&80 : STA xf_u+2
.got
    JSR xform_vertex
    WORLD xf_acc, tx, cvx
    WORLD xf_acc+2, ty, cvy
    WORLD xf_acc+4, tz, cvz
    LDY vtx
    LDA cvx : STA v_xlo,Y : LDA cvx+1 : STA v_xhi,Y
    LDA cvy : STA v_ylo,Y : LDA cvy+1 : STA v_yhi,Y
    LDA cvz : STA v_zlo,Y : LDA cvz+1 : STA v_zhi,Y
    CMPS16 cvz, #NEAR_Z : BMI behind
    MOVW pz, cvz : JSR proj_z
    MOVW px, cvx : JSR proj_x
    LDY vtx
    LDA pq : CLC : ADC #LO(VIEW_CX) : STA v_sxlo,Y
    LDA pq+1 : ADC #HI(VIEW_CX) : STA v_sxhi,Y
    MOVW px, cvy : JSR proj_x
    LDY vtx
    LDA pq : CLC : ADC #LO(VIEW_CY) : STA v_sylo,Y
    LDA pq+1 : ADC #HI(VIEW_CY) : STA v_syhi,Y
.behind
    RTS
}

\ proj_z: ready proj_x for the depth pz (2 or more): the reciprocal's
\ bytes patched into proj_x's reads, and its shift (recip.6502).
ZA_AUTO1 proj_shift
.proj_z
{
    ZA_AUTO1 m
    LDA pz+1 : BNE big
    LDX pz
    LDY zsmall_idx,X
    LDA zsmall_sh,X : STA proj_shift
    BRA exact
.big
    TAX
    LDA zhigh_sh,X : TAX
    CLC : ADC #17 : STA proj_shift
    LDA pz : STA m
    LDA pz+1
    CPX #0 : BEQ shifted
.shift
    LSR A : ROR m
    DEX : BNE shift
    LDY m
    LDA rcp_lo,Y : PHA : LDA rcp_hi,Y : TAY : PLA
    BRA got
.shifted
    LDY m
.exact
    LDA rcpx_lo,Y : PHA : LDA rcpx_hi,Y : TAY : PLA
.got
    \ A, Y: R's low and high bytes
    STA proj_x.a+1 : STA proj_x.g+1 : STA proj_x.i+1
    EOR #&FF
    STA proj_x.b+1 : STA proj_x.h+1 : STA proj_x.j+1
    TYA
    STA proj_x.c+1 : STA proj_x.e+1 : STA proj_x.k+1 : STA proj_x.m+1
    EOR #&FF
    STA proj_x.d+1 : STA proj_x.f+1 : STA proj_x.l+1 : STA proj_x.n+1
    RTS
}

\ proj_x: pq = 128 px / pz, truncated towards zero, from proj_z's
\ reciprocal: |x| R >> S. Where the ST's divs overflows (z < 256 and
\ |x| >= 256 z) it's the ST's result instead, the low word of x << 7.
.proj_x
{
    ZA_AUTO1 xl, xh, t, u0, u1, w0, p1, p2, p3
    LDA px+1 : BPL pos
    LDA #0 : SEC : SBC px : STA xl
    LDA #0 : SBC px+1 : STA xh
    BRA magnitude
.pos
    STA xh : LDA px : STA xl
.magnitude
    LDA pz+1 : BNE fits
    LDA xh : CMP pz : BCC fits
    LDA px+1 : LSR A : LDA px : ROR A : STA pq+1
    LDA #0 : ROR A : STA pq
    RTS
.fits
    \ |x| R: R's low byte by x's low (its high byte), then the rest
    LDY xl
    SEC
.a  LDA sqr_hi,Y
.b  SBC neg_hi,Y
    STA t
    SEC
.c  LDA sqr_lo,Y
.d  SBC neg_lo,Y
    STA p1
.e  LDA sqr_hi,Y
.f  SBC neg_hi,Y
    STA p2
    LDY xh
    SEC
.g  LDA sqr_lo,Y
.h  SBC neg_lo,Y
    STA u0
.i  LDA sqr_hi,Y
.j  SBC neg_hi,Y
    STA u1
    SEC
.k  LDA sqr_lo,Y
.l  SBC neg_lo,Y
    STA w0
.m  LDA sqr_hi,Y
.n  SBC neg_hi,Y
    STA p3
    CLC
    LDA p1 : ADC t : STA p1
    LDA p2 : ADC u1 : STA p2
    BCC c1
    INC p3
.c1
    CLC
    LDA p1 : ADC u0 : STA p1
    LDA p2 : ADC w0 : STA p2
    BCC c2
    INC p3
.c2
    \ >> S: p3:p2:p1 is the product >> 8
    LDA proj_shift : SEC : SBC #16 : BCC under16
    TAX : BEQ word
.shift16
    LSR p3 : ROR p2
    DEX : BNE shift16
.word
    LDA p2 : STA pq : LDA p3 : STA pq+1
    BRA sign
.under16
    ADC #8 : TAX                    ; S - 8, 2 to 7 (C = 0)
.shift24
    LSR p3 : ROR p2 : ROR p1
    DEX : BNE shift24
    LDA p1 : STA pq : LDA p2 : STA pq+1
.sign
    BIT px+1 : BPL done
    LDA #0 : SEC : SBC pq : STA pq
    LDA #0 : SBC pq+1 : STA pq+1
.done
    RTS
}

\ edge (&04D66): the edge from vertex va to vb, clipped at z = 2 if it
\ crosses the plane, projected and clipped to the window.
.edge
{
    ZA_AUTO1 code
    LDX va : LDY vb
    LDA v_zlo,X : STA ep+4 : LDA v_zhi,X : STA ep+5
    LDA v_zlo,Y : STA eq+4 : LDA v_zhi,Y : STA eq+5
    STZ code                            ; bit 1: p in front, bit 0: q
    CMPS16 ep+4, #NEAR_Z : BMI p_behind
    LDA #2 : TSB code
.p_behind
    CMPS16 eq+4, #NEAR_Z : BMI q_behind
    LDA #1 : TSB code
.q_behind
    LDA code : CMP #3 : BEQ in_front
    CMP #0 : BNE crosses
    RTS                                 ; both behind
.in_front
    LDX va : LDY vb
    LDA v_sxlo,X : STA cx0 : LDA v_sxhi,X : STA cx0+1
    LDA v_sylo,X : STA cy0 : LDA v_syhi,X : STA cy0+1
    LDA v_sxlo,Y : STA cx1 : LDA v_sxhi,Y : STA cx1+1
    LDA v_sylo,Y : STA cy1 : LDA v_syhi,Y : STA cy1+1
    JMP clip_line
.crosses
    LDX va : LDY vb
    LDA v_xlo,X : STA ep : LDA v_xhi,X : STA ep+1
    LDA v_ylo,X : STA ep+2 : LDA v_yhi,X : STA ep+3
    LDA v_xlo,Y : STA eq : LDA v_xhi,Y : STA eq+1
    LDA v_ylo,Y : STA eq+2 : LDA v_yhi,Y : STA eq+3
    JSR clip_near
    MOVW pz, ep+4 : JSR proj_z
    MOVW px, ep : JSR proj_x
    LDA pq : CLC : ADC #LO(VIEW_CX) : STA cx0 : LDA pq+1 : ADC #HI(VIEW_CX) : STA cx0+1
    MOVW px, ep+2 : JSR proj_x
    LDA pq : CLC : ADC #LO(VIEW_CY) : STA cy0 : LDA pq+1 : ADC #HI(VIEW_CY) : STA cy0+1
    MOVW pz, eq+4 : JSR proj_z
    MOVW px, eq : JSR proj_x
    LDA pq : CLC : ADC #LO(VIEW_CX) : STA cx1 : LDA pq+1 : ADC #HI(VIEW_CX) : STA cx1+1
    MOVW px, eq+2 : JSR proj_x
    LDA pq : CLC : ADC #LO(VIEW_CY) : STA cy1 : LDA pq+1 : ADC #HI(VIEW_CY) : STA cy1+1
    JMP clip_line
}

\ clip_near (&0A374): ep and eq (x, y, z words), one behind z = 2. The
\ ST's arithmetic exactly: when eq is the one behind they're swapped, and
\ stay so; the fraction is (2 - z) << 16 over the edge's dz, a 16-bit
\ quotient used as if it had 15 bits, and 0 when divs overflows.
.clip_near
{
    ZA_AUTO1 row_i
.again
    CMPS16 ep+4, #NEAR_Z : BMI clip
    CMPS16 eq+4, #NEAR_Z : BMI swap
    RTS
.swap
    LDX #5
.swap1
    LDA ep,X : ZA_INDEXEDBY 0..5
    PHA
    LDA eq,X : ZA_INDEXEDBY 0..5
    STA ep,X : ZA_INDEXEDBY 0..5
    PLA : STA eq,X : ZA_INDEXEDBY 0..5
    DEX : BPL swap1
    BRA again
.clip
    STZ mul_p : STZ mul_p+1
    LDA #LO(NEAR_Z) : SEC : SBC ep+4 : STA mul_p+2
    LDA #HI(NEAR_Z) : SBC ep+5 : STA mul_p+3
    LDA eq+4 : SEC : SBC ep+4 : STA div_d
    LDA eq+5 : SBC ep+5 : STA div_d+1
    JSR sdiv32
    BCC fits
    STZ div_q : STZ div_q+1
.fits
    LDX #0
    JSR cut_axis
    LDX #2
    JSR cut_axis
    LDA #LO(NEAR_Z) : STA ep+4 : LDA #HI(NEAR_Z) : STA ep+5
    BRA again
.cut_axis
    STX row_i
    LDA eq,X : ZA_INDEXEDBY {0, 2}
    SEC : SBC ep,X : ZA_INDEXEDBY {0, 2}
    STA mul_x
    LDA eq+1,X : ZA_INDEXEDBY {0, 2}
    SBC ep+1,X : ZA_INDEXEDBY {0, 2}
    STA mul_x+1
    MOVW mul_y, div_q
    JSR smul16
    ASL mul_p+1 : ROL mul_p+2 : ROL mul_p+3
    LDX row_i
    LDA ep,X : ZA_INDEXEDBY {0, 2}
    CLC : ADC mul_p+2 : STA ep,X : ZA_INDEXEDBY {0, 2}
    LDA ep+1,X : ZA_INDEXEDBY {0, 2}
    ADC mul_p+3 : STA ep+1,X : ZA_INDEXEDBY {0, 2}
    RTS
}

\ clip_line (&0A170): Cohen-Sutherland to the window, as the ST clips: a
\ vertical or horizontal line is clamped; otherwise point 0 is cut, the
\ points swapped first (and left so) when point 0 is inside. Then the line
\ is logged and drawn. cx0, cy0, cx1, cy1 are consecutive words.
.clip_line
{
    ZA_AUTO1 code0, code1
.again
    MOVW px, cx0 : MOVW pz, cy0 : JSR outcode : STA code0
    MOVW px, cx1 : MOVW pz, cy1 : JSR outcode : STA code1
    ORA code0 : BNE outside
    JMP accept
.outside
    LDA code0 : AND code1 : BEQ crossing
    RTS
.crossing
    LDA cx1 : CMP cx0 : BNE not_vertical
    LDA cx1+1 : CMP cx0+1 : BNE not_vertical
    CLAMP cy0, VIEW_YMIN, VIEW_YMAX
    CLAMP cy1, VIEW_YMIN, VIEW_YMAX
    JMP again
.not_vertical
    LDA cy1 : CMP cy0 : BNE slanted
    LDA cy1+1 : CMP cy0+1 : BNE slanted
    CLAMP cx0, VIEW_XMIN, VIEW_XMAX
    CLAMP cx1, VIEW_XMIN, VIEW_XMAX
    JMP again
.slanted
    LDA code0 : BNE cut
    LDX #3
.swap
    LDA clip_pts,X : ZA_INDEXEDBY 0..3
    LDY clip_pts+4,X : ZA_INDEXEDBY 0..3
    STA clip_pts+4,X : ZA_INDEXEDBY 0..3
    STY clip_pts,X : ZA_INDEXEDBY 0..3
    DEX : BPL swap
    LDA code1 : STA code0
.cut
    LSR code0 : BCC not_top
    \ above: x0 += (ymin - y0)(x1 - x0) / (y1 - y0), y0 = ymin
    LDA #LO(VIEW_YMIN) : SEC : SBC cy0 : STA mul_x : LDA #HI(VIEW_YMIN) : SBC cy0+1 : STA mul_x+1
    JSR dx_dy
    ADDW cx0, pq
    LDA #LO(VIEW_YMIN) : STA cy0 : LDA #HI(VIEW_YMIN) : STA cy0+1
    JMP again
.not_top
    LSR code0 : BCC not_left
    \ left: y0 += (xmin - x0)(y1 - y0) / (x1 - x0), x0 = xmin
    LDA #LO(VIEW_XMIN) : SEC : SBC cx0 : STA mul_x : LDA #HI(VIEW_XMIN) : SBC cx0+1 : STA mul_x+1
    JSR dy_dx
    ADDW cy0, pq
    LDA #LO(VIEW_XMIN) : STA cx0 : LDA #HI(VIEW_XMIN) : STA cx0+1
    JMP again
.not_left
    LSR code0 : BCC not_bottom
    LDA #LO(VIEW_YMAX) : SEC : SBC cy0 : STA mul_x : LDA #HI(VIEW_YMAX) : SBC cy0+1 : STA mul_x+1
    JSR dx_dy
    ADDW cx0, pq
    LDA #LO(VIEW_YMAX) : STA cy0 : LDA #HI(VIEW_YMAX) : STA cy0+1
    JMP again
.not_bottom
    LDA #LO(VIEW_XMAX) : SEC : SBC cx0 : STA mul_x : LDA #HI(VIEW_XMAX) : SBC cx0+1 : STA mul_x+1
    JSR dy_dx
    ADDW cy0, pq
    LDA #LO(VIEW_XMAX) : STA cx0 : LDA #HI(VIEW_XMAX) : STA cx0+1
    JMP again
\ dx_dy, dy_dx: pq = mul_x (x1 - x0) / (y1 - y0), or with x and y the
\ other way: muls then divs, and on overflow the product's low word.
.dx_dy
    LDA cx1 : SEC : SBC cx0 : STA mul_y : LDA cx1+1 : SBC cx0+1 : STA mul_y+1
    LDA cy1 : SEC : SBC cy0 : STA div_d : LDA cy1+1 : SBC cy0+1 : STA div_d+1
    BRA muldiv
.dy_dx
    LDA cy1 : SEC : SBC cy0 : STA mul_y : LDA cy1+1 : SBC cy0+1 : STA mul_y+1
    LDA cx1 : SEC : SBC cx0 : STA div_d : LDA cx1+1 : SBC cx0+1 : STA div_d+1
.muldiv
    JSR smul16
    JSR sdiv32
    BCS overflow
    MOVW pq, div_q
    RTS
.overflow
    MOVW pq, mul_p
    RTS
.accept
IF DEFINED(SPIKE)
    \ the spike's log, for tools/scenecheck.py: slot, edge, x0, y0, x1,
    \ y1, colour
    LDA log_n : CMP #LO(LOG_LINES) : LDA log_n+1 : SBC #HI(LOG_LINES) : BCC room
    JMP draw                            ; full
.room
    LDA #BANK_LOG : STA romsel
    LDY #0
    LDA slot : STA (log_ptr),Y : INY
    LDA edge_i : STA (log_ptr),Y : INY
    LDA cx0 : STA (log_ptr),Y : INY
    LDA cx0+1 : STA (log_ptr),Y : INY
    LDA cy0 : STA (log_ptr),Y : INY
    LDA cx1 : STA (log_ptr),Y : INY
    LDA cx1+1 : STA (log_ptr),Y : INY
    LDA cy1 : STA (log_ptr),Y : INY
    LDA ocolour : STA (log_ptr),Y : INY
    LDA bank_now : STA romsel
    TYA : CLC : ADC log_ptr : STA log_ptr
    BCC logged
    INC log_ptr+1
.logged
    INC log_n : BNE counted
    INC log_n+1
.counted
ENDIF
.draw
    MOVW line_x0, cx0 : LDA cy0 : STA line_y0
    MOVW line_x1, cx1 : LDA cy1 : STA line_y1
    JMP line_plot
}

\ outcode: A = the window's outcode of (px, pz): 8 right, 4 below, 2 left,
\ 1 above (&0A174).
.outcode
{
    ZA_AUTO1 code
    STZ code
    CMPS16 px, #VIEW_XMAX + 1 : BMI c1
    LDA #8 : TSB code
.c1
    CMPS16 pz, #VIEW_YMAX + 1 : BMI c2
    LDA #4 : TSB code
.c2
    CMPS16 px, #VIEW_XMIN : BPL c3
    LDA #2 : TSB code
.c3
    CMPS16 pz, #VIEW_YMIN : BPL c4
    LDA #1 : TSB code
.c4
    LDA code
    RTS
}
